@{
    ViewData["Title"] = T["keystore.title"].Value;
    Layout = "_AppShell";
    var isAdmin = User.IsInRole("Admin");
}
<div class="workspace-inner" style="max-width:1100px;margin:0 auto">
    <div class="page-head">
        <h1>🔑 @T["keystore.title"]</h1>
        <p class="muted">@T["keystore.lede"]</p>
    </div>

    <div class="row" style="gap:var(--sp-3);align-items:center;flex-wrap:wrap;margin:16px 0">
        <input type="search" id="ksSearch" placeholder="@T["keystore.search_placeholder"]"
               style="flex:1;min-width:220px;padding:10px 14px"/>
        <button class="btn btn-primary" onclick="ksOpenCreate()">+ @T["keystore.new"]</button>
    </div>

    <div id="ksBulkBar" class="card" style="display:none;margin-bottom:12px;background:var(--tw-gray-100);display:flex;align-items:center;justify-content:space-between;gap:12px">
        <span id="ksBulkCount"></span>
        <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" onclick="ksBulkDelete()">🗑 @T["keystore.delete_selected"]</button>
    </div>

    <div id="ksLoading" class="muted">@T["keystore.loading"]</div>
    <div id="ksEmpty" class="card" style="display:none"><p class="muted">@T["keystore.empty"]</p></div>

    <table class="table table-cards-mobile" id="ksTable" style="display:none">
        <thead>
            <tr>
                <th style="width:36px"><input type="checkbox" id="ksSelectAll" onchange="ksToggleAll(this.checked)"/></th>
                <th>@T["keystore.col.customer"]</th>
                <th>@T["keystore.col.contact"]</th>
                <th>@T["keystore.col.type"]</th>
                <th>@T["keystore.col.valid_until"]</th>
                <th>@T["keystore.col.status"]</th>
                @if (isAdmin)
                {
                    <th>@T["keystore.col.owner"]</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody id="ksBody"></tbody>
    </table>

    @* v1.11.37 — Marcus's Wunsch: pro Key-Typ hinterlegte Dokumentation
       (hochgeladene PDFs oder feste Links wie der Tenant-Login), die auf der
       Landing eines KeyStoreMode-Links erscheint — aber nur wenn dort die
       "Dokumentation"-Checkbox aktiviert wurde. So lassen sich Doku-Anhänge
       leicht austauschen/löschen ohne Code-Änderung. *@
    <div class="page-head" style="margin-top:40px">
        <h2>📄 @T["keystore.documents.section"]</h2>
        <p class="muted">@T["keystore.documents.lede"]</p>
    </div>
    <div class="row" style="margin:12px 0">
        <button class="btn btn-primary" onclick="kdOpenCreate()">+ @T["keystore.documents.new"]</button>
    </div>
    <div id="kdLoading" class="muted">@T["keystore.loading"]</div>
    <div id="kdEmpty" class="card" style="display:none"><p class="muted">@T["keystore.documents.empty"]</p></div>
    <table class="table table-cards-mobile" id="kdTable" style="display:none">
        <thead>
            <tr>
                <th>@T["keystore.documents.col.label"]</th>
                <th>@T["keystore.documents.col.type"]</th>
                <th>@T["keystore.documents.col.key_types"]</th>
                @if (isAdmin)
                {
                    <th>@T["keystore.col.owner"]</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody id="kdBody"></tbody>
    </table>

    @* v1.11.37 — Email-Vorlage für den "Key via Email zusenden"-Versand,
       inkl. KI-Vorschlag (gleiches Pattern wie /signatures/templates). Eigene
       Seite statt Inline-Editor, damit es hier nicht zu voll wird. *@
    <div class="page-head" style="margin-top:40px">
        <h2>✉️ @T["keystore.templates.title"]</h2>
        <p class="muted">@T["keystore.templates.lede"]</p>
    </div>
    <div class="row" style="margin:12px 0 32px">
        <a class="btn btn-secondary" href="/keystore/templates">✉️ @T["keystore.templates.link"]</a>
    </div>
</div>

<!-- Document create/edit modal -->
<div class="modal-backdrop" id="kdModal" onclick="if(event.target===this)kdCloseModal()">
    <div class="modal-panel" style="max-width:520px">
        <h2 id="kdModalTitle">@T["keystore.documents.new"]</h2>
        <input type="hidden" id="kdId"/>
        <div class="field">
            <label>@T["keystore.documents.field.label"]</label>
            <input type="text" id="kdLabel" required/>
        </div>
        <div class="field" id="kdKindWrap">
            <label>@T["keystore.documents.field.kind"]</label>
            <div class="row" style="gap:var(--sp-3)">
                <label class="row" style="gap:6px;align-items:center"><input type="radio" name="kdKind" value="file" id="kdKindFile" checked onchange="kdUpdateKindMode()"/> @T["keystore.documents.kind.file"]</label>
                <label class="row" style="gap:6px;align-items:center"><input type="radio" name="kdKind" value="link" id="kdKindLink" onchange="kdUpdateKindMode()"/> @T["keystore.documents.kind.link"]</label>
            </div>
        </div>
        <div class="field" id="kdFileWrap">
            <label>@T["keystore.documents.field.file"]</label>
            <input type="file" id="kdFile" accept="application/pdf"/>
            <div class="helper" id="kdCurrentFileHint" style="display:none"></div>
        </div>
        <div class="field" id="kdUrlWrap" style="display:none">
            <label>@T["keystore.documents.field.url"]</label>
            <input type="url" id="kdUrl" placeholder="https://admin.ppdf.kofaxcloud.com/"/>
        </div>
        <div class="field">
            <label>@T["keystore.documents.field.key_types"]</label>
            <div class="helper">@T["keystore.documents.field.key_types_hint"]</div>
            <div id="kdKeyTypesWrap" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:6px"></div>
        </div>
        <div id="kdModalError" class="helper" style="display:none;color:var(--status-critical);margin-top:8px"></div>
        <div class="actions" style="margin-top:16px">
            <button type="button" class="btn btn-ghost" onclick="kdCloseModal()">@T["modal.cancel"]</button>
            <button type="button" class="btn btn-primary" onclick="kdSave()" id="kdSaveBtn">@T["modal.save"]</button>
        </div>
    </div>
</div>

<!-- Create/Edit modal -->
<div class="modal-backdrop" id="ksModal" onclick="if(event.target===this)ksCloseModal()">
    <div class="modal-panel" style="max-width:520px">
        <h2 id="ksModalTitle">@T["keystore.new"]</h2>
        <input type="hidden" id="ksId"/>
        <div class="field">
            <label>@T["keystore.field.customer_name"]</label>
            <input type="text" id="ksCustomerName" required/>
        </div>
        <div class="row" style="gap:var(--sp-3)">
            <div class="field" style="flex:1">
                <label>@T["keystore.field.customer_email"]</label>
                <input type="email" id="ksCustomerEmail" placeholder="kunde@firma.com"/>
            </div>
            <div class="field" style="flex:1">
                <label>@T["keystore.field.customer_domain"]</label>
                <input type="text" id="ksCustomerDomain" placeholder="firma.com"/>
            </div>
        </div>
        <div class="helper">@T["keystore.field.contact_hint"]</div>

        <div class="field" style="margin-top:8px">
            <label>@T["keystore.field.key_type"]</label>
            <input type="text" id="ksKeyType" list="ksKeyTypeList" placeholder="@T["keystore.field.key_type_placeholder"]" required autocomplete="off"/>
            <datalist id="ksKeyTypeList"></datalist>
        </div>

        <div id="ksKeyValueSingleWrap" class="field" style="margin-top:8px">
            <label>@T["keystore.field.key_value"]</label>
            <input type="text" id="ksKeyValue" class="mono" placeholder="AV09Z-K13-8FXD-BAVZ-XT" autocomplete="off"/>
        </div>
        <div id="ksKeyValueClsWrap" class="row" style="gap:var(--sp-3);margin-top:8px;display:none">
            <div class="field" style="flex:1">
                <label>@T["keystore.field.key_value_serial"]</label>
                <input type="text" id="ksKeyValueSerial" class="mono" placeholder="LW13976" autocomplete="off"/>
            </div>
            <div class="field" style="flex:1">
                <label>@T["keystore.field.key_value_product"]</label>
                <input type="text" id="ksKeyValueProduct" class="mono" placeholder="729093F57" autocomplete="off"/>
            </div>
        </div>

        <div class="field" style="margin-top:8px;max-width:220px">
            <label>@T["keystore.field.valid_until"]</label>
            <input type="date" id="ksValidUntil"/>
        </div>
        <div class="field" style="margin-top:8px">
            <label>@T["keystore.field.notes"]</label>
            <textarea id="ksNotes" rows="2"></textarea>
        </div>
        <div id="ksModalError" class="helper" style="display:none;color:var(--status-critical);margin-top:8px"></div>
        <div class="actions" style="margin-top:16px">
            <button type="button" class="btn btn-ghost" onclick="ksCloseModal()">@T["modal.cancel"]</button>
            <button type="button" class="btn btn-primary" onclick="ksSave()" id="ksSaveBtn">@T["modal.save"]</button>
        </div>
    </div>
</div>

<script>
let ksRows = [];
let ksSelected = new Set();
const KS_IS_ADMIN = @Json.Serialize(isAdmin);

// v1.11.24: Key-Typ als "Combo" — 4 Standardtypen + vom Browser gemerkte
// eigene Typen (localStorage, pro Gerät/Browser — kein Server-Feld nötig).
const KS_DEFAULT_TYPES = ['Evaluation-CLS', 'Evaluation-OnPrem', 'NFR-OnPrem', 'NFR-CLS'];
const KS_CUSTOM_TYPES_KEY = 'nimshare.keystore.customTypes';

function ksCustomTypes() {
    try { return JSON.parse(localStorage.getItem(KS_CUSTOM_TYPES_KEY) || '[]'); } catch { return []; }
}
function ksRememberType(type) {
    if (!type) return;
    const all = KS_DEFAULT_TYPES.map(t => t.toLowerCase());
    const custom = ksCustomTypes();
    if (all.includes(type.toLowerCase()) || custom.some(t => t.toLowerCase() === type.toLowerCase())) return;
    custom.push(type);
    localStorage.setItem(KS_CUSTOM_TYPES_KEY, JSON.stringify(custom));
    ksRenderTypeList();
}
function ksRenderTypeList() {
    const dl = document.getElementById('ksKeyTypeList');
    dl.innerHTML = '';
    [...KS_DEFAULT_TYPES, ...ksCustomTypes()].forEach(t => {
        const opt = document.createElement('option');
        opt.value = t;
        dl.appendChild(opt);
    });
}
ksRenderTypeList();

// "-CLS"-Typen brauchen zwei Werte (Seriennummer + Produktcode), alle
// anderen (z.B. "-OnPrem") einen einzelnen Key-String.
function ksIsClsType(type) {
    return /cls/i.test(type || '');
}
function ksUpdateKeyValueMode() {
    const cls = ksIsClsType(document.getElementById('ksKeyType').value);
    document.getElementById('ksKeyValueSingleWrap').style.display = cls ? 'none' : '';
    document.getElementById('ksKeyValueClsWrap').style.display = cls ? 'flex' : 'none';
}
document.getElementById('ksKeyType').addEventListener('input', ksUpdateKeyValueMode);

async function ksApi(method, path, body) {
    const r = await fetch(path, {
        method,
        headers: body ? { 'Content-Type': 'application/json' } : {},
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'same-origin',
    });
    return r;
}

function ksStatus(row) {
    const now = new Date();
    if (row.validUntil && new Date(row.validUntil) < now) return { cls: 'chip-critical', label: @Json.Serialize(T["keystore.status.expired"].Value) };
    if (row.validFrom && new Date(row.validFrom) > now) return { cls: 'chip-warn', label: @Json.Serialize(T["keystore.status.upcoming"].Value) };
    return { cls: 'chip-ok', label: @Json.Serialize(T["keystore.status.active"].Value) };
}

function ksFmtDate(iso) {
    if (!iso) return '—';
    return new Date(iso).toLocaleDateString();
}

function ksRender() {
    const tbody = document.getElementById('ksBody');
    tbody.innerHTML = '';
    document.getElementById('ksLoading').style.display = 'none';
    if (ksRows.length === 0) {
        document.getElementById('ksEmpty').style.display = 'block';
        document.getElementById('ksTable').style.display = 'none';
        return;
    }
    document.getElementById('ksEmpty').style.display = 'none';
    document.getElementById('ksTable').style.display = '';
    for (const row of ksRows) {
        const st = ksStatus(row);
        const contact = row.customerEmail || (row.customerEmailDomain ? '@@' + row.customerEmailDomain : '—');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td data-th=""><input type="checkbox" class="ks-row-check" data-id="${row.id}" ${ksSelected.has(row.id) ? 'checked' : ''}/></td>
            <td data-th="${@Json.Serialize(T["keystore.col.customer"].Value)}"><strong>${ksEsc(row.customerName)}</strong></td>
            <td data-th="${@Json.Serialize(T["keystore.col.contact"].Value)}" class="mono">${ksEsc(contact)}</td>
            <td data-th="${@Json.Serialize(T["keystore.col.type"].Value)}">${ksEsc(row.keyType)}</td>
            <td data-th="${@Json.Serialize(T["keystore.col.valid_until"].Value)}" class="muted">${ksFmtDate(row.validUntil)}</td>
            <td data-th="${@Json.Serialize(T["keystore.col.status"].Value)}"><span class="chip ${st.cls}">${st.label}</span></td>
            ${KS_IS_ADMIN ? `<td data-th="${@Json.Serialize(T["keystore.col.owner"].Value)}" class="muted">${row.isOwnedByMe ? '—' : ksEsc(row.ownerName || '')}</td>` : ''}
            <td>
                <button class="btn btn-ghost btn-sm" onclick="ksReveal('${row.id}', this)">🔑 @T["keystore.action.reveal"]</button>
                <button class="btn btn-ghost btn-sm" onclick="ksOpenEdit('${row.id}')">@T["keystore.action.edit"]</button>
                <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" onclick="ksDelete('${row.id}')">@T["keystore.action.delete"]</button>
            </td>`;
        tbody.appendChild(tr);
    }
    document.querySelectorAll('.ks-row-check').forEach(cb => {
        cb.addEventListener('change', () => {
            if (cb.checked) ksSelected.add(cb.dataset.id); else ksSelected.delete(cb.dataset.id);
            ksUpdateBulkBar();
        });
    });
    ksUpdateBulkBar();
}

function ksEsc(s) {
    return (s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function ksUpdateBulkBar() {
    const bar = document.getElementById('ksBulkBar');
    if (ksSelected.size === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    document.getElementById('ksBulkCount').textContent =
        ksSelected.size + ' ' + @Json.Serialize(T["keystore.selected_suffix"].Value);
}

function ksToggleAll(checked) {
    ksSelected = new Set(checked ? ksRows.map(r => r.id) : []);
    ksRender();
}

async function ksLoad() {
    const q = document.getElementById('ksSearch').value.trim();
    const r = await ksApi('GET', '/api/v1/keystore' + (q ? '?q=' + encodeURIComponent(q) : ''));
    if (!r.ok) { document.getElementById('ksLoading').textContent = @Json.Serialize(T["keystore.load_error"].Value); return; }
    ksRows = await r.json();
    ksRender();
}

let ksSearchTimer = null;
document.getElementById('ksSearch').addEventListener('input', () => {
    clearTimeout(ksSearchTimer);
    ksSearchTimer = setTimeout(ksLoad, 300);
});

async function ksReveal(id, btn) {
    btn.disabled = true;
    const r = await ksApi('GET', '/api/v1/keystore/' + id + '/reveal');
    btn.disabled = false;
    if (!r.ok) { nimAlert(@Json.Serialize(T["keystore.reveal_error"].Value), { kind: 'error' }); return; }
    const d = await r.json();
    if (window.nsPrompt) window.nsPrompt(@Json.Serialize(T["keystore.action.reveal"].Value), '', d.keyValue);
    else prompt(@Json.Serialize(T["keystore.action.reveal"].Value), d.keyValue);
}

function ksOpenCreate() {
    document.getElementById('ksModalTitle').textContent = @Json.Serialize(T["keystore.new"].Value);
    document.getElementById('ksId').value = '';
    document.getElementById('ksCustomerName').value = '';
    document.getElementById('ksCustomerEmail').value = '';
    document.getElementById('ksCustomerDomain').value = '';
    document.getElementById('ksKeyType').value = '';
    document.getElementById('ksKeyValue').value = '';
    document.getElementById('ksKeyValue').placeholder = 'AV09Z-K13-8FXD-BAVZ-XT';
    document.getElementById('ksKeyValueSerial').value = '';
    document.getElementById('ksKeyValueSerial').placeholder = 'LW13976';
    document.getElementById('ksKeyValueProduct').value = '';
    document.getElementById('ksKeyValueProduct').placeholder = '729093F57';
    document.getElementById('ksValidUntil').value = '';
    document.getElementById('ksNotes').value = '';
    document.getElementById('ksModalError').style.display = 'none';
    ksUpdateKeyValueMode();
    document.getElementById('ksModal').classList.add('open');
}

async function ksOpenEdit(id) {
    const row = ksRows.find(r => r.id === id);
    if (!row) return;
    const unchanged = @Json.Serialize(T["keystore.field.key_value_unchanged"].Value);
    document.getElementById('ksModalTitle').textContent = @Json.Serialize(T["keystore.edit"].Value);
    document.getElementById('ksId').value = row.id;
    document.getElementById('ksCustomerName').value = row.customerName;
    document.getElementById('ksCustomerEmail').value = row.customerEmail || '';
    document.getElementById('ksCustomerDomain').value = row.customerEmailDomain || '';
    document.getElementById('ksKeyType').value = row.keyType;
    document.getElementById('ksKeyValue').value = '';
    document.getElementById('ksKeyValue').placeholder = unchanged;
    document.getElementById('ksKeyValueSerial').value = '';
    document.getElementById('ksKeyValueSerial').placeholder = unchanged;
    document.getElementById('ksKeyValueProduct').value = '';
    document.getElementById('ksKeyValueProduct').placeholder = unchanged;
    document.getElementById('ksValidUntil').value = row.validUntil ? row.validUntil.substring(0, 10) : '';
    document.getElementById('ksNotes').value = row.notes || '';
    document.getElementById('ksModalError').style.display = 'none';
    ksUpdateKeyValueMode();
    document.getElementById('ksModal').classList.add('open');
}

function ksCloseModal() {
    document.getElementById('ksModal').classList.remove('open');
}

async function ksSave() {
    const id = document.getElementById('ksId').value;
    const err = document.getElementById('ksModalError');
    err.style.display = 'none';
    const name = document.getElementById('ksCustomerName').value.trim();
    const email = document.getElementById('ksCustomerEmail').value.trim();
    const domain = document.getElementById('ksCustomerDomain').value.trim();
    const keyType = document.getElementById('ksKeyType').value.trim();

    // v1.11.24: "-CLS"-Typen bestehen aus zwei Teilen (Seriennummer +
    // Produktcode), alle anderen aus einem einzelnen Key-String — die zwei
    // Teile werden für Speicherung/Anzeige zu einem String kombiniert (kein
    // eigenes Server-Feld, um das bestehende KeyValueEncrypted nicht
    // aufzuspalten).
    let keyValue = '';
    if (ksIsClsType(keyType)) {
        const serial = document.getElementById('ksKeyValueSerial').value.trim();
        const product = document.getElementById('ksKeyValueProduct').value.trim();
        if (serial && product) keyValue = serial + ' / ' + product;
        else if (serial || product) {
            err.textContent = @Json.Serialize(T["keystore.error.value_parts_required"].Value);
            err.style.display = 'block';
            return;
        }
    } else {
        keyValue = document.getElementById('ksKeyValue').value.trim();
    }

    if (!name) { err.textContent = @Json.Serialize(T["keystore.error.name_required"].Value); err.style.display = 'block'; return; }
    if (!email && !domain) { err.textContent = @Json.Serialize(T["keystore.error.contact_required"].Value); err.style.display = 'block'; return; }
    if (!keyType) { err.textContent = @Json.Serialize(T["keystore.error.type_required"].Value); err.style.display = 'block'; return; }
    if (!id && !keyValue) { err.textContent = @Json.Serialize(T["keystore.error.value_required"].Value); err.style.display = 'block'; return; }

    const body = {
        customerName: name,
        customerEmail: email || null,
        customerEmailDomain: domain || null,
        keyType,
        validUntil: document.getElementById('ksValidUntil').value ? new Date(document.getElementById('ksValidUntil').value).toISOString() : null,
        notes: document.getElementById('ksNotes').value.trim() || null,
    };
    if (keyValue) body.keyValue = keyValue;

    const btn = document.getElementById('ksSaveBtn');
    btn.disabled = true;
    const r = id ? await ksApi('PATCH', '/api/v1/keystore/' + id, body) : await ksApi('POST', '/api/v1/keystore', body);
    btn.disabled = false;
    if (!r.ok) {
        let msg = @Json.Serialize(T["keystore.save_error"].Value);
        try { const p = await r.json(); if (p.title) msg = p.title; } catch {}
        err.textContent = msg; err.style.display = 'block';
        return;
    }
    ksRememberType(keyType);
    ksCloseModal();
    await ksLoad();
}

async function ksDelete(id) {
    if (!await nimConfirm(@Json.Serialize(T["keystore.confirm_delete"].Value), { danger: true })) return;
    const r = await ksApi('DELETE', '/api/v1/keystore/' + id);
    if (r.ok) { ksSelected.delete(id); await ksLoad(); }
    else nimAlert(@Json.Serialize(T["keystore.delete_error"].Value), { kind: 'error' });
}

async function ksBulkDelete() {
    if (ksSelected.size === 0) return;
    if (!await nimConfirm(@Json.Serialize(T["keystore.confirm_bulk_delete"].Value), { danger: true })) return;
    const r = await ksApi('POST', '/api/v1/keystore/bulk-delete', { ids: Array.from(ksSelected) });
    if (r.ok) { ksSelected = new Set(); await ksLoad(); }
    else nimAlert(@Json.Serialize(T["keystore.delete_error"].Value), { kind: 'error' });
}

ksLoad();

// ── v1.11.37 — Key-Store-Dokumente ──────────────────────────────────────
let kdRows = [];

function kdKeyTypeOptions() {
    return [...KS_DEFAULT_TYPES, ...ksCustomTypes()];
}

function kdRenderKeyTypeCheckboxes(selected) {
    const wrap = document.getElementById('kdKeyTypesWrap');
    wrap.innerHTML = '';
    kdKeyTypeOptions().forEach(t => {
        const id = 'kdType_' + t.replace(/[^a-z0-9]/gi, '_');
        const label = document.createElement('label');
        label.className = 'row';
        label.style.cssText = 'gap:6px;align-items:center;font-weight:normal';
        label.innerHTML = `<input type="checkbox" id="${id}" value="${ksEsc(t)}" ${selected.includes(t) ? 'checked' : ''}/> ${ksEsc(t)}`;
        wrap.appendChild(label);
    });
}

function kdSelectedKeyTypes() {
    return Array.from(document.querySelectorAll('#kdKeyTypesWrap input[type=checkbox]:checked')).map(cb => cb.value);
}

function kdUpdateKindMode() {
    const isFile = document.getElementById('kdKindFile').checked;
    document.getElementById('kdFileWrap').style.display = isFile ? '' : 'none';
    document.getElementById('kdUrlWrap').style.display = isFile ? 'none' : '';
}

async function kdLoad() {
    const r = await ksApi('GET', '/api/v1/keystore/documents');
    document.getElementById('kdLoading').style.display = 'none';
    if (!r.ok) { document.getElementById('kdLoading').textContent = @Json.Serialize(T["keystore.load_error"].Value); document.getElementById('kdLoading').style.display = 'block'; return; }
    kdRows = await r.json();
    kdRender();
}

function kdRender() {
    const tbody = document.getElementById('kdBody');
    tbody.innerHTML = '';
    if (kdRows.length === 0) {
        document.getElementById('kdEmpty').style.display = 'block';
        document.getElementById('kdTable').style.display = 'none';
        return;
    }
    document.getElementById('kdEmpty').style.display = 'none';
    document.getElementById('kdTable').style.display = '';
    for (const row of kdRows) {
        const tr = document.createElement('tr');
        const typeLabel = row.isFile ? ('📄 ' + @Json.Serialize(T["keystore.documents.kind.file"].Value)) : ('🔗 ' + @Json.Serialize(T["keystore.documents.kind.link"].Value));
        tr.innerHTML = `
            <td data-th="${@Json.Serialize(T["keystore.documents.col.label"].Value)}"><strong>${ksEsc(row.label)}</strong></td>
            <td data-th="${@Json.Serialize(T["keystore.documents.col.type"].Value)}">${typeLabel}</td>
            <td data-th="${@Json.Serialize(T["keystore.documents.col.key_types"].Value)}" class="muted">${row.keyTypes.map(ksEsc).join(', ')}</td>
            ${KS_IS_ADMIN ? `<td data-th="${@Json.Serialize(T["keystore.col.owner"].Value)}" class="muted">${row.isOwnedByMe ? '—' : ksEsc(row.ownerName || '')}</td>` : ''}
            <td>
                <button class="btn btn-ghost btn-sm" onclick="kdOpenEdit('${row.id}')">@T["keystore.action.edit"]</button>
                <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" onclick="kdDelete('${row.id}')">@T["keystore.action.delete"]</button>
            </td>`;
        tbody.appendChild(tr);
    }
}

function kdOpenCreate() {
    document.getElementById('kdModalTitle').textContent = @Json.Serialize(T["keystore.documents.new"].Value);
    document.getElementById('kdId').value = '';
    document.getElementById('kdLabel').value = '';
    document.getElementById('kdKindFile').checked = true;
    document.getElementById('kdKindWrap').style.display = '';
    document.getElementById('kdFile').value = '';
    document.getElementById('kdFile').required = true;
    document.getElementById('kdCurrentFileHint').style.display = 'none';
    document.getElementById('kdUrl').value = '';
    kdUpdateKindMode();
    kdRenderKeyTypeCheckboxes([]);
    document.getElementById('kdModalError').style.display = 'none';
    document.getElementById('kdModal').classList.add('open');
}

function kdOpenEdit(id) {
    const row = kdRows.find(r => r.id === id);
    if (!row) return;
    document.getElementById('kdModalTitle').textContent = @Json.Serialize(T["keystore.action.edit"].Value);
    document.getElementById('kdId').value = row.id;
    document.getElementById('kdLabel').value = row.label;
    // Art (Datei/Link) ist nach dem Anlegen fix — nur der Inhalt (neue Datei-
    // Version bzw. neue URL) lässt sich ändern.
    document.getElementById('kdKindWrap').style.display = 'none';
    document.getElementById('kdKindFile').checked = row.isFile;
    document.getElementById('kdKindLink').checked = !row.isFile;
    document.getElementById('kdFile').value = '';
    document.getElementById('kdFile').required = false;
    document.getElementById('kdCurrentFileHint').style.display = row.isFile ? 'block' : 'none';
    document.getElementById('kdCurrentFileHint').textContent = row.isFile
        ? @Json.Serialize(T["keystore.documents.field.file_current"].Value) + ' ' + (row.fileName || '')
        : '';
    document.getElementById('kdUrl').value = row.url || '';
    kdUpdateKindMode();
    kdRenderKeyTypeCheckboxes(row.keyTypes || []);
    document.getElementById('kdModalError').style.display = 'none';
    document.getElementById('kdModal').classList.add('open');
}

function kdCloseModal() {
    document.getElementById('kdModal').classList.remove('open');
}

async function kdSave() {
    const id = document.getElementById('kdId').value;
    const err = document.getElementById('kdModalError');
    err.style.display = 'none';
    const label = document.getElementById('kdLabel').value.trim();
    const isFile = document.getElementById('kdKindFile').checked;
    const keyTypes = kdSelectedKeyTypes();
    const file = document.getElementById('kdFile').files[0];
    const url = document.getElementById('kdUrl').value.trim();

    if (!label) { err.textContent = @Json.Serialize(T["keystore.documents.error.label_required"].Value); err.style.display = 'block'; return; }
    if (keyTypes.length === 0) { err.textContent = @Json.Serialize(T["keystore.documents.error.types_required"].Value); err.style.display = 'block'; return; }
    if (!isFile && !url) { err.textContent = @Json.Serialize(T["keystore.documents.error.url_required"].Value); err.style.display = 'block'; return; }
    if (!id && isFile && !file) { err.textContent = @Json.Serialize(T["keystore.documents.error.file_required"].Value); err.style.display = 'block'; return; }

    const btn = document.getElementById('kdSaveBtn');
    btn.disabled = true;
    try {
        if (!id) {
            if (isFile) {
                const fd = new FormData();
                fd.append('label', label);
                fd.append('keyTypes', keyTypes.join(','));
                fd.append('file', file);
                const r = await fetch('/api/v1/keystore/documents/upload', { method: 'POST', body: fd, credentials: 'same-origin' });
                if (!r.ok) throw new Error(await kdErrorMsg(r));
            } else {
                const r = await ksApi('POST', '/api/v1/keystore/documents/link', { label, url, keyTypes });
                if (!r.ok) throw new Error(await kdErrorMsg(r));
            }
        } else {
            if (file) {
                const fd = new FormData();
                fd.append('file', file);
                const rf = await fetch('/api/v1/keystore/documents/' + id + '/replace-file', { method: 'POST', body: fd, credentials: 'same-origin' });
                if (!rf.ok) throw new Error(await kdErrorMsg(rf));
            }
            const body = { label, keyTypes };
            if (!isFile) body.url = url;
            const r = await ksApi('PATCH', '/api/v1/keystore/documents/' + id, body);
            if (!r.ok) throw new Error(await kdErrorMsg(r));
        }
        kdCloseModal();
        await kdLoad();
    } catch (e) {
        err.textContent = e.message || @Json.Serialize(T["keystore.documents.save_error"].Value);
        err.style.display = 'block';
    } finally {
        btn.disabled = false;
    }
}

async function kdErrorMsg(r) {
    try { const p = await r.json(); if (p.title) return p.title; } catch {}
    return @Json.Serialize(T["keystore.documents.save_error"].Value);
}

async function kdDelete(id) {
    if (!await nimConfirm(@Json.Serialize(T["keystore.documents.confirm_delete"].Value), { danger: true })) return;
    const r = await ksApi('DELETE', '/api/v1/keystore/documents/' + id);
    if (r.ok) await kdLoad();
    else nimAlert(@Json.Serialize(T["keystore.documents.delete_error"].Value), { kind: 'error' });
}

kdLoad();
</script>
