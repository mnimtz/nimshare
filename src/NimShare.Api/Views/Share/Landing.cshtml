@model NimShare.Api.Controllers.LandingViewModel
@{
    ViewData["Title"] = Model.Theme.Title ?? Model.FileName;
    Layout = "_Layout";
    var accent = Model.Theme.PrimaryColor ?? "#002854";
}
@if (!string.IsNullOrEmpty(Model.Theme.HeroUrl))
{
    <div style="height:180px;background:@accent url('@Model.Theme.HeroUrl') center/cover;margin-bottom:-40px"></div>
}
<div class="landing-shell">
    <div class="landing-card" style="border-top:4px solid @accent;position:relative">
        @{
            // v1.12.4: siehe FolderLanding — bei Custom-Branding "Geteilt von …"
            // unter den Avatar (rechts) statt neben das Kundenlogo (links).
            var brandedWithAvatar = Model.Theme.IsCustomBranded && !string.IsNullOrEmpty(Model.OwnerAvatarUrl);
            // v1.12.6: signiert → Name steht schon im Signatur-Badge, obere Zeile entfällt.
            var showSharedBy = Model.Signer is null;
        }
        @if (!string.IsNullOrEmpty(Model.OwnerAvatarUrl))
        {
            <img src="@Model.OwnerAvatarUrl" alt="@Model.OwnerName" title="@Model.OwnerName"
                 style="position:absolute;top:24px;right:28px;width:72px;height:72px;border-radius:50%;object-fit:cover;box-shadow:0 6px 20px rgba(0,0,0,.18),0 0 0 4px #fff,0 0 0 5px rgba(0,0,0,.06);z-index:2"/>
            @if (brandedWithAvatar && showSharedBy)
            {
                <div class="landing-owner-caption" style="top:112px">@T["landing.shared_by"] @Model.OwnerName</div>
            }
        }
        <div class="landing-brand @(brandedWithAvatar ? "branded" : "")">
            @if (!string.IsNullOrEmpty(Model.Theme.LogoUrl))
            {
                <img src="@Model.Theme.LogoUrl" style="max-height:48px;max-width:200px" alt=""/>
            }
            else
            {
                <img src="/img/icon-64.png" width="40" height="40" alt="NimShare" style="border-radius:8px"/>
            }
            @* v1.12.7: Firmenname neben dem Kundenlogo (nur Custom-Branding, opt-in). *@
            @if (!string.IsNullOrWhiteSpace(Model.Theme.BrandName))
            {
                <span class="landing-brandname">@Model.Theme.BrandName</span>
            }
            @if (showSharedBy)
            {
                <small>@T["landing.shared_by"] @Model.OwnerName</small>
            }
        </div>

        @* v1.10.146/153: Absender-Zertifikat-Badge — Details, Verify-Anleitung,
           Public-Cert-Download, Ablauf-Warnung — alle 3 Landings teilen sich
           die Partial _LandingSignerBadge. *@
        @if (Model.Signer is not null)
        {
            @await Html.PartialAsync("_LandingSignerBadge",
                new NimShare.Api.Views.Shared.LandingSignerBadgeVm(Model.Signer, $"/s/{Model.Slug}/signer-cert.cer"))
        }

        <h1 style="color:@accent@(brandedWithAvatar ? ";margin-top:18px" : "")">@(Model.Theme.Title ?? T["landing.title"].Value)</h1>
        @if (!string.IsNullOrEmpty(Model.Theme.Subtitle))
        {
            <p class="lede">@Model.Theme.Subtitle</p>
        }
        @if (!string.IsNullOrEmpty(Model.Theme.BodyMarkdown))
        {
            <div style="margin:var(--sp-4) 0;line-height:1.55">
                @Html.Raw(NimShare.Api.Services.SafeMarkdown.ToHtml(Model.Theme.BodyMarkdown))
            </div>
        }
        <p class="landing-meta">
            @if (Model.ExpiresAt is not null)
            {
                <span>@T["landing.expires_at"] <span class="mono">@Model.ExpiresAt.Value.ToString("u")</span></span>
            }
            @if (Model.MaxDownloads is not null)
            {
                <span class="chip">@(Model.MaxDownloads - Model.DownloadCount) / @Model.MaxDownloads @T["landing.downloads_left"]</span>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.MessageHtml))
        {
            <div class="card" style="background:var(--tw-gray-100);margin-top:var(--sp-6)">
                @Html.Raw(Model.MessageHtml)
            </div>
        }

        <div class="file-tile">
            <div class="icon">@GetExt(Model.FileName)</div>
            <div class="meta">
                <span class="name">@Model.FileName</span>
                <span class="sub">@HumanBytes(Model.SizeBytes) · @Model.ContentType</span>
            </div>
        </div>

        @{
            var ct = (Model.ContentType ?? "").ToLowerInvariant();
            // v1.10.83: Video + Audio als previewable — Blob Storage kann Range-
            // Requests, der Browser streamt direkt und der Empfänger kann seeken
            // ohne erst das ganze File runterladen zu müssen.
            var isImage = ct.StartsWith("image/");
            var isPdf = ct == "application/pdf";
            var isVideo = ct.StartsWith("video/");
            var isAudio = ct.StartsWith("audio/");
            var previewable = isImage || isPdf || isVideo || isAudio;
        }
        @if (previewable && !Model.HasPassword)
        {
            <div style="margin-top:var(--sp-4);border:1px solid var(--tw-gray-200);border-radius:8px;overflow:hidden;background:@(isAudio ? "transparent" : "var(--tw-gray-100)")">
                @if (isImage)
                {
                    <img src="/s/@Model.Slug/preview" alt="@Model.FileName"
                         style="display:block;max-width:100%;max-height:60vh;margin:0 auto;background:#fff"/>
                }
                else if (isVideo)
                {
                    <video controls preload="metadata" playsinline
                           style="display:block;width:100%;max-height:60vh;background:#000;outline:none"
                           poster="">
                        <source src="/s/@Model.Slug/preview" type="@Model.ContentType"/>
                        @T["landing.video.unsupported"]
                    </video>
                }
                else if (isAudio)
                {
                    <audio controls preload="metadata"
                           style="display:block;width:100%;padding:var(--sp-3)">
                        <source src="/s/@Model.Slug/preview" type="@Model.ContentType"/>
                        @T["landing.audio.unsupported"]
                    </audio>
                }
                else
                {
                    <iframe src="/s/@Model.Slug/preview" title="@Model.FileName"
                            style="width:100%;height:60vh;border:0;background:#fff"></iframe>
                }
            </div>
        }
        else if (previewable && Model.HasPassword)
        {
            <div class="muted" style="margin-top:var(--sp-3);font-size:.85rem">🔒 @T["landing.preview_after_password"]</div>
        }

        @if (Model.HasSerialNumber)
        {
            <div class="card" id="serialCard" style="margin-top:var(--sp-4);background:var(--tw-gray-100)">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);flex-wrap:wrap">
                    <strong>🔑 @T["landing.serial.title"]</strong>
                    <div style="display:flex;gap:var(--sp-2)">
                        <button type="button" class="btn btn-ghost btn-sm" id="serialRevealBtn" onclick="serialReveal()">@T["landing.serial.reveal_button"]</button>
                        <button type="button" class="btn btn-ghost btn-sm" id="serialEmailToggleBtn" onclick="serialToggleEmail()">@T["landing.serial.email_button"]</button>
                    </div>
                </div>
                <div id="serialValueOut" style="display:none;margin-top:var(--sp-3)">
                    <span id="serialValueText" class="mono" style="letter-spacing:.08em;font-size:1.05rem;font-weight:600;user-select:all"></span>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="serialCopy()" style="margin-left:var(--sp-2)" id="serialCopyBtn">@T["landing.serial.copy"]</button>
                </div>
                <div id="serialErrorOut" class="helper" style="display:none;margin-top:var(--sp-3);color:var(--status-critical)"></div>
                <div id="serialEmailForm" style="display:none;margin-top:var(--sp-3)">
                    <div class="field" style="max-width:340px">
                        <label for="serialEmailInput">@T["landing.serial.email_placeholder"]</label>
                        <input type="email" id="serialEmailInput" placeholder="name@example.com"/>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;margin-top:var(--sp-2)" onclick="serialSendEmail()" id="serialEmailSendBtn">@T["landing.serial.email_send"]</button>
                    <div id="serialEmailStatus" class="helper" style="margin-top:var(--sp-2)"></div>
                </div>
            </div>
            <script>
            function serialPassword() {
                const el = document.getElementById('password');
                return el ? el.value : null;
            }
            async function serialParseError(r) {
                if (r.status === 403) return @Json.Serialize(T["landing.serial.error_password"].Value);
                return @Json.Serialize(T["landing.serial.error"].Value);
            }
            async function serialReveal() {
                const btn = document.getElementById('serialRevealBtn');
                const err = document.getElementById('serialErrorOut');
                err.style.display = 'none';
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/serial/reveal', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ password: serialPassword() })
                    });
                    if (!r.ok) { err.textContent = await serialParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    const d = await r.json();
                    document.getElementById('serialValueText').textContent = d.serialNumber;
                    document.getElementById('serialValueOut').style.display = 'block';
                    btn.style.display = 'none';
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            async function serialCopy() {
                const text = document.getElementById('serialValueText').textContent;
                try { await navigator.clipboard.writeText(text); } catch {}
                const btn = document.getElementById('serialCopyBtn');
                const original = btn.textContent;
                btn.textContent = @Json.Serialize(T["landing.serial.copied"].Value);
                setTimeout(() => { btn.textContent = original; }, 1500);
            }
            function serialToggleEmail() {
                const f = document.getElementById('serialEmailForm');
                f.style.display = f.style.display === 'none' ? 'block' : 'none';
            }
            async function serialSendEmail() {
                const err = document.getElementById('serialErrorOut');
                const status = document.getElementById('serialEmailStatus');
                const btn = document.getElementById('serialEmailSendBtn');
                const email = document.getElementById('serialEmailInput').value.trim();
                err.style.display = 'none';
                status.textContent = '';
                if (!email || !email.includes('@@')) { status.textContent = @Json.Serialize(T["landing.serial.email_invalid"].Value); return; }
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/serial/email', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ toEmail: email, password: serialPassword() })
                    });
                    if (!r.ok) { err.textContent = await serialParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    status.textContent = @Json.Serialize(T["landing.serial.email_sent"].Value);
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            </script>
        }
        else if (Model.KeyStoreMode)
        {
            @* v1.11.22: Lizenzschlüssel-Modus — Besucher gibt seine Email ein,
               Server matched gegen den Key-Store des Link-Besitzers (exakt
               oder Domain-Wildcard) statt eines fest hinterlegten Werts. *@
            <div class="card" id="keystoreCard" style="margin-top:var(--sp-4);background:var(--tw-gray-100)">
                <strong>🔑 @T["landing.keystore.title"]</strong>
                <p class="muted" style="margin:6px 0 0;font-size:.88rem">@T["landing.keystore.lede"]</p>
                <div class="field" style="max-width:340px;margin-top:8px">
                    <label for="keystoreEmailInput">@T["landing.keystore.email_placeholder"]</label>
                    <input type="email" id="keystoreEmailInput" placeholder="name@example.com"/>
                </div>
                <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:8px">
                    <button type="button" class="btn btn-primary btn-sm" style="background:@accent;color:#fff" onclick="keystoreReveal()" id="keystoreRevealBtn">@T["landing.keystore.reveal_button"]</button>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="keystoreSendEmail()" id="keystoreEmailBtn">@T["landing.keystore.email_button"]</button>
                </div>
                <div id="keystoreErrorOut" class="helper" style="display:none;margin-top:var(--sp-3);color:var(--status-critical)"></div>
                <div id="keystoreStatusOut" class="helper" style="display:none;margin-top:var(--sp-3)"></div>
                <div id="keystoreValueOut" style="display:none;margin-top:var(--sp-3)">
                    <div class="muted" id="keystoreTypeOut" style="font-size:.82rem;margin-bottom:2px"></div>
                    <span id="keystoreValueText" class="mono" style="letter-spacing:.08em;font-size:1.05rem;font-weight:600;user-select:all"></span>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="keystoreCopy()" style="margin-left:var(--sp-2)" id="keystoreCopyBtn">@T["landing.serial.copy"]</button>
                    <div id="keystoreValidUntilOut" class="muted" style="font-size:.8rem;margin-top:4px"></div>
                    <div id="keystoreDocOut" style="margin-top:8px"></div>
                </div>
            </div>
            <script>
            function keystorePassword() {
                const el = document.getElementById('password');
                return el ? el.value : null;
            }
            async function keystoreParseError(r) {
                if (r.status === 403) return @Json.Serialize(T["landing.serial.error_password"].Value);
                if (r.status === 404) return @Json.Serialize(T["landing.keystore.not_found"].Value);
                if (r.status === 422) return @Json.Serialize(T["landing.keystore.invalid_email"].Value);
                return @Json.Serialize(T["landing.serial.error"].Value);
            }
            // v1.11.37/v1.11.44 — Marcus: alle passenden Key-Store-Dokumente
            // (PDFs, feste Links) erscheinen als eigene Button-Reihe, sauber
            // ins Card-Layout eingepasst. Kein fester Doku-Link mehr — die
            // Dokumentation-Checkbox ist reines Ein/Aus, die Buttons kommen
            // ausschließlich aus den flexiblen Key-Store-Dokumenten.
            function keystoreRenderDocs(documents) {
                const out = document.getElementById('keystoreDocOut');
                out.innerHTML = '';
                if (!documents || documents.length === 0) return;
                const wrap = document.createElement('div');
                wrap.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap';
                documents.forEach(d => {
                    const a = document.createElement('a');
                    a.href = d.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
                    a.className = 'btn btn-ghost btn-sm';
                    a.textContent = (d.isFile ? '📄 ' : '🔗 ') + d.label;
                    wrap.appendChild(a);
                });
                out.appendChild(wrap);
            }
            async function keystoreReveal() {
                const email = document.getElementById('keystoreEmailInput').value.trim();
                const err = document.getElementById('keystoreErrorOut');
                const status = document.getElementById('keystoreStatusOut');
                err.style.display = 'none'; status.style.display = 'none';
                if (!email || !email.includes('@@')) { err.textContent = @Json.Serialize(T["landing.keystore.invalid_email"].Value); err.style.display = 'block'; return; }
                const btn = document.getElementById('keystoreRevealBtn');
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/keystore/reveal', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ email, password: keystorePassword() })
                    });
                    if (!r.ok) { err.textContent = await keystoreParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    const d = await r.json();
                    document.getElementById('keystoreTypeOut').textContent = d.keyType;
                    document.getElementById('keystoreValueText').textContent = d.keyValue;
                    document.getElementById('keystoreValidUntilOut').textContent = d.validUntil
                        ? @Json.Serialize(T["landing.keystore.valid_until_prefix"].Value) + ' ' + new Date(d.validUntil).toLocaleDateString()
                        : '';
                    keystoreRenderDocs(d.documents);
                    document.getElementById('keystoreValueOut').style.display = 'block';
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            async function keystoreCopy() {
                const text = document.getElementById('keystoreValueText').textContent;
                try { await navigator.clipboard.writeText(text); } catch {}
                const btn = document.getElementById('keystoreCopyBtn');
                const original = btn.textContent;
                btn.textContent = @Json.Serialize(T["landing.serial.copied"].Value);
                setTimeout(() => { btn.textContent = original; }, 1500);
            }
            async function keystoreSendEmail() {
                const email = document.getElementById('keystoreEmailInput').value.trim();
                const err = document.getElementById('keystoreErrorOut');
                const status = document.getElementById('keystoreStatusOut');
                err.style.display = 'none'; status.style.display = 'none';
                if (!email || !email.includes('@@')) { err.textContent = @Json.Serialize(T["landing.keystore.invalid_email"].Value); err.style.display = 'block'; return; }
                const btn = document.getElementById('keystoreEmailBtn');
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/keystore/email', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ email, password: keystorePassword() })
                    });
                    if (!r.ok) { err.textContent = await keystoreParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    status.textContent = @Json.Serialize(T["landing.keystore.email_sent"].Value);
                    status.style.display = 'block';
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            </script>
        }

        <div id="aiSummaryBlock" style="margin-top:var(--sp-4)">
            <button type="button" class="btn btn-ghost btn-sm" id="aiSummaryBtn" onclick="loadAiSummary()">✨ @T["landing.ai_summary"]</button>
            <div id="aiSummaryOut" class="muted" style="margin-top:var(--sp-3);font-style:italic;line-height:1.5"></div>
        </div>
        <script>
        async function loadAiSummary() {
            const btn = document.getElementById('aiSummaryBtn');
            const out = document.getElementById('aiSummaryOut');
            btn.disabled = true;
            out.textContent = @Json.Serialize(T["landing.ai_summary.loading"].Value);
            const r = await fetch('/api/v1/ai/summary', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ slug: @Json.Serialize(Model.Slug) })
            });
            if (r.status === 503) { out.textContent = @Json.Serialize(T["landing.ai_summary.disabled"].Value); btn.style.display='none'; return; }
            if (r.status === 415) { out.textContent = @Json.Serialize(T["landing.ai_summary.unsupported"].Value); return; }
            if (!r.ok) {
                let extra = '';
                try { const p = await r.json(); if (p.detail) extra = ' (' + p.detail + ')'; } catch {}
                out.textContent = @Json.Serialize(T["landing.ai_summary.error"].Value) + extra;
                btn.disabled = false;
                return;
            }
            const d = await r.json();
            out.textContent = d.summary || '';
            btn.style.display='none';
        }
        </script>
        @await Html.PartialAsync("_TimezoneBeacon", Model.Slug)

        <form method="post" asp-controller="Share" asp-action="Submit" asp-route-slug="@Model.Slug" class="stack">
            @if (Model.HasPassword)
            {
                <div class="field">
                    <label for="password">@T["landing.password.label"]</label>
                    <input type="password" name="password" id="password" required autofocus/>
                    @if (TempData["PasswordError"] is string err)
                    {
                        <div class="helper" style="color:var(--status-critical)">@err</div>
                    }
                </div>
            }
            <button type="submit" class="btn btn-primary" style="background:@accent;color:#fff">@T["landing.download.button"]</button>
        </form>

        @* v1.12.3: eigenes Anbieter-Logo im Footer — nur bei Custom-Branding-
           Kunden-Links (ProviderLogoUrl gesetzt); sonst unverändert. *@
        @if (!string.IsNullOrWhiteSpace(Model.Theme.ProviderLogoUrl))
        {
            <div style="margin-top:var(--sp-6);text-align:center">
                <img src="@Model.Theme.ProviderLogoUrl" alt="@Model.OwnerName" title="@Model.OwnerName"
                     style="max-height:32px;max-width:180px;object-fit:contain;opacity:.9;display:block;margin:0 auto"/>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Theme.FooterText))
        {
            <p class="landing-meta" style="margin-top:var(--sp-6)">@Model.Theme.FooterText</p>
        }
        <p class="landing-meta" style="margin-top:var(--sp-4);font-size:.75rem">
            @T["landing.powered_by"] <strong>NimShare</strong>
        </p>
        @await Html.PartialAsync("_AppStoreBadge")
        @await Html.PartialAsync("_LinkFeedbackWidget", Model.Slug)
    </div>
</div>

@functions {
    static string GetExt(string name)
    {
        var ext = System.IO.Path.GetExtension(name).TrimStart('.').ToUpperInvariant();
        return string.IsNullOrEmpty(ext) ? "FILE" : (ext.Length > 4 ? ext[..4] : ext);
    }
    static string HumanBytes(long b)
    {
        string[] u = { "B", "KB", "MB", "GB", "TB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {u[i]}";
    }
}
