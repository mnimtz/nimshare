@model NimShare.Api.Controllers.PasswordGateViewModel
@{
    ViewData["Title"] = T["landing.pwgate.title"].Value;
    Layout = "_Layout";
    var theme = Model.Theme;
    // Gleiche Akzent-Logik wie Landing/FolderLanding (Button-Hintergrund + Titel).
    var accent = string.IsNullOrWhiteSpace(theme?.PrimaryColor) ? "#002854" : theme!.PrimaryColor!;
}
@* v1.12.22 — Passwort-Gate: steht VOR der Landing. Zeigt bewusst keinerlei
   Inhalts-Metadaten (Datei-/Ordnername, Dateiliste, Nachricht) — nur Branding
   + Absender. Nach korrektem Passwort schaltet die Session frei und die
   Landing rendert ohne jede weitere Abfrage (kein prompt() mehr). *@
<div class="landing-shell">
    <div class="landing-card" style="max-width:460px;border-top:4px solid @accent">
        <div style="text-align:center;margin-bottom:var(--sp-4)">
            @if (!string.IsNullOrEmpty(theme?.LogoUrl))
            {
                <img src="@theme.LogoUrl" alt="" style="max-height:56px;max-width:220px;object-fit:contain;display:block;margin:0 auto"/>
            }
            else
            {
                <img src="/img/icon-64.png" width="48" height="48" alt="" style="border-radius:8px;display:block;margin:0 auto"/>
            }
        </div>
        <h1 style="margin:0 0 var(--sp-2);text-align:center;color:@accent;font-size:1.3rem">🔒 @T["landing.pwgate.title"]</h1>
        <p class="muted" style="text-align:center;margin-top:0">@T["landing.pwgate.lede"]</p>
        @if (!string.IsNullOrEmpty(Model.OwnerName))
        {
            <p class="muted" style="text-align:center;font-size:.85rem;margin-top:var(--sp-1)">@T["landing.shared_by"] <strong>@Model.OwnerName</strong></p>
        }
        <form method="post" action="/s/@Model.Slug/gate/password" style="margin-top:var(--sp-4)">
            @Html.AntiForgeryToken()
            @if (Model.Error is string err)
            {
                <div class="helper" style="color:var(--status-critical);margin-bottom:var(--sp-2)">@err</div>
            }
            <div class="field">
                <label for="password">@T["landing.pwgate.label"]</label>
                <input type="password" name="password" id="password" required autofocus autocomplete="current-password"/>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:var(--sp-2);background:@accent;color:#fff;border-color:@accent">@T["landing.pwgate.submit"]</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(theme?.ProviderLogoUrl))
        {
            <div style="margin-top:var(--sp-6);text-align:center">
                <img src="@theme.ProviderLogoUrl" alt="@Model.OwnerName" title="@Model.OwnerName"
                     style="max-height:28px;max-width:160px;object-fit:contain;opacity:.9;display:block;margin:0 auto"/>
            </div>
        }
    </div>
</div>
