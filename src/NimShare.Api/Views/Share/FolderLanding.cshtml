@model NimShare.Api.Controllers.FolderLandingViewModel
@{
    ViewData["Title"] = Model.FolderName;
    Layout = "_Layout";
    var theme = Model.Theme;
    // Same style pattern as Share/Landing.cshtml — inline `style="background:@accent;color:#fff"`
    // on the button instead of a `<style>` block with !important. The old
    // !important approach only overrode `background`, leaving the base
    // `color: var(--tw-primary)` (dark blue) — so a dark-blue brand became
    // dark-blue button + dark-blue text = looked "komplett schwarz".
    var accent = string.IsNullOrWhiteSpace(theme?.PrimaryColor) ? "#002854" : theme!.PrimaryColor!;
    string Bytes(long b)
    {
        string[] u = { "B", "KB", "MB", "GB", "TB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {u[i]}";
    }
    // v1.10.167: Gallery-Modus. Bilder + Videos werden aus der klassischen
    // Liste in ein Grid+Lightbox gelöst; andere Dateitypen (Docs, ZIPs,
    // Audio) landen in einer schlanken „weitere Dateien"-Zeile darunter.
    bool IsMedia(string? ct) => (ct ?? "").StartsWith("image/") || (ct ?? "").StartsWith("video/");
    bool IsImage(string? ct) => (ct ?? "").StartsWith("image/");
    var mediaFiles = Model.IsGallery ? Model.Files.Where(f => IsMedia(f.ContentType)).ToList() : new List<NimShare.Api.Controllers.FolderLandingFile>();
    var otherFiles = Model.IsGallery ? Model.Files.Where(f => !IsMedia(f.ContentType)).ToList() : Model.Files;
    // Passwort-geschützte Links dürfen aktuell keine Preview-Endpoints nutzen
    // (ShareController.GalleryMedia forbid'et). Dann zeigen wir Kacheln ohne
    // Thumbnail, mit Filename + Download-Button — Album-Metaphor bleibt erhalten.
    var canPreview = !Model.HasPassword;
}
@{
    // v1.10.171: Gallery-Landing skaliert Hero + Avatar größer, damit die
    // Proportionen zur breiten Card (1120px) passen. Auf Mobile drosseln wir
    // per @@media in der Section unten wieder runter, damit nichts zerläuft.
    var heroHeight = Model.IsGallery ? "260px" : "180px";
    var avatarSize = Model.IsGallery ? 112 : 72;
}
@if (!string.IsNullOrEmpty(theme?.HeroUrl))
{
    @* v1.10.171: `background-position: center 30%` zeigt den oberen Bild-Teil
       (Skyline/Logo) statt Bildmitte — vorher war bei detaillierten Hero-
       Grafiken die Skyline oben abgeschnitten. `background-size: cover` bleibt,
       ergänzt um `no-repeat` fürs saubere Rendering auf schmalen Viewports. *@
    <div style="height:@heroHeight;background:@accent url('@theme.HeroUrl') center/contain no-repeat;margin-bottom:-40px"></div>
}
<div class="landing-shell">
    <div class="landing-card gallery-@(Model.IsGallery ? "on" : "off")" style="max-width:@(Model.IsGallery ? "1120px" : "720px");position:relative;border-top:4px solid @accent">
        @if (!string.IsNullOrEmpty(Model.OwnerAvatarUrl))
        {
            <img src="@Model.OwnerAvatarUrl" alt="@Model.OwnerName" title="@Model.OwnerName"
                 class="landing-owner-avatar"
                 style="position:absolute;top:24px;right:28px;width:@(avatarSize)px;height:@(avatarSize)px;border-radius:50%;object-fit:cover;box-shadow:0 8px 24px rgba(0,0,0,.22),0 0 0 5px #fff,0 0 0 6px rgba(0,0,0,.06);z-index:2"/>
        }
        @{
            // v1.10.171: im Gallery-Modus dürfen Logo + Owner-Avatar größer,
            // damit sie zur breiten Card (1120px) im Verhältnis passen.
            var logoMax = Model.IsGallery ? 80 : 48;
        }
        <div class="landing-brand">
            @if (!string.IsNullOrWhiteSpace(theme?.LogoUrl))
            {
                <img src="@theme.LogoUrl" alt="Logo" style="max-height:@(logoMax)px;max-width:280px;object-fit:contain"/>
            }
            else
            {
                <img src="/img/icon-64.png" width="@(Model.IsGallery ? 56 : 40)" height="@(Model.IsGallery ? 56 : 40)" alt="NimShare" style="border-radius:8px"/>
            }
            <small>@T["landing.shared_by"] @Model.OwnerName</small>
        </div>
        @* v1.10.146/153: Absender-Zertifikat-Badge — teilt Partial mit den Share-Landings. *@
        @if (Model.Signer is not null)
        {
            @await Html.PartialAsync("_LandingSignerBadge",
                new NimShare.Api.Views.Shared.LandingSignerBadgeVm(Model.Signer, $"/s/{Model.Slug}/signer-cert.cer"))
        }
        <h1 style="color:@accent">@(Model.IsGallery ? "🖼" : "📁") @(string.IsNullOrWhiteSpace(theme?.Title) ? Model.FolderName : theme!.Title!)</h1>
        @if (!string.IsNullOrWhiteSpace(theme?.Subtitle))
        {
            <p class="lede">@theme.Subtitle</p>
        }
        <p class="landing-meta">
            @if (Model.IsGallery)
            {
                @T["landing.gallery.lede"] @mediaFiles.Count
                @if (Model.AllowUploads)
                {
                    <text> · @T["landing.gallery.upload_allowed"]</text>
                }
            }
            else
            {
                @T["landing.folder.lede"] @Model.Files.Count
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(theme?.BodyMarkdown))
        {
            <div style="margin:var(--sp-4) 0;line-height:1.55">
                @Html.Raw(Markdig.Markdown.ToHtml(theme.BodyMarkdown))
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.MessageHtml))
        {
            <div class="card" style="background:var(--tw-gray-100);margin-top:var(--sp-4)">
                @Html.Raw(Model.MessageHtml)
            </div>
        }

        @* v1.11.20: Seriennummer-Karte — Bug-Fix, war fälschlich auf File-
           Links beschränkt. FolderLanding hat kein persistentes #password-
           Feld (Downloads nutzen prompt() pro Aktion, siehe unten im File),
           darum holt serialPassword() das Passwort hier ebenfalls per
           prompt() statt aus einem Formularfeld. *@
        @if (Model.HasSerialNumber)
        {
            <div class="card" id="serialCard" style="margin-top:var(--sp-4);background:var(--tw-gray-100)">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);flex-wrap:wrap">
                    <strong>🔑 @T["landing.serial.title"]</strong>
                    <div style="display:flex;gap:var(--sp-2)">
                        <button type="button" class="btn btn-ghost btn-sm" id="serialRevealBtn" onclick="serialReveal()">@T["landing.serial.reveal_button"]</button>
                        <button type="button" class="btn btn-ghost btn-sm" id="serialEmailToggleBtn" onclick="serialToggleEmail()">@T["landing.serial.email_button"]</button>
                    </div>
                </div>
                <div id="serialValueOut" style="display:none;margin-top:var(--sp-3)">
                    <span id="serialValueText" class="mono" style="letter-spacing:.08em;font-size:1.05rem;font-weight:600;user-select:all"></span>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="serialCopy()" style="margin-left:var(--sp-2)" id="serialCopyBtn">@T["landing.serial.copy"]</button>
                </div>
                <div id="serialErrorOut" class="helper" style="display:none;margin-top:var(--sp-3);color:var(--status-critical)"></div>
                <div id="serialEmailForm" style="display:none;margin-top:var(--sp-3)">
                    <div class="field" style="max-width:340px">
                        <label for="serialEmailInput">@T["landing.serial.email_placeholder"]</label>
                        <input type="email" id="serialEmailInput" placeholder="name@example.com"/>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;margin-top:var(--sp-2)" onclick="serialSendEmail()" id="serialEmailSendBtn">@T["landing.serial.email_send"]</button>
                    <div id="serialEmailStatus" class="helper" style="margin-top:var(--sp-2)"></div>
                </div>
            </div>
            <script>
            let serialPasswordCache = null;
            function serialPassword() {
                if (!@Json.Serialize(Model.HasPassword)) return null;
                if (serialPasswordCache) return serialPasswordCache;
                serialPasswordCache = prompt(@Json.Serialize(T["landing.password.label"].Value)) || null;
                return serialPasswordCache;
            }
            async function serialParseError(r) {
                if (r.status === 403) { serialPasswordCache = null; return @Json.Serialize(T["landing.serial.error_password"].Value); }
                return @Json.Serialize(T["landing.serial.error"].Value);
            }
            async function serialReveal() {
                const btn = document.getElementById('serialRevealBtn');
                const err = document.getElementById('serialErrorOut');
                err.style.display = 'none';
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/serial/reveal', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ password: serialPassword() })
                    });
                    if (!r.ok) { err.textContent = await serialParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    const d = await r.json();
                    document.getElementById('serialValueText').textContent = d.serialNumber;
                    document.getElementById('serialValueOut').style.display = 'block';
                    btn.style.display = 'none';
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            async function serialCopy() {
                const text = document.getElementById('serialValueText').textContent;
                try { await navigator.clipboard.writeText(text); } catch {}
                const btn = document.getElementById('serialCopyBtn');
                const original = btn.textContent;
                btn.textContent = @Json.Serialize(T["landing.serial.copied"].Value);
                setTimeout(() => { btn.textContent = original; }, 1500);
            }
            function serialToggleEmail() {
                const f = document.getElementById('serialEmailForm');
                f.style.display = f.style.display === 'none' ? 'block' : 'none';
            }
            async function serialSendEmail() {
                const err = document.getElementById('serialErrorOut');
                const status = document.getElementById('serialEmailStatus');
                const btn = document.getElementById('serialEmailSendBtn');
                const email = document.getElementById('serialEmailInput').value.trim();
                err.style.display = 'none';
                status.textContent = '';
                if (!email || !email.includes('@@')) { status.textContent = @Json.Serialize(T["landing.serial.email_invalid"].Value); return; }
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/serial/email', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ toEmail: email, password: serialPassword() })
                    });
                    if (!r.ok) { err.textContent = await serialParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    status.textContent = @Json.Serialize(T["landing.serial.email_sent"].Value);
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            </script>
        }
        else if (Model.KeyStoreMode)
        {
            @* v1.11.22: Lizenzschlüssel-Modus für Ordner-Links — gleiche Logik
               wie File-Landing, aber prompt()-basiertes Passwort (siehe
               Kommentar bei der Seriennummer-Karte oben im File). *@
            <div class="card" id="keystoreCard" style="margin-top:var(--sp-4);background:var(--tw-gray-100)">
                <strong>🔑 @T["landing.keystore.title"]</strong>
                <p class="muted" style="margin:6px 0 0;font-size:.88rem">@T["landing.keystore.lede"]</p>
                <div class="field" style="max-width:340px;margin-top:8px">
                    <label for="keystoreEmailInput">@T["landing.keystore.email_placeholder"]</label>
                    <input type="email" id="keystoreEmailInput" placeholder="name@example.com"/>
                </div>
                <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:8px">
                    <button type="button" class="btn btn-primary btn-sm" style="background:@accent;color:#fff" onclick="keystoreReveal()" id="keystoreRevealBtn">@T["landing.keystore.reveal_button"]</button>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="keystoreSendEmail()" id="keystoreEmailBtn">@T["landing.keystore.email_button"]</button>
                </div>
                <div id="keystoreErrorOut" class="helper" style="display:none;margin-top:var(--sp-3);color:var(--status-critical)"></div>
                <div id="keystoreStatusOut" class="helper" style="display:none;margin-top:var(--sp-3)"></div>
                <div id="keystoreValueOut" style="display:none;margin-top:var(--sp-3)">
                    <div class="muted" id="keystoreTypeOut" style="font-size:.82rem;margin-bottom:2px"></div>
                    <span id="keystoreValueText" class="mono" style="letter-spacing:.08em;font-size:1.05rem;font-weight:600;user-select:all"></span>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="keystoreCopy()" style="margin-left:var(--sp-2)" id="keystoreCopyBtn">@T["landing.serial.copy"]</button>
                    <div id="keystoreValidUntilOut" class="muted" style="font-size:.8rem;margin-top:4px"></div>
                    <div id="keystoreDocOut" style="margin-top:8px"></div>
                </div>
            </div>
            <script>
            let keystorePasswordCache = null;
            function keystorePassword() {
                if (!@Json.Serialize(Model.HasPassword)) return null;
                if (keystorePasswordCache) return keystorePasswordCache;
                keystorePasswordCache = prompt(@Json.Serialize(T["landing.password.label"].Value)) || null;
                return keystorePasswordCache;
            }
            async function keystoreParseError(r) {
                if (r.status === 403) { keystorePasswordCache = null; return @Json.Serialize(T["landing.serial.error_password"].Value); }
                if (r.status === 404) return @Json.Serialize(T["landing.keystore.not_found"].Value);
                if (r.status === 422) return @Json.Serialize(T["landing.keystore.invalid_email"].Value);
                return @Json.Serialize(T["landing.serial.error"].Value);
            }
            function keystoreRenderDoc(url) {
                const out = document.getElementById('keystoreDocOut');
                if (!url) { out.innerHTML = ''; return; }
                const a = document.createElement('a');
                a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer';
                a.className = 'btn btn-ghost btn-sm';
                a.textContent = '📖 ' + @Json.Serialize(T["landing.keystore.doc_link"].Value);
                out.innerHTML = '';
                out.appendChild(a);
            }
            async function keystoreReveal() {
                const email = document.getElementById('keystoreEmailInput').value.trim();
                const err = document.getElementById('keystoreErrorOut');
                const status = document.getElementById('keystoreStatusOut');
                err.style.display = 'none'; status.style.display = 'none';
                if (!email || !email.includes('@@')) { err.textContent = @Json.Serialize(T["landing.keystore.invalid_email"].Value); err.style.display = 'block'; return; }
                const btn = document.getElementById('keystoreRevealBtn');
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/keystore/reveal', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ email, password: keystorePassword() })
                    });
                    if (!r.ok) { err.textContent = await keystoreParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    const d = await r.json();
                    document.getElementById('keystoreTypeOut').textContent = d.keyType;
                    document.getElementById('keystoreValueText').textContent = d.keyValue;
                    document.getElementById('keystoreValidUntilOut').textContent = d.validUntil
                        ? @Json.Serialize(T["landing.keystore.valid_until_prefix"].Value) + ' ' + new Date(d.validUntil).toLocaleDateString()
                        : '';
                    keystoreRenderDoc(d.documentationUrl);
                    document.getElementById('keystoreValueOut').style.display = 'block';
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            async function keystoreCopy() {
                const text = document.getElementById('keystoreValueText').textContent;
                try { await navigator.clipboard.writeText(text); } catch {}
                const btn = document.getElementById('keystoreCopyBtn');
                const original = btn.textContent;
                btn.textContent = @Json.Serialize(T["landing.serial.copied"].Value);
                setTimeout(() => { btn.textContent = original; }, 1500);
            }
            async function keystoreSendEmail() {
                const email = document.getElementById('keystoreEmailInput').value.trim();
                const err = document.getElementById('keystoreErrorOut');
                const status = document.getElementById('keystoreStatusOut');
                err.style.display = 'none'; status.style.display = 'none';
                if (!email || !email.includes('@@')) { err.textContent = @Json.Serialize(T["landing.keystore.invalid_email"].Value); err.style.display = 'block'; return; }
                const btn = document.getElementById('keystoreEmailBtn');
                btn.disabled = true;
                try {
                    const r = await fetch('/api/v1/links/public/@Model.Slug/keystore/email', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ email, password: keystorePassword() })
                    });
                    if (!r.ok) { err.textContent = await keystoreParseError(r); err.style.display = 'block'; btn.disabled = false; return; }
                    status.textContent = @Json.Serialize(T["landing.keystore.email_sent"].Value);
                    status.style.display = 'block';
                    btn.disabled = false;
                } catch { err.textContent = @Json.Serialize(T["landing.serial.error"].Value); err.style.display = 'block'; btn.disabled = false; }
            }
            </script>
        }

        @* v1.10.178: Aufnahmeort-Karte oberhalb des Grids. Nur wenn ≥1 Foto
           GPS-EXIF hat. fitBounds sorgt automatisch für den passenden Zoom
           (NW+SO-Ecke der Fotos = Kartenrand — Marcus's „links, rechts,
           oben, unten"-Regel). Leaflet ist self-hosted unter
           /lib/leaflet/, OSM-Tiles direkt von tile.openstreetmap.org. *@
        @if (Model.IsGallery && Model.GeoPoints is { Count: > 0 })
        {
            <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
            <style>
                .gal-map-card { margin-top:var(--sp-6); border:1px solid #0002; border-radius:12px; overflow:hidden; background:#f6f6f6; }
                .gal-map-head { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; font-size:13px; color:#555; background:#fff; border-bottom:1px solid #0001; }
                .gal-map-head b { color:#222; }
                .gal-map { width:100%; height:340px; }
                .gal-map .leaflet-container { background:#dfe7ef; }
                @@media (max-width:640px) {
                    .gal-map { height:240px; }
                }
                @@media (max-width:480px) {
                    .gal-map-card { display:none; }
                }
            </style>
            <div class="gal-map-card">
                <div class="gal-map-head">
                    <span><b>📍 @T["landing.gallery.map.title"]</b></span>
                    <span class="muted">@string.Format(T["landing.gallery.map.count"].Value, Model.GeoPoints.Count, Model.Files.Count(f => IsImage(f.ContentType)))</span>
                </div>
                <div class="gal-map" id="galMap"></div>
            </div>
            @* v1.10.185: schönere Karten-Optik:
               1. CartoDB Voyager statt OSM-Default — weniger klobig, mehr
                  Farbe, POIs subtiler. Frei nutzbar, kein API-Key.
               2. Photo-Marker als CSS-DivIcon (Kamera-Emoji im runden Chip
                  mit Accent-Farbe + weißem Ring) statt Default-PNG-Pin. *@
            <style>
                .gal-map-pin {
                    width:36px; height:36px; display:flex; align-items:center; justify-content:center;
                    background: linear-gradient(135deg, @accent, @accent);
                    color:#fff; font-size:18px; border-radius:50% 50% 50% 0;
                    transform: rotate(-45deg);
                    box-shadow: 0 4px 10px rgba(0,0,0,.28), 0 0 0 3px #fff;
                    border: 1px solid rgba(0,0,0,.15);
                }
                .gal-map-pin span { transform: rotate(45deg); line-height:1; }
                .gal-map .leaflet-popup-content { margin:8px 12px; font-size:13px; }
                .gal-map .leaflet-container a.leaflet-popup-close-button { color:#666; }
            </style>
            <script src="~/lib/leaflet/leaflet.js"></script>
            <script>
            (function() {
                var pts = @Html.Raw(Json.Serialize(Model.GeoPoints.Select(p => new object[] { p.Lat, p.Lon, p.Name })));
                if (!pts || pts.length === 0) return;
                var map = L.map('galMap', { scrollWheelZoom:false, zoomControl:true }).setView([0,0], 2);
                // v1.10.185: CartoDB Voyager — freundlicher als OSM-Default,
                // Straßen-Farben pastellig, POIs weniger dominant.
                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                    maxZoom: 19,
                    subdomains: 'abcd',
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>'
                }).addTo(map);
                // v1.10.185: Custom Kamera-Marker.
                var photoIcon = L.divIcon({
                    className: 'gal-map-pin-wrap',
                    html: '<div class="gal-map-pin"><span>📷</span></div>',
                    iconSize: [36, 36], iconAnchor: [18, 36], popupAnchor: [0, -32]
                });
                var latlngs = [];
                pts.forEach(function(p) {
                    var m = L.marker([p[0], p[1]], { icon: photoIcon }).addTo(map);
                    if (p[2]) m.bindPopup(String(p[2]).replace(/[<>&"']/g, function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c];}));
                    latlngs.push([p[0], p[1]]);
                });
                if (latlngs.length === 1) {
                    map.setView(latlngs[0], 14);
                } else {
                    // fitBounds mit kleinem Padding, damit die Marker nicht am
                    // Kartenrand kleben. Marcus's Regel: „links, rechts, oben,
                    // unten" — Leaflet berechnet Zoom automatisch aus BBox.
                    map.fitBounds(L.latLngBounds(latlngs), { padding:[24,24], maxZoom: 15 });
                }
            })();
            </script>
        }

        @if (Model.IsGallery)
        {
            @* ── Album-Grid ────────────────────────────────────────────────── *@
            <style>
                .gal-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:8px; margin-top:var(--sp-6); }
                .gal-cell { position:relative; aspect-ratio:1/1; background:#0002; border-radius:8px; overflow:hidden; cursor:pointer; }
                .gal-cell img, .gal-cell video { width:100%; height:100%; object-fit:cover; display:block; background:linear-gradient(135deg,#f0f0f0,#d8d8d8); }
                /* v1.10.170: falls Browser den Content-Type nicht rendert
                   (HEIC in Chrome/Firefox), zeigt der onerror-Handler diesen
                   Fallback. Warme Gradient-Kachel + zentriertes Icon +
                   Dateiname klein. */
                .gal-cell .gal-fallback { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; padding:12px; text-align:center; font-size:11px; color:#fff; background:linear-gradient(135deg,#8aa1c1,#5a7ba8); }
                .gal-cell .gal-fallback .em { font-size:48px; margin-bottom:6px; opacity:.92 }
                /* v1.10.191: Pending-Kachel — Thumb wird gerade im Hintergrund
                   generiert, JS pollt und tauscht ein. Dezente Puls-Animation. */
                .gal-cell .gal-pending { background:linear-gradient(135deg,#9aa8bd,#6d84a6); }
                .gal-spin { animation: galPulse 1.6s ease-in-out infinite; display:inline-block; }
                @@keyframes galPulse { 0%,100% { opacity:.45; transform:scale(.94);} 50% { opacity:1; transform:scale(1.06);} }
                .gal-cell .gal-fallback small { opacity:.75; font-size:10px; margin-top:4px; letter-spacing:.03em; text-transform:uppercase; }
                .gal-cell .gal-play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.15); }
                .gal-cell .gal-play svg { width:56px; height:56px; opacity:.9; }
                .gal-cell .gal-name { position:absolute; left:0; right:0; bottom:0; padding:6px 8px; background:linear-gradient(180deg,transparent,rgba(0,0,0,.72)); color:#fff; font-size:12px; line-height:1.25; }
                .gal-cell .gal-name b { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
                .gal-cell .gal-size { opacity:.85; font-weight:400; }
                .gal-empty { padding:var(--sp-6); text-align:center; color:#888; border:1px dashed #ccc; border-radius:12px; margin-top:var(--sp-6); }
                .gal-lightbox { position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9999; display:none; align-items:center; justify-content:center; }
                .gal-lightbox.open { display:flex; }
                .gal-lightbox .gal-lb-media { max-width:96vw; max-height:88vh; object-fit:contain; }
                .gal-lightbox .gal-lb-close { position:absolute; top:12px; right:16px; background:transparent; color:#fff; border:1px solid #fff5; border-radius:20px; padding:6px 14px; cursor:pointer; font-size:14px; }
                .gal-lightbox .gal-lb-nav { position:absolute; top:50%; transform:translateY(-50%); background:transparent; color:#fff; border:1px solid #fff3; border-radius:50%; width:48px; height:48px; cursor:pointer; font-size:24px; opacity:.6; }
                .gal-lightbox .gal-lb-nav:hover { opacity:1; }
                .gal-lightbox .gal-lb-prev { left:16px; }
                .gal-lightbox .gal-lb-next { right:16px; }
                .gal-lightbox .gal-lb-info { position:absolute; bottom:16px; left:16px; right:16px; color:#eee; text-align:center; font-size:13px; }
                .gal-lightbox .gal-lb-info a { color:#fff; text-decoration:underline; margin-left:12px; }
                .gal-upload { border:2px dashed @accent; border-radius:12px; padding:24px; text-align:center; margin-top:var(--sp-6); background:@(accent + "0d"); }
                .gal-upload.drag { background:@(accent + "22"); }
                .gal-upload input[type=file] { display:none; }
                .gal-upload label.pick { display:inline-block; background:@accent; color:#fff; padding:10px 20px; border-radius:8px; cursor:pointer; font-weight:600; }
                .gal-upload .gal-hint { color:#666; font-size:13px; margin-top:8px; }
                .gal-progress { margin-top:var(--sp-4); }
                .gal-progress-row { display:flex; align-items:center; gap:10px; margin:4px 0; font-size:13px; }
                .gal-progress-row .pbar { flex:1; height:6px; background:#0001; border-radius:3px; overflow:hidden; }
                .gal-progress-row .pbar-fill { height:100%; background:@accent; transition:width .1s linear; }
                .gal-progress-row.err .pbar-fill { background:#dc3545; }
                .gal-progress-row .pname { flex:0 0 40%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
                .gal-progress-row .pstatus { flex:0 0 auto; color:#666; min-width:60px; text-align:right; }
                @@media (max-width:640px) {
                    .gal-grid { grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); }
                    /* v1.10.171: Owner-Avatar auf Mobile kleiner, Hero
                       gedrosselt — sonst frisst Header den halben Screen. */
                    .landing-owner-avatar { width:64px !important; height:64px !important; top:14px !important; right:14px !important; }
                    .landing-card.gallery-on { padding:16px !important; }
                    .landing-card.gallery-on h1 { font-size:1.35rem; }
                }
                @@media (max-width:480px) {
                    .gal-grid { grid-template-columns:repeat(auto-fill,minmax(96px,1fr)); gap:6px; }
                    .landing-owner-avatar { display:none; }
                }
            </style>
            @if (mediaFiles.Count == 0 && !Model.AllowUploads)
            {
                <div class="gal-empty">@T["landing.gallery.empty"]</div>
            }
            else if (mediaFiles.Count > 0)
            {
                @* v1.10.196: Ansichts-Umschalter für Empfänger — Kacheln
                   (Default) / Groß / Liste. Persistiert in localStorage. *@
                <style>
                    .gal-viewswitch { display:flex; gap:4px; justify-content:flex-end; margin-top:var(--sp-5); }
                    .gal-viewswitch button { border:1px solid #0002; background:#fff; border-radius:6px; padding:4px 11px; cursor:pointer; font-size:14px; }
                    .gal-viewswitch button.active { background:@accent; color:#fff; border-color:@accent; }
                    .gal-grid.mode-large { grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); }
                    .gal-grid.mode-list { display:flex; flex-direction:column; gap:6px; }
                    .gal-grid.mode-list .gal-cell { aspect-ratio:auto; display:flex; align-items:center; height:60px; }
                    .gal-grid.mode-list .gal-cell img { width:60px; height:60px; flex:0 0 60px; }
                    .gal-grid.mode-list .gal-cell .gal-fallback,
                    .gal-grid.mode-list .gal-cell .gal-pending { width:60px; height:60px; flex:0 0 60px; padding:4px; }
                    .gal-grid.mode-list .gal-cell .gal-fallback .em { font-size:22px; margin-bottom:0; }
                    .gal-grid.mode-list .gal-cell .gal-fallback div:not(.em),
                    .gal-grid.mode-list .gal-cell .gal-fallback small { display:none; }
                    .gal-grid.mode-list .gal-play { display:none; }
                    .gal-grid.mode-list .gal-cell .gal-name { position:static; background:none; color:#222; flex:1; padding:0 12px; display:flex; justify-content:space-between; align-items:center; gap:12px; }
                    .gal-grid.mode-list .gal-cell .gal-name b { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
                    .gal-grid.mode-list .gal-cell .gal-size { color:#777; flex:0 0 auto; }
                </style>
                <div class="gal-viewswitch" role="group" aria-label="@T["browse.view.label"]">
                    <button type="button" id="galVmGrid" title="@T["browse.view.grid"]" onclick="galSetView('grid')">▦</button>
                    <button type="button" id="galVmLarge" title="@T["browse.view.preview"]" onclick="galSetView('large')">🖼</button>
                    <button type="button" id="galVmList" title="@T["browse.view.list"]" onclick="galSetView('list')">☰</button>
                </div>
                <div class="gal-grid" id="galGrid">
                @foreach (var (f, idx) in mediaFiles.Select((f, i) => (f, i)))
                {
                    var isImg = IsImage(f.ContentType);
                    <div class="gal-cell" data-idx="@idx" data-id="@f.Id" data-name="@f.Name" data-size="@Bytes(f.SizeBytes)" data-ct="@f.ContentType" data-t1600="@(f.Thumb1600 ?? "")" onclick="galOpen(@idx)">
                        @if (canPreview && isImg && f.Thumb400 is not null)
                        {
                            @* v1.10.191: Thumb fertig → direkte SAS-URL, das JPEG
                               kommt ohne App-Beteiligung vom Blob-Storage. Fehler-
                               Kette: SAS abgelaufen → /thumb-Endpoint (302 auf
                               frische SAS) → Kamera-Fallback-Kachel. *@
                            <img loading="lazy" src="@f.Thumb400" alt="@f.Name"
                                 onerror="if(!this.dataset.e){this.dataset.e='1';this.src='/s/@Model.Slug/thumb/@f.Id?size=400'}else{this.replaceWith(Object.assign(document.createElement('div'),{className:'gal-fallback',innerHTML:'<div class=&quot;em&quot;>📷</div><div>'+this.alt.replace(/[&lt;&gt;&amp;]/g,'')+'</div>'}))}" />
                        }
                        else if (canPreview && isImg && !f.ThumbFailed)
                        {
                            @* v1.10.191: Thumb noch nicht generiert — der Worker
                               hat den Job schon in der Queue (Landing enqueued).
                               JS pollt /thumb-status und tauscht die Kachel ein,
                               sobald sie fertig ist. *@
                            <div class="gal-fallback gal-pending" data-pending="@f.Id.ToString("N")">
                                <div class="em gal-spin">⏳</div>
                                <div>@f.Name</div>
                                <small>@T["landing.gallery.thumb_pending"]</small>
                            </div>
                        }
                        else if (canPreview && isImg)
                        {
                            @* Decode endgültig gescheitert — Kamera-Fallback,
                               Klick öffnet weiterhin das Original via Lightbox. *@
                            <div class="gal-fallback"><div class="em">📷</div><div>@f.Name</div></div>
                        }
                        else if (canPreview)
                        {
                            @* Videos: kein Auto-Load des Videos in der Zelle — nur Poster/Placeholder mit Play-Overlay, damit 200 Video-Kacheln nicht 200 Range-Requests feuern. *@
                            <div class="gal-fallback"><div class="em">🎬</div><div>@f.Name</div></div>
                            <div class="gal-play">
                                <svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        }
                        else
                        {
                            <div class="gal-fallback"><div class="em">@(isImg ? "🖼" : "🎬")</div><div>@f.Name</div></div>
                        }
                        <div class="gal-name"><b>@f.Name</b><span class="gal-size">@Bytes(f.SizeBytes)</span></div>
                    </div>
                }
                </div>
            }

            @if (Model.AllowUploads)
            {
                <div class="gal-upload" id="galUploadDrop">
                    <label for="galUploadPick" class="pick">📸 @T["landing.gallery.upload.button"]</label>
                    <input type="file" id="galUploadPick" accept="image/*,video/*" multiple />
                    <div class="gal-hint">@T["landing.gallery.upload.hint"]</div>
                    <div class="gal-progress" id="galUploadProgress"></div>
                </div>
            }

            @if (otherFiles.Count > 0)
            {
                <details style="margin-top:var(--sp-6)">
                    <summary style="cursor:pointer;color:@accent;font-weight:600">@T["landing.gallery.other_files"] (@otherFiles.Count)</summary>
                    <table class="table table-cards-mobile" style="margin-top:var(--sp-3)">
                        <thead><tr><th>@T["file.name"]</th><th>@T["file.size"]</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var f in otherFiles)
                        {
                            <tr>
                                <td data-th="@T["file.name"]">@f.Name</td>
                                <td class="muted" data-th="@T["file.size"]">@Bytes(f.SizeBytes)</td>
                                <td>
                                    <form method="post" asp-controller="Share" asp-action="DownloadFolderFile" asp-route-slug="@Model.Slug" asp-route-fileId="@f.Id" style="display:inline">
                                        @if (Model.HasPassword)
                                        {
                                            <input type="hidden" name="password" id="pw-@f.Id" required/>
                                            <button type="button" onclick="var pw=prompt('@T["landing.password.label"]');if(pw){document.getElementById('pw-@f.Id').value=pw;this.closest('form').submit()}" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;border-color:@accent">@T["landing.download.button"]</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;border-color:@accent">@T["landing.download.button"]</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </details>
            }

            @* Lightbox-Overlay — im DOM einmalig, JS steuert Content. *@
            <div class="gal-lightbox" id="galLB" onclick="if(event.target===this)galClose()">
                <button class="gal-lb-close" onclick="galClose()">✕ @T["landing.gallery.lb.close"]</button>
                <button class="gal-lb-nav gal-lb-prev" onclick="event.stopPropagation();galNav(-1)">‹</button>
                <button class="gal-lb-nav gal-lb-next" onclick="event.stopPropagation();galNav(1)">›</button>
                <div id="galLBSlot" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%"></div>
                <div class="gal-lb-info" id="galLBInfo"></div>
            </div>
        }
        else
        {
            <table class="table table-cards-mobile" style="margin-top:var(--sp-6)">
                <thead><tr><th>@T["file.name"]</th><th>@T["file.size"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var f in Model.Files)
                {
                    <tr>
                        <td data-th="@T["file.name"]">@f.Name</td>
                        <td class="muted" data-th="@T["file.size"]">@Bytes(f.SizeBytes)</td>
                        <td>
                            <form method="post" asp-controller="Share" asp-action="DownloadFolderFile" asp-route-slug="@Model.Slug" asp-route-fileId="@f.Id" style="display:inline">
                                @if (Model.HasPassword)
                                {
                                    <input type="hidden" name="password" id="pw-@f.Id" required/>
                                    <button type="button" onclick="var pw=prompt('@T["landing.password.label"]');if(pw){document.getElementById('pw-@f.Id').value=pw;this.closest('form').submit()}" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;border-color:@accent">@T["landing.download.button"]</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary btn-sm" style="background:@accent;color:#fff;border-color:@accent">@T["landing.download.button"]</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @* v1.10.181: „Alle herunterladen" als ZIP am Ende der Landing.
           Server-Endpoint /s/{slug}/download-all packt alle Ordner-Files in
           ein ZIP + streamt zurück. Password-Handling analog zum Einzel-
           Download: Prompt bei HasPassword, sonst direkter POST. *@
        @if (Model.Files.Any())
        {
            <div style="margin-top:var(--sp-6);padding-top:var(--sp-4);border-top:1px solid var(--tw-gray-200);text-align:center">
                <form method="post" asp-controller="Share" asp-action="DownloadAll" asp-route-slug="@Model.Slug" style="display:inline">
                    @if (Model.HasPassword)
                    {
                        <input type="hidden" name="password" id="pwAll" required/>
                        <button type="button" onclick="var pw=prompt('@T["landing.password.label"]');if(pw){document.getElementById('pwAll').value=pw;this.closest('form').submit()}" class="btn btn-primary" style="background:@accent;color:#fff;border-color:@accent">⬇ @T["landing.gallery.download_all"]</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary" style="background:@accent;color:#fff;border-color:@accent">⬇ @T["landing.gallery.download_all"]</button>
                    }
                </form>
                <div class="muted" style="font-size:.85rem;margin-top:6px">@T["landing.gallery.download_all_hint"]</div>
            </div>
        }
        <p class="landing-meta" style="margin-top:var(--sp-6)">
            @if (!string.IsNullOrWhiteSpace(theme?.FooterText))
            {
                @theme.FooterText
            }
            else
            {
                <text>@T["landing.powered_by"] <strong>NimShare</strong></text>
            }
        </p>
    </div>
</div>
@await Html.PartialAsync("_TimezoneBeacon", Model.Slug)

@if (Model.IsGallery)
{
<script>
// v1.10.167 — Album-Lightbox + Upload-Widget.
// Alles selbstständig, kein CDN. Keyboard-Navigation, Touch-Swipe wäre
// nice-to-have aber später — Marcus wollte erstmal "hübsch für viele Medien".
(function() {
    const slug = @Html.Raw(Json.Serialize(Model.Slug));
    const canPreview = @(canPreview ? "true" : "false");
    const T_download = @Html.Raw(Json.Serialize(T["landing.download.button"].Value));
    const T_open_full = @Html.Raw(Json.Serialize(T["landing.gallery.lb.open_original"].Value));
    const T_thumb_pending = @Html.Raw(Json.Serialize(T["landing.gallery.thumb_pending"].Value));
    const T_pick_again = @Html.Raw(Json.Serialize(T["landing.gallery.upload.button"].Value));
    const T_upl_done = @Html.Raw(Json.Serialize(T["landing.gallery.upload.done"].Value));
    const T_upl_reload = @Html.Raw(Json.Serialize(T["landing.gallery.upload.reload"].Value));
    let lbIdx = -1;
    const cells = Array.from(document.querySelectorAll('#galGrid .gal-cell'));
    window.galOpen = function(i) {
        if (!canPreview) return; // Passwort-Link: keine Preview
        lbIdx = i;
        galRender();
        document.getElementById('galLB').classList.add('open');
        document.body.style.overflow = 'hidden';
    };
    window.galClose = function() {
        document.getElementById('galLB').classList.remove('open');
        document.body.style.overflow = '';
        document.getElementById('galLBSlot').innerHTML = '';
        lbIdx = -1;
    };
    window.galNav = function(delta) {
        if (cells.length === 0) return;
        lbIdx = (lbIdx + delta + cells.length) % cells.length;
        galRender();
    };
    function galRender() {
        const c = cells[lbIdx]; if (!c) return;
        const id = c.dataset.id, name = c.dataset.name, size = c.dataset.size, ct = c.dataset.ct;
        const slot = document.getElementById('galLBSlot');
        slot.innerHTML = '';
        const isImg = (ct || '').startsWith('image/');
        // v1.10.191: Lightbox nutzt die vorab gerenderte 1600er-SAS aus dem
        // data-Attribut (kommt fertig aus der DB-geflaggten Landing oder per
        // Status-Poll). Kein img-src-Retry-Gehämmer mehr — wenn das Thumb
        // noch nicht fertig ist, zeigen wir den Pending-Spinner und der
        // Status-Poll ruft galRender() erneut auf, sobald es da ist.
        if (isImg) {
            const t1600 = c.dataset.t1600;
            if (!t1600) {
                slot.innerHTML = '<div style="color:#fff;text-align:center;padding:48px">'
                    + '<div class="gal-spin" style="font-size:64px">⏳</div>'
                    + '<div style="margin-top:14px">' + escapeHtml(name) + '</div>'
                    + '<small style="opacity:.75">' + escapeHtml(T_thumb_pending) + '</small></div>';
                document.getElementById('galLBInfo').innerHTML =
                    '<b>' + escapeHtml(name) + '</b> · <span style="opacity:.8">⏳ ' + escapeHtml(T_thumb_pending) + '</span>';
                galEnsurePolling();
                return;
            }
            const el = document.createElement('img');
            el.className = 'gal-lb-media';
            el.alt = name;
            // Fallback-Kette: SAS abgelaufen → /thumb-Endpoint (302 auf
            // frische SAS) → /media-Original (Safari kann HEIC nativ) →
            // Fallback-Karte (Chrome/FF können HEIC-Original nicht rendern).
            el.onerror = () => {
                el.onerror = () => {
                    el.onerror = () => {
                        const fb = document.createElement('div');
                        fb.style.cssText = 'color:#fff;text-align:center;padding:48px';
                        fb.innerHTML = '<div class="em" style="font-size:64px">📷</div>'
                            + '<div style="margin-top:12px">' + escapeHtml(name) + '</div>'
                            + '<small style="opacity:.7">' + escapeHtml(T_open_full) + ' ↓</small>';
                        el.replaceWith(fb);
                    };
                    el.src = '/s/' + slug + '/media/' + id;
                };
                el.src = '/s/' + slug + '/thumb/' + id + '?size=1600';
            };
            el.src = t1600;
            slot.appendChild(el);
            document.getElementById('galLBInfo').innerHTML =
                '<b>' + escapeHtml(name) + '</b> · ' + escapeHtml(size) +
                ' <a href="' + t1600 + '" target="_blank" rel="noopener">' + escapeHtml(T_open_full) + '</a>';
        } else {
            const url = '/s/' + slug + '/media/' + id;
            const el = document.createElement('video');
            el.className = 'gal-lb-media';
            el.controls = true;
            // iOS Safari blockt autoplay ohne muted, auch nach User-Click auf die
            // Zelle. Muted+autoplay ist die einzige Kombi, die überall spielt —
            // der User kann den Sound danach jederzeit per Player-Controls
            // wieder anschalten (v1.10.168 post-review).
            el.autoplay = true;
            el.muted = true;
            el.playsInline = true;
            el.src = url;
            slot.appendChild(el);
            document.getElementById('galLBInfo').innerHTML =
                '<b>' + escapeHtml(name) + '</b> · ' + escapeHtml(size) +
                ' <a href="' + url + '" target="_blank" rel="noopener">' + escapeHtml(T_open_full) + '</a>';
        }
    }
    function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]); }

    // ── v1.10.191: Thumb-Status-Polling ───────────────────────────────
    // Solange Kacheln pending sind: alle 4s EIN Request auf /thumb-status
    // (statt N img-Retries). Fertige Thumbs werden live eingetauscht; wenn
    // die Lightbox gerade das betroffene Bild zeigt, wird sie aktualisiert.
    let galPollTimer = null;
    const galPollStart = Date.now();
    function galApplyReady(ready, failed) {
        document.querySelectorAll('[data-pending]').forEach(ph => {
            const key = ph.getAttribute('data-pending');
            const cell = ph.closest('.gal-cell');
            if (!cell) return;
            if (failed && failed.indexOf(key) >= 0) {
                // Decode endgültig gescheitert → Kamera-Fallback statt Spinner.
                const fb = document.createElement('div');
                fb.className = 'gal-fallback';
                fb.innerHTML = '<div class="em">📷</div><div>' + escapeHtml(cell.dataset.name) + '</div>';
                ph.replaceWith(fb);
                return;
            }
            const r = ready[key];
            if (!r) return;
            cell.dataset.t1600 = r.t1600;
            const img = document.createElement('img');
            img.loading = 'lazy';
            img.alt = cell.dataset.name;
            img.onerror = () => { img.onerror = null; img.src = '/s/' + slug + '/thumb/' + cell.dataset.id + '?size=400'; };
            img.src = r.t400;
            ph.replaceWith(img);
            if (lbIdx >= 0 && cells[lbIdx] === cell) galRender();
        });
    }
    async function galPollOnce() {
        try {
            const r = await fetch('/s/' + slug + '/thumb-status');
            if (!r.ok) return;
            const j = await r.json();
            galApplyReady(j.ready || {}, j.failed || []);
            if (!document.querySelector('[data-pending]')) galStopPolling();
        } catch { /* nächster Tick */ }
    }
    function galStopPolling() {
        if (galPollTimer) { clearInterval(galPollTimer); galPollTimer = null; }
    }
    function galEnsurePolling() {
        if (galPollTimer || !canPreview) return;
        galPollTimer = setInterval(() => {
            // Sicherheitsdeckel 15min — kaputte Dateien werden nie fertig,
            // deren Kacheln bleiben beim Platzhalter stehen.
            if (Date.now() - galPollStart > 15 * 60 * 1000) { galStopPolling(); return; }
            galPollOnce();
        }, 4000);
    }
    if (canPreview && document.querySelector('[data-pending]')) galEnsurePolling();

    // ── v1.10.196: Empfänger-Ansichtsumschalter (Kacheln/Groß/Liste) ──
    window.galSetView = function(m) {
        if (!['grid','large','list'].includes(m)) m = 'grid';
        const g = document.getElementById('galGrid');
        if (g) g.classList.remove('mode-large', 'mode-list');
        if (g && m !== 'grid') g.classList.add('mode-' + m);
        [['galVmGrid','grid'],['galVmLarge','large'],['galVmList','list']].forEach(([id, k]) => {
            const b = document.getElementById(id);
            if (b) b.classList.toggle('active', k === m);
        });
        try { localStorage.setItem('nim.landing.viewMode', m); } catch {}
    };
    (function() {
        let m = 'grid';
        try { m = localStorage.getItem('nim.landing.viewMode') || 'grid'; } catch {}
        if (document.getElementById('galGrid')) galSetView(m);
    })();
    document.addEventListener('keydown', e => {
        if (!document.getElementById('galLB').classList.contains('open')) return;
        if (e.key === 'Escape') galClose();
        else if (e.key === 'ArrowRight') galNav(1);
        else if (e.key === 'ArrowLeft') galNav(-1);
    });

    // ── Upload-Widget ─────────────────────────────────────────────────
    const drop = document.getElementById('galUploadDrop');
    const pick = document.getElementById('galUploadPick');
    const prog = document.getElementById('galUploadProgress');
    if (drop && pick && prog) {
        pick.addEventListener('change', () => handleFiles(pick.files));
        ['dragenter','dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('drag'); }));
        ['dragleave','drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('drag'); }));
        drop.addEventListener('drop', e => { if (e.dataTransfer && e.dataTransfer.files) handleFiles(e.dataTransfer.files); });
    }
    // v1.10.168 post-review: Passwort-Prompt bevor der Upload startet, falls
    // der Link password-gated ist. Server verlangt Passwort in init+complete,
    // wenn keine Session-Gate existiert.
    let cachedUploadPassword = null;
    async function ensureUploadPassword() {
        if (!@(Model.HasPassword ? "true" : "false")) return null;
        if (cachedUploadPassword) return cachedUploadPassword;
        const pw = prompt(@Html.Raw(Json.Serialize(T["landing.password.label"].Value)));
        if (!pw) throw new Error('password-required');
        cachedUploadPassword = pw;
        return pw;
    }
    async function handleFiles(files) {
        if (!files || files.length === 0) return;
        try { await ensureUploadPassword(); } catch { return; }
        let uploaded = 0, failed = 0;
        const rows = [];
        for (const file of files) {
            const row = document.createElement('div');
            row.className = 'gal-progress-row';
            row.innerHTML = '<div class="pname" title="' + escapeHtml(file.name) + '">' + escapeHtml(file.name) + '</div>'
                + '<div class="pbar"><div class="pbar-fill" style="width:0%"></div></div>'
                + '<div class="pstatus">0%</div>';
            prog.appendChild(row);
            rows.push({row, file});
        }
        for (const {row, file} of rows) {
            const fill = row.querySelector('.pbar-fill');
            const st = row.querySelector('.pstatus');
            try {
                const initR = await fetch('/s/' + slug + '/gallery-upload/init', {
                    method: 'POST', headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({ name: file.name, sizeBytes: file.size, contentType: file.type || 'application/octet-stream', password: cachedUploadPassword })
                });
                if (!initR.ok) {
                    let msg = 'HTTP ' + initR.status;
                    try { const p = await initR.json(); msg = p.title || p.detail || msg; } catch {}
                    row.classList.add('err'); fill.style.width = '100%'; st.textContent = '✕ ' + msg;
                    failed++; continue;
                }
                const { fileId, uploadUrl } = await initR.json();
                await xhrPut(uploadUrl, file, file.type || 'application/octet-stream', pct => {
                    fill.style.width = pct + '%';
                    st.textContent = Math.round(pct) + '%';
                });
                const cR = await fetch('/s/' + slug + '/gallery-upload/' + fileId + '/complete', {
                    method: 'POST', headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({ password: cachedUploadPassword })
                });
                if (!cR.ok) {
                    let msg = 'HTTP ' + cR.status;
                    try { const p = await cR.json(); msg = p.title || p.detail || msg; } catch {}
                    row.classList.add('err'); st.textContent = '✕ ' + msg; failed++; continue;
                }
                fill.style.width = '100%'; st.textContent = '✓'; uploaded++;
            } catch (e) {
                row.classList.add('err'); st.textContent = '✕ ' + (e && e.message || e); failed++;
            }
        }
        if (uploaded > 0) {
            const done = document.createElement('div');
            done.style.cssText = 'margin-top:12px;padding:10px;background:#0d61;border-radius:8px;color:#fff;text-align:center';
            done.innerHTML = '✓ ' + T_upl_done.replace('{0}', uploaded)
                + ' <a href="" style="color:#fff;text-decoration:underline;margin-left:8px" onclick="location.reload();return false">' + escapeHtml(T_upl_reload) + '</a>';
            prog.appendChild(done);
        }
    }
    function xhrPut(url, blob, contentType, onProgress) {
        return new Promise((resolve, reject) => {
            const x = new XMLHttpRequest();
            x.open('PUT', url);
            x.setRequestHeader('Content-Type', contentType);
            x.setRequestHeader('x-ms-blob-type', 'BlockBlob');
            x.upload.onprogress = e => { if (e.lengthComputable && onProgress) onProgress(e.loaded / e.total * 100); };
            x.onload = () => (x.status >= 200 && x.status < 300) ? resolve(x) : reject(new Error('HTTP ' + x.status));
            x.onerror = () => reject(new Error('CORS/Netzwerk'));
            x.send(blob);
        });
    }
})();
</script>
}
