@model IEnumerable<NimShare.Core.Entities.StorageFile>
@{ ViewData["Title"] = T["dashboard.title"]; Layout = "_AppShell"; }
@{
    var usedBytes = (long)ViewData["UsedBytes"]!;
    var quotaBytes = (long)ViewData["QuotaBytes"]!;
    var pct = quotaBytes > 0 ? Math.Min(100, (double)usedBytes / quotaBytes * 100) : 0;
    string Bytes(long b)
    {
        string[] u = { "B","KB","MB","GB","TB" };
        double v = b; int i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {u[i]}";
    }
}
<div class="workspace-inner">
    @* v1.10.167: KI-Consent-Banner — prominent oben, verschwindet dauerhaft
       sobald der User „Erlauben" klickt (Server persistiert AiConsentedAt).
       „Später" blendet nur lokal aus (LocalStorage). Nur sichtbar bei aktiver
       KI-Instanz (Provider != Disabled) UND noch nicht consented. *@
    <div id="dashAiConsentBanner" class="card" style="display:none;margin-bottom:var(--sp-4);border-left:4px solid var(--tw-accent, #ffc600);background:linear-gradient(135deg, rgba(255,198,0,0.10), rgba(0,40,84,0.05));padding:var(--sp-4) var(--sp-5)">
        <div style="display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap">
            <div style="font-size:2rem;line-height:1">✨</div>
            <div style="flex:1;min-width:240px">
                <div style="font-weight:700;font-size:1.05rem;color:var(--tw-primary)">@T["dashboard.ai_consent.title"]</div>
                <div class="muted" id="dashAiConsentProvider" style="font-size:.85rem;margin-top:2px"></div>
                <div style="margin-top:8px;line-height:1.45">@T["dashboard.ai_consent.hint"]</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
                <button type="button" class="btn btn-ghost btn-sm" onclick="dashAiConsentLater()">@T["dashboard.ai_consent.later"]</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="dashAiConsentAllow(this)">✓ @T["dashboard.ai_consent.allow"]</button>
            </div>
        </div>
    </div>
    <script>
    (async function() {
        try {
            if (localStorage.getItem('ai-consent-banner-dismissed') === '1') return;
            const [pInfo, pCons] = await Promise.allSettled([
                fetch('/api/v1/ai/provider-info', {credentials:'same-origin'}).then(r => r.ok ? r.json() : null),
                fetch('/api/v1/me/ai-consent',    {credentials:'same-origin'}).then(r => r.ok ? r.json() : null),
            ]);
            const info = pInfo.status==='fulfilled' ? pInfo.value : null;
            const cons = pCons.status==='fulfilled' ? pCons.value : null;
            if (!info || !info.enabled) return;      // Instanz ohne KI: kein Banner
            if (cons && cons.consented) return;      // Schon zugestimmt: dauerhaft weg
            const el = document.getElementById('dashAiConsentBanner');
            if (!el) return;
            const p = document.getElementById('dashAiConsentProvider');
            if (p) {
                const model = info.model ? ' · ' + info.model : '';
                const host = info.endpointHint ? ' · ' + info.endpointHint : '';
                p.textContent = info.provider + model + host;
            }
            el.style.display = '';
        } catch {}
    })();
    async function dashAiConsentAllow(btn) {
        btn.disabled = true; btn.textContent = '…';
        try {
            const r = await fetch('/api/v1/me/ai-consent', {
                method:'PUT', credentials:'same-origin',
                headers:{'Content-Type':'application/json'},
                body: JSON.stringify({ consented: true })
            });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            document.getElementById('dashAiConsentBanner').style.display = 'none';
            // Trigger evtl. Greeting-Reload — der Banner ist dauerhaft weg.
        } catch (e) { btn.disabled = false; btn.textContent = '✓'; }
    }
    function dashAiConsentLater() {
        localStorage.setItem('ai-consent-banner-dismissed', '1');
        document.getElementById('dashAiConsentBanner').style.display = 'none';
    }
    </script>
    @* v1.10.138: EINE Begrüssung. Der Header grüsst (Anrede + Name); die KI
       liefert nur die Nachricht darunter (ohne eigene Anrede → keine doppelte
       Begrüssung mehr). Bis der AI-Call zurück ist, steht der statische,
       lokalisierte Standard-Untertitel da. Wetter-Chip daneben. *@
    <div class="page-header">
        <div>
            <h1>@T["dashboard.greeting"], @ViewData["UserName"]</h1>
            <p class="lede">
                <span id="dashLedeText">@T["dashboard.lede"]</span>
                <span id="aiWeather" title="" style="display:none;margin-left:10px;white-space:nowrap;font-weight:600">
                    <span id="aiWeatherEmoji" style="font-size:1.05rem"></span>
                    <span id="aiWeatherTemp" style="margin-left:3px"></span>
                    <span id="aiWeatherRange" class="muted" style="margin-left:6px;font-weight:400;font-size:.85em"></span>
                </span>
            </p>
        </div>
        <a class="btn btn-primary" href="/upload">@T["dashboard.new_upload"]</a>
    </div>

    <div class="row" style="gap:var(--sp-6);align-items:stretch">
        <div class="card" style="flex:1;min-width:220px">
            <div class="muted">@T["dashboard.stat.files"]</div>
            <div style="font-size:1.9rem;font-weight:700;color:var(--tw-primary)">@ViewData["FileCount"]</div>
        </div>
        <div class="card" style="flex:1;min-width:220px">
            <div class="muted">@T["dashboard.stat.links"]</div>
            <div style="font-size:1.9rem;font-weight:700;color:var(--tw-primary)">@ViewData["LinkCount"]</div>
        </div>
        <div class="card" style="flex:2;min-width:280px">
            <div class="muted">@T["dashboard.stat.usage"]</div>
            <div style="font-size:1rem;color:var(--tw-primary);margin-bottom:6px">
                @Bytes(usedBytes) / @Bytes(quotaBytes)
            </div>
            <div style="height:8px;background:var(--tw-gray-200);border-radius:4px;overflow:hidden">
                <div style="height:100%;width:@pct.ToString("0")%;background:var(--pillar-gradient-h)"></div>
            </div>
        </div>
    </div>

    <div class="card" style="margin-top:var(--sp-8)">
        <h2 class="card-title">@T["dashboard.recent_files"]</h2>
        @if (!Model.Any())
        {
            <p class="muted">@T["dashboard.no_files"]</p>
        }
        else
        {
            <table class="table">
                <thead>
                <tr>
                    <th>@T["file.name"]</th>
                    <th>@T["file.size"]</th>
                    <th>@T["file.type"]</th>
                    <th>@T["file.uploaded"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@Bytes(f.SizeBytes)</td>
                        <td class="muted mono">@f.ContentType</td>
                        <td class="muted">@f.CreatedAt.ToString("u")</td>
                        <td>
                            <button type="button" class="btn btn-ghost btn-sm" data-id="@f.Id" data-name="@f.Name" onclick="quickShare(this.dataset.id, this.dataset.name)">@T["file.share"]</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<dialog id="quickShareDlg" style="border:0;border-radius:12px;padding:0;max-width:520px;width:92%"
    data-heading="@T["dashboard.share.heading"]"
    data-title-prefix="@T["dashboard.share.title_prefix"]"
    data-busy="@T["dashboard.share.busy"]"
    data-copy="@T["common.copy"]"
    data-copied="@T["common.copied"]"
    data-manage="@T["dashboard.share.manage"]"
    data-close="@T["common.close"]"
    data-error="@T["common.error"]">
    <div style="padding:20px">
        <h3 style="margin-top:0" id="qsTitle">@T["dashboard.share.heading"]</h3>
        <div id="qsBusy" class="muted">@T["dashboard.share.busy"]</div>
        <div id="qsResult" style="display:none">
            <div class="field">
                <label>@T["dashboard.share.link_label"]</label>
                <input type="text" id="qsUrl" readonly style="font-family:monospace;font-size:13px" onclick="this.select()"/>
            </div>
            <div class="actions" style="gap:8px">
                <button class="btn btn-primary" id="qsCopy">📋 @T["common.copy"]</button>
                <a class="btn" id="qsManage" href="/links">@T["dashboard.share.manage"]</a>
                <button type="button" class="btn btn-ghost" onclick="document.getElementById('quickShareDlg').close()">@T["common.close"]</button>
            </div>
        </div>
        <div id="qsError" style="display:none;color:var(--tw-danger,#c00);margin-top:10px"></div>
    </div>
</dialog>

@section Scripts {
<script>
// v1.10.115: KI-Begrüssung laden. Zuerst ohne Standort (sofort), dann —
// falls der Nutzer Geolocation erlaubt — mit Wetter nachlegen.
(function loadAiGreeting() {
    // v1.10.138: Der Header grüsst bereits (Anrede + Name). Hier nur die
    // KI-NACHRICHT (body, OHNE Anrede) in den Untertitel schreiben — sonst
    // stünde „Hallo …" doppelt. Fällt der AI-Call aus, bleibt der statische
    // lokalisierte Standard-Untertitel stehen.
    const lede = document.getElementById('dashLedeText');
    if (!lede) return;
    async function fetchGreeting(lat, lon) {
        let url = '/api/v1/ai/greeting';
        if (lat != null && lon != null) url += '?lat=' + lat + '&lon=' + lon;
        try {
            const r = await fetch(url, { credentials: 'same-origin' });
            if (!r.ok) return;
            const d = await r.json();
            const msg = d.body || d.greeting;   // body: neue getrennte Nachricht
            if (msg) lede.textContent = msg;
        } catch {}
    }
    // v1.10.122: Wetter-Symbol + heutige Vorhersage neben der Begrüssung.
    async function fetchWeather(lat, lon) {
        try {
            const r = await fetch('/api/v1/ai/weather?lat=' + lat + '&lon=' + lon, { credentials: 'same-origin' });
            if (!r.ok) return;
            const w = await r.json();
            const wrap = document.getElementById('aiWeather');
            document.getElementById('aiWeatherEmoji').textContent = w.emoji || '';
            document.getElementById('aiWeatherTemp').textContent = w.tempC + '°';
            document.getElementById('aiWeatherRange').textContent = '↑' + w.highC + '° ↓' + w.lowC + '°';
            if (wrap) { wrap.title = w.text || ''; wrap.style.display = ''; }
        } catch {}
    }
    fetchGreeting(null, null);
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            p => {
                const lat = p.coords.latitude.toFixed(3), lon = p.coords.longitude.toFixed(3);
                fetchGreeting(lat, lon);
                fetchWeather(lat, lon);
            },
            () => {}, { timeout: 5000, maximumAge: 600000 });
    }
})();
async function quickShare(fileId, name) {
    const dlg = document.getElementById('quickShareDlg');
    const T = dlg.dataset;
    document.getElementById('qsTitle').textContent = T.titlePrefix + name;
    document.getElementById('qsBusy').style.display = '';
    document.getElementById('qsResult').style.display = 'none';
    document.getElementById('qsError').style.display = '';
    document.getElementById('qsError').style.display = 'none';
    dlg.showModal();
    try {
        const r = await fetch('/api/v1/links', {
            method: 'POST', headers: {'Content-Type':'application/json'}, credentials: 'same-origin',
            body: JSON.stringify({ fileId: fileId, notifyOnAccess: false })
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const d = await r.json();
        document.getElementById('qsUrl').value = d.url || (location.origin + '/s/' + d.slug);
        document.getElementById('qsBusy').style.display = 'none';
        document.getElementById('qsResult').style.display = '';
        const cp = document.getElementById('qsCopy');
        cp.textContent = '📋 ' + T.copy;
        cp.onclick = () => { navigator.clipboard.writeText(document.getElementById('qsUrl').value); cp.textContent = '✓ ' + T.copied; };
    } catch (e) {
        document.getElementById('qsBusy').style.display = 'none';
        document.getElementById('qsError').textContent = T.error + ': ' + e.message;
        document.getElementById('qsError').style.display = '';
    }
}
</script>
}
