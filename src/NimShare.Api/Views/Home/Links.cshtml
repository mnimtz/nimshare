@model IEnumerable<NimShare.Core.Entities.ShareLink>
@{
    ViewData["Title"] = T["links.title"];
    Layout = "_AppShell";
    var publicLinks = (List<NimShare.Core.Entities.ShareLink>)(ViewData["PublicLinks"] ?? new List<NimShare.Core.Entities.ShareLink>());
    var groupLinks = (List<NimShare.Core.Entities.ShareLink>)(ViewData["GroupLinks"] ?? new List<NimShare.Core.Entities.ShareLink>());
    var subdomainLinks = (List<NimShare.Core.Entities.ShareLink>)(ViewData["SubdomainLinks"] ?? new List<NimShare.Core.Entities.ShareLink>());
    var subdomainBase = ViewData["SubdomainBase"] as string;
    var uploadLinks = (List<NimShare.Core.Entities.UploadRequestLink>)(ViewData["UploadLinks"] ?? new List<NimShare.Core.Entities.UploadRequestLink>());
    var uploadSubdomainLinks = (List<NimShare.Core.Entities.UploadRequestLink>)(ViewData["UploadSubdomainLinks"] ?? new List<NimShare.Core.Entities.UploadRequestLink>());
    var isAdmin = (bool)(ViewData["IsAdmin"] ?? false);
    var currentUserId = (Guid)(ViewData["CurrentUserId"] ?? Guid.Empty);
    // v1.11.72 — Marcus's Wunsch: Admin-Filter "nur Links dieser Person"
    // oben neben "Neuer Upload". Rein clientseitig (Daten sind eh schon
    // komplett gerendert) — distinct Owner über ALLE Sektionen hinweg,
    // damit auch Gruppen-/Öffentlich-/Subdomain-/Upload-Owner erfasst sind.
    var allOwners = Model.Select(l => l.Owner)
        .Concat(groupLinks.Select(l => l.Owner))
        .Concat(publicLinks.Select(l => l.Owner))
        .Concat(subdomainLinks.Select(l => l.Owner))
        .Concat(uploadLinks.Select(l => l.Owner))
        .Concat(uploadSubdomainLinks.Select(l => l.Owner))
        .Where(o => o != null)
        .GroupBy(o => o!.Id)
        .Select(g => g.First()!)
        .OrderBy(o => o.DisplayName)
        .ToList();
}
<div class="page-header">
    <div>
        <h1>@T["links.title"]</h1>
        <p class="lede">@T["links.lede"]</p>
    </div>
    <div style="display:flex;align-items:center;gap:var(--sp-3)">
        @if (isAdmin && allOwners.Count > 1)
        {
            <select id="ownerFilter" onchange="filterByOwner(this.value)">
                <option value="">👤 @T["links.filter.all_people"]</option>
                @foreach (var o in allOwners)
                {
                    <option value="@o.Id">@o.DisplayName</option>
                }
            </select>
        }
        <a class="btn btn-primary" href="/upload">@T["dashboard.new_upload"]</a>
    </div>
</div>

@* v1.11.50 — Marcus: die Tabellen wirkten mit vielen Aktions-Buttons pro
   Zeile zu voll/breit. Kompakteres Padding + kleinere Schrift, lange
   Slug/Name-Zellen ellipsen (Tooltip zeigt den vollen Wert), Nebenaktionen
   (Kopieren/E-Mail/Notfall/Öffentlich-Toggle) wandern in ein "⋯"-Menü,
   Öffnen/Auswertung/Widerrufen/Löschen bleiben sichtbar. *@
<style>
    .links-table th, .links-table td { padding: 7px 10px; font-size: .92rem; }
    @* v1.11.69 — Marcus: "Spalte Name zeigt Inhalte nicht mehr mittig, alle
       nach oben verrutscht". Root Cause: `td.ellipsis` bekam dieselbe Regel
       wie `.ellipsis-inner`, inkl. `display: inline-block`. Das reißt die
       Zelle aus dem normalen table-cell-Layout — vertical-align auf einem
       inline-block bedeutet dann "relativ zur Zeile", nicht mehr "relativ
       zur Tabellenzeile" wie das ererbte `.table td { vertical-align: middle }`
       aus site.css. Fix: die Kürzung (max-width/overflow/ellipsis/inline-block)
       gehört nur auf `.ellipsis-inner`, die äußere `<td>` bleibt ein normales
       Table-Cell und erbt die mittige Ausrichtung wieder korrekt. *@
    .links-table td.ellipsis { max-width: 260px; }
    .links-table .ellipsis-inner {
        max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        display: inline-block; vertical-align: middle;
    }
    .links-toolbar { margin: 4px 0 8px; max-width: 320px; }
    .links-toolbar input[type="search"] { width: 100%; }
    .action-menu { position: relative; display: inline-block; }
    .action-menu > summary { list-style: none; cursor: pointer; padding: 4px 8px; border-radius: 6px; }
    .action-menu > summary::-webkit-details-marker { display: none; }
    .action-menu > summary:hover { background: var(--tw-gray-100, rgba(0,0,0,.05)); }
    .action-menu[open] > summary { background: var(--tw-gray-100, rgba(0,0,0,.05)); }
    .action-menu-list {
        /* v1.12.14: position:fixed statt absolute — die Tabellen stecken in
           scrollbaren Containern (overflow), die eine absolute Liste am
           Tabellenrand ABSCHNITTEN (Marcus' Screenshot: Menü halb sichtbar,
           nicht bedienbar). Fixed entkommt jedem overflow-Kontext; die
           Koordinaten setzt das Toggle-JS unten (inkl. Flip nach oben am
           Viewport-Rand), bei Scroll/Resize schließt das Menü. */
        position: fixed; z-index: 1000;
        /* v1.12.15: unsichtbar bis das Toggle-JS positioniert hat — das
           details-toggle-Event feuert asynchron, sonst blitzt die Liste
           einen Frame lang an der falschen Stelle auf. */
        visibility: hidden;
        background: var(--surface, #fff); border: 1px solid var(--border-subtle, #ddd);
        border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,.12); padding: 6px;
        display: flex; flex-direction: column; gap: 2px; min-width: 170px;
    }
    .action-menu-list .btn { justify-content: flex-start; width: 100%; }
</style>
<script>
// Close any open action-menu <details> when clicking outside it.
document.addEventListener('click', (e) => {
    document.querySelectorAll('details.action-menu[open]').forEach(d => {
        if (!d.contains(e.target)) d.removeAttribute('open');
    });
});
// v1.12.14/15: Menü beim Öffnen am ⋯-Button positionieren (fixed, s. CSS oben).
// v1.12.15-Fix: Dieser Script-Block läuft VOR den Tabellen — per-Element-
// Binding fand darum NIE ein <details> (Menü landete koordinatenlos am
// Seitenende, Marcus' 2. Screenshot). Jetzt Delegation auf document in der
// CAPTURE-Phase ('toggle' bubbelt nicht, capture fängt es trotzdem) — damit
// ist der Render-Zeitpunkt der Tabellen egal. Die Liste ist per CSS bis zur
// Positionierung unsichtbar ('toggle' feuert asynchron, sonst gäbe es einen
// Frame an der falschen Stelle).
document.addEventListener('toggle', (e) => {
    const d = e.target;
    if (!(d instanceof HTMLElement) || !d.matches('details.action-menu')) return;
    if (!d.open) {
        // Beim Schließen wieder verstecken — sonst blitzt die Liste beim
        // NÄCHSTEN Öffnen einen Frame lang an der alten Position auf.
        const closed = d.querySelector('.action-menu-list');
        if (closed) closed.style.visibility = '';
        return;
    }
    // Immer nur EIN offenes Menü — sonst stapeln sich fixed-Listen.
    document.querySelectorAll('details.action-menu[open]').forEach(o => { if (o !== d) o.removeAttribute('open'); });
    const list = d.querySelector('.action-menu-list');
    const btn = d.querySelector('summary').getBoundingClientRect();
    list.style.left = '0px'; list.style.top = '0px'; // messbar machen
    const mw = list.offsetWidth, mh = list.offsetHeight;
    let left = Math.max(8, Math.min(btn.right - mw, window.innerWidth - mw - 8));
    let top = btn.bottom + 4;
    if (top + mh > window.innerHeight - 8) top = Math.max(8, btn.top - mh - 4); // Flip nach oben
    list.style.left = left + 'px';
    list.style.top = top + 'px';
    list.style.visibility = 'visible';
}, true);
// Fixed-Position würde beim Scrollen am Viewport "kleben" → Menü schließen.
// capture:true, weil Scroll-Events aus inneren Containern nicht bubbeln.
['scroll', 'resize'].forEach(ev => window.addEventListener(ev, () => {
    document.querySelectorAll('details.action-menu[open]').forEach(d => d.removeAttribute('open'));
}, { passive: true, capture: true }));
// Generic per-section search: filters <tr> in the given table by whether
// any cell's text contains the query (case-insensitive). Client-side only —
// the page already renders every row server-side, no extra API round-trip.
// v1.11.72: composes with the admin "Person"-Filter (filterByOwner) below —
// a row needs to pass BOTH to stay visible, tracked via two data-* flags
// so neither filter blindly overwrites the other's hidden rows.
function applyRowVisibility(tr) {
    tr.style.display = (tr.dataset.searchHide === '1' || tr.dataset.ownerHide === '1') ? 'none' : '';
}
function filterLinksTable(inputEl, tableId) {
    const q = inputEl.value.trim().toLowerCase();
    const table = document.getElementById(tableId);
    if (!table) return;
    table.querySelectorAll('tbody > tr').forEach(tr => {
        tr.dataset.searchHide = (!q || tr.textContent.toLowerCase().includes(q)) ? '0' : '1';
        applyRowVisibility(tr);
    });
}
// v1.11.72 — Marcus's Wunsch: Admin-Filter "nur Links dieser Person",
// wirkt über ALLE Sektionen/Tabellen hinweg (jede Zeile trägt data-owner-id).
function filterByOwner(ownerId) {
    document.querySelectorAll('.links-table tbody > tr').forEach(tr => {
        tr.dataset.ownerHide = (!ownerId || tr.dataset.ownerId === ownerId) ? '0' : '1';
        applyRowVisibility(tr);
    });
}
</script>

@* v1.10.61: Umbenannt von "Meine Links" → "🔒 Privat" — semantisch klarer
   nach der Aufteilung. Enthält jetzt NUR Links auf Personal-Scope-Dateien. *@
<h2 style="margin-top:8px">🔒 @T["links.private.section"]</h2>

@if (!Model.Any())
{
    <div class="card"><p class="muted">@T["links.empty"]</p></div>
}
else
{
    <div class="links-toolbar">
        <input type="search" placeholder="@T["links.search.placeholder"]" oninput="filterLinksTable(this, 'tblPrivate')"/>
    </div>
    <table class="table table-cards-mobile links-table" id="tblPrivate">
        <thead>
        <tr>
            <th>@T["links.slug"]</th>
            <th>@T["file.name"]</th>
            <th>@T["links.downloads"]</th>
            <th>@T["links.expires"]</th>
            <th>@T["links.state"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var l in Model)
        {
            var state = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
                : l.ExpiresAt is not null && l.ExpiresAt <= DateTimeOffset.UtcNow
                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.slug"]"><a href="/s/@l.Slug" class="mono">@l.Slug</a></td>
                <td data-th="@T["file.name"]" class="ellipsis">
                    @if (l.File is not null)
                    {
                        <span class="muted">📄</span> <strong class="ellipsis-inner" title="@l.File.Name">@l.File.Name</strong>
                    }
                    else if (l.Folder is not null)
                    {
                        <span class="muted">📁</span> <strong class="ellipsis-inner" title="@l.Folder.Name">@l.Folder.Name</strong>
                    }
                    else if (l.FolderId is not null)
                    {
                        <span class="muted">📁</span> <em class="muted">@T["links.target_gone"]</em>
                    }
                    else { <span class="muted">—</span> }
                </td>
                <td data-th="@T["links.downloads"]">@l.DownloadCount @(l.MaxDownloads is int m ? $" / {m}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @state.Item1">@state.Item2</span></td>
                <td>
                    @if (l.IsPublic)
                    {
                        <span class="chip chip-warn" title="@T["links.public.hint"]">🌐</span>
                    }
                    @* v1.11.2 — Marcus: Reihenfolge der Aktionen soll über alle
                       Sektionen (Privat/Gruppen/Öffentlich/Subdomains) gleich
                       sein: Öffnen, Auswertung, ...Sektionsspezifisches,
                       Widerrufen, Löschen. Nebenaktionen (Kopieren/E-Mail/
                       Notfall/Öffentlich-Toggle) im "⋯"-Menü — v1.11.50. *@
                    <a class="btn btn-secondary btn-sm" href="/s/@l.Slug" target="_blank">↗ @T["links.action.open"]</a>
                    <a class="btn btn-secondary btn-sm" href="/links/@l.Id">📊 @T["links.action.report"]</a>
                    <details class="action-menu">
                        <summary>⋯</summary>
                        <div class="action-menu-list">
                            <button class="btn btn-ghost btn-sm" data-copy="@(Url.RouteUrl(new { controller = "Share", action = "Landing", slug = l.Slug }) ?? $"/s/{l.Slug}")">@T["links.action.copy"]</button>
                            <button class="btn btn-ghost btn-sm" data-email="@l.Id">@T["links.action.email"]</button>
                            @if (l.PasswordHash is null)
                            {
                                <button class="btn btn-ghost btn-sm" data-emergency="@l.Id" title="@T["links.emergency.hint"]">🆘 @T["links.action.emergency"]</button>
                            }
                            @if (isAdmin)
                            {
                                <button class="btn btn-ghost btn-sm" data-toggle-public="@l.Id" data-current="@(l.IsPublic ? "true" : "false")">
                                    @(l.IsPublic ? "🔒 " + @T["links.public.unshare"].Value : "🌐 " + @T["links.public.share"].Value)
                                </button>
                            }
                            @* v1.12.14: Bearbeiten für den OWNER, nicht nur Admin — das
                               isAdmin-Gate war ein Erbe des Admin-only-Ablauf-Prompts
                               (v1.11.72); der PATCH-Endpoint erlaubt Owner ohnehin. *@
                            @if (isAdmin || l.OwnerId == currentUserId)
                            {
                                <button class="btn btn-ghost btn-sm" data-edit-link="@l.Id">✏️ @T["links.action.edit"]</button>
                            }
                        </div>
                    </details>
                    @if (!l.IsRevoked)
                    {
                        <button class="btn btn-ghost btn-sm" data-revoke="@l.Id">@T["links.action.revoke"]</button>
                    }
                    <button class="btn btn-ghost btn-sm" data-delete="@l.Id">@T["links.action.delete"]</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@* v1.11.29 — Marcus's Report: Upload-Anfrage-Links (reverse-share, /u/{slug})
   tauchten auf /links komplett fehlend auf — nur ShareLinks wurden gezeigt.
   Eigene Sektion, gleiche Sichtbarkeit wie "Privat" (eigene + Admin alles). *@
@if (uploadLinks.Any())
{
    <h2 style="margin-top:32px">📤 @T["links.uploads.section"]</h2>
    <p class="muted" style="margin-bottom:8px">@T["links.uploads.lede"]</p>
    <div class="links-toolbar">
        <input type="search" placeholder="@T["links.search.placeholder"]" oninput="filterLinksTable(this, 'tblUploads')"/>
    </div>
    <table class="table table-cards-mobile links-table" id="tblUploads">
        <thead>
            <tr>
                <th>@T["links.slug"]</th>
                <th>@T["links.uploads.target_folder"]</th>
                @if (isAdmin)
                {
                    <th>@T["links.public.by"]</th>
                }
                <th>@T["links.uploads.count"]</th>
                <th>@T["links.expires"]</th>
                <th>@T["links.state"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in uploadLinks)
        {
            var canManageUpload = isAdmin || l.OwnerId == currentUserId;
            var now = DateTimeOffset.UtcNow;
            var uState = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
                : (l.ExpiresAt is not null && l.ExpiresAt <= now) || (l.MaxUploads is not null && l.UploadCount >= l.MaxUploads)
                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.slug"]"><a href="/u/@l.Slug" class="mono" target="_blank">@l.Slug</a></td>
                <td data-th="@T["links.uploads.target_folder"]" class="ellipsis">📁 <span class="ellipsis-inner" title="@l.TargetFolder">@l.TargetFolder</span></td>
                @if (isAdmin)
                {
                    <td class="muted" data-th="@T["links.public.by"]">@l.Owner?.DisplayName</td>
                }
                <td data-th="@T["links.uploads.count"]">@l.UploadCount @(l.MaxUploads is int m5 ? $" / {m5}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @uState.Item1">@uState.Item2</span></td>
                <td>
                    <a class="btn btn-secondary btn-sm" href="/u/@l.Slug" target="_blank">↗ @T["links.action.open"]</a>
                    <button class="btn btn-ghost btn-sm" data-copy="/u/@l.Slug">@T["links.action.copy"]</button>
                    @if (canManageUpload)
                    {
                        <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" data-delete-upload="@l.Id">@T["links.action.delete"]</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@* v1.11.0 — Marcus's Wunsch: eigene Sektion nur für Links mit Subdomain-URL,
   quer zu Privat/Gruppen/Öffentlich, damit man sofort sieht welche Links
   eine wichtig.nimshare.com-Adresse haben. *@
@if (subdomainBase is not null && (subdomainLinks.Any() || uploadSubdomainLinks.Any()))
{
    <h2 style="margin-top:32px">🌐 @T["links.subdomain.section"]</h2>
    <p class="muted" style="margin-bottom:8px">@T["links.subdomain.lede"]</p>
    <div class="links-toolbar">
        <input type="search" placeholder="@T["links.search.placeholder"]" oninput="filterLinksTable(this, 'tblSubdomains')"/>
    </div>
    <table class="table table-cards-mobile links-table" id="tblSubdomains">
        <thead>
            <tr>
                <th>@T["links.subdomain.url"]</th>
                <th>@T["file.name"]</th>
                <th>@T["links.public.by"]</th>
                <th>@T["links.downloads"]</th>
                <th>@T["links.expires"]</th>
                <th>@T["links.state"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @* v1.11.27: Subdomain-Links sind jetzt für ALLE User sichtbar
           (siehe HomeController.Links) — Revoke/Delete bleiben aber weiter
           nur Owner oder Admin vorbehalten, daher der Owner-/Rechte-Check
           pro Zeile statt wie vorher pauschal für alle Zeilen. *@
        @foreach (var l in subdomainLinks)
        {
            var canManage = isAdmin || l.OwnerId == currentUserId;
            var sdHost = $"{l.SubdomainSlug}.{subdomainBase}";
            var sdUrl = $"https://{sdHost}";
            var sdState = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
                : l.ExpiresAt is not null && l.ExpiresAt <= DateTimeOffset.UtcNow
                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.subdomain.url"]"><a href="@sdUrl" class="mono" target="_blank">@sdHost</a></td>
                <td data-th="@T["file.name"]" class="ellipsis">
                    @if (l.File is not null)
                    {
                        <span class="muted">📄</span> <strong class="ellipsis-inner" title="@l.File.Name">@l.File.Name</strong>
                    }
                    else if (l.Folder is not null)
                    {
                        <span class="muted">📁</span> <strong class="ellipsis-inner" title="@l.Folder.Name">@l.Folder.Name</strong>
                    }
                    else if (l.FolderId is not null)
                    {
                        <span class="muted">📁</span> <em class="muted">@T["links.target_gone"]</em>
                    }
                    else { <span class="muted">—</span> }
                </td>
                <td class="muted" data-th="@T["links.public.by"]">@l.Owner?.DisplayName</td>
                <td data-th="@T["links.downloads"]">@l.DownloadCount @(l.MaxDownloads is int m4 ? $" / {m4}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @sdState.Item1">@sdState.Item2</span></td>
                <td>
                    <a class="btn btn-secondary btn-sm" href="@sdUrl" target="_blank">↗ @T["links.action.open"]</a>
                    @* v1.11.35 — Marcus's Wunsch: Auswertung sehen dürfen alle, die den
                       Link auch sehen können — Subdomain-Links sind seit v1.11.27 für
                       alle sichtbar, also auch der Report-Button hier ungated. Revoke/
                       Delete bleiben bewusst bei canManage (keine neue Löschberechtigung). *@
                    <a class="btn btn-secondary btn-sm" href="/links/@l.Id">📊 @T["links.action.report"]</a>
                    <details class="action-menu">
                        <summary>⋯</summary>
                        <div class="action-menu-list">
                            <button class="btn btn-ghost btn-sm" data-copy-abs="@sdUrl">@T["links.action.copy"]</button>
                            @if (l.PasswordHash is null)
                            {
                                <button class="btn btn-ghost btn-sm" data-emergency="@l.Id" title="@T["links.emergency.hint"]">🆘 @T["links.action.emergency"]</button>
                            }
                            @* v1.12.14: Owner-oder-Admin statt admin-only (s. Privat-Tabelle). *@
                            @if (canManage)
                            {
                                <button class="btn btn-ghost btn-sm" data-edit-link="@l.Id">✏️ @T["links.action.edit"]</button>
                            }
                        </div>
                    </details>
                    @if (canManage)
                    {
                        @if (!l.IsRevoked)
                        {
                            <button class="btn btn-ghost btn-sm" data-revoke="@l.Id">@T["links.action.revoke"]</button>
                        }
                        <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" data-delete="@l.Id">@T["links.action.delete"]</button>
                    }
                </td>
            </tr>
        }
        @* v1.11.31: Upload-Anfrage-Links mit Subdomain — gleiche Tabelle,
           anderer Link-Typ (kein File/Folder, kein Report/Revoke-Endpoint,
           nur Delete über /api/v1/upload-requests). *@
        @foreach (var l in uploadSubdomainLinks)
        {
            var canManageU = isAdmin || l.OwnerId == currentUserId;
            var sdHostU = $"{l.SubdomainSlug}.{subdomainBase}";
            var sdUrlU = $"https://{sdHostU}";
            var sdStateU = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
                : (l.ExpiresAt is not null && l.ExpiresAt <= DateTimeOffset.UtcNow) || (l.MaxUploads is not null && l.UploadCount >= l.MaxUploads)
                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.subdomain.url"]"><a href="@sdUrlU" class="mono" target="_blank">@sdHostU</a></td>
                <td data-th="@T["file.name"]" class="ellipsis">📤 <span class="ellipsis-inner" title="@l.TargetFolder">@l.TargetFolder</span></td>
                <td class="muted" data-th="@T["links.public.by"]">@l.Owner?.DisplayName</td>
                <td data-th="@T["links.downloads"]">@l.UploadCount @(l.MaxUploads is int m6 ? $" / {m6}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @sdStateU.Item1">@sdStateU.Item2</span></td>
                <td>
                    <a class="btn btn-secondary btn-sm" href="@sdUrlU" target="_blank">↗ @T["links.action.open"]</a>
                    <button class="btn btn-ghost btn-sm" data-copy-abs="@sdUrlU">@T["links.action.copy"]</button>
                    @if (canManageU)
                    {
                        <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" data-delete-upload="@l.Id">@T["links.action.delete"]</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@* v1.10.61: neue Gruppen-Sektion — Links auf Dateien im Group-Scope.
   Zwischen Privat und Public, weil sie nicht persönlich sind aber auch
   nicht öffentlich für alle. Nur eigene Links; wenn der User keine
   Group-Scope-Links erstellt hat, wird die Sektion nicht angezeigt. *@
@if (groupLinks.Any())
{
    <h2 style="margin-top:32px">👥 @T["links.group.section"]</h2>
    <p class="muted" style="margin-bottom:8px">@T["links.group.lede"]</p>
    <div class="links-toolbar">
        <input type="search" placeholder="@T["links.search.placeholder"]" oninput="filterLinksTable(this, 'tblGroup')"/>
    </div>
    <table class="table table-cards-mobile links-table" id="tblGroup">
        <thead>
            <tr>
                <th>@T["links.slug"]</th>
                <th>@T["file.name"]</th>
                <th>@T["links.downloads"]</th>
                <th>@T["links.expires"]</th>
                <th>@T["links.state"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in groupLinks)
        {
            var gstate = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
                : l.ExpiresAt is not null && l.ExpiresAt <= DateTimeOffset.UtcNow
                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.slug"]"><a href="/s/@l.Slug" class="mono">@l.Slug</a></td>
                <td data-th="@T["file.name"]" class="ellipsis">
                    @if (l.File is not null)
                    {
                        <span class="muted">📄</span> <strong class="ellipsis-inner" title="@l.File.Name">@l.File.Name</strong>
                    }
                    else if (l.Folder is not null)
                    {
                        <span class="muted">📁</span> <strong class="ellipsis-inner" title="@l.Folder.Name">@l.Folder.Name</strong>
                    }
                    else if (l.FolderId is not null)
                    {
                        <span class="muted">📁</span> <em class="muted">@T["links.target_gone"]</em>
                    }
                    else { <span class="muted">—</span> }
                </td>
                <td data-th="@T["links.downloads"]">@l.DownloadCount @(l.MaxDownloads is int m3 ? $" / {m3}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @gstate.Item1">@gstate.Item2</span></td>
                <td>
                    <a class="btn btn-secondary btn-sm" href="/s/@l.Slug" target="_blank">↗ @T["links.action.open"]</a>
                    <a class="btn btn-secondary btn-sm" href="/links/@l.Id">📊 @T["links.action.report"]</a>
                    <details class="action-menu">
                        <summary>⋯</summary>
                        <div class="action-menu-list">
                            <button class="btn btn-ghost btn-sm" data-copy="@(Url.RouteUrl(new { controller = "Share", action = "Landing", slug = l.Slug }) ?? $"/s/{l.Slug}")">@T["links.action.copy"]</button>
                            @if (l.PasswordHash is null)
                            {
                                <button class="btn btn-ghost btn-sm" data-emergency="@l.Id" title="@T["links.emergency.hint"]">🆘 @T["links.action.emergency"]</button>
                            }
                            @* v1.12.14: Owner-oder-Admin statt admin-only (s. Privat-Tabelle) —
                               Gruppen-Links können auch von anderen Mitgliedern stammen. *@
                            @if (isAdmin || l.OwnerId == currentUserId)
                            {
                                <button class="btn btn-ghost btn-sm" data-edit-link="@l.Id">✏️ @T["links.action.edit"]</button>
                            }
                        </div>
                    </details>
                    @if (!l.IsRevoked)
                    {
                        <button class="btn btn-ghost btn-sm" data-revoke="@l.Id">@T["links.action.revoke"]</button>
                    }
                    <button class="btn btn-ghost btn-sm" data-delete="@l.Id">@T["links.action.delete"]</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (publicLinks.Any())
{
    <h2 style="margin-top:32px">🌐 @T["links.public.section"]</h2>
    <p class="muted" style="margin-bottom:8px">@T["links.public.lede"]</p>
    <div class="links-toolbar">
        <input type="search" placeholder="@T["links.search.placeholder"]" oninput="filterLinksTable(this, 'tblPublic')"/>
    </div>
    <table class="table table-cards-mobile links-table" id="tblPublic">
        <thead>
            <tr>
                <th>@T["links.slug"]</th>
                <th>@T["file.name"]</th>
                <th>@T["links.public.by"]</th>
                <th>@T["links.downloads"]</th>
                <th>@T["links.expires"]</th>
                <th>@T["links.state"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in publicLinks)
        {
            var pstate = l.IsRevoked
                ? ("chip-critical", @T["links.revoked"].Value)
