                    ? ("chip-warn", @T["links.expired"].Value)
                    : ("chip-ok", @T["links.active"].Value);
            // v1.11.36 — Marcus's Report: Eigentümer eines öffentlichen Links
            // konnten ihn in der UI nicht selbst löschen/widerrufen, obwohl der
            // Server (LinksController.Delete/Update) das für den Owner längst
            // erlaubt — die UI blendete Revoke/Delete hier fälschlich nur für
            // Admins ein. isAdmin bleibt zusätzlich (v1.10.97: Admin-Moderation).
            var canManagePublic = isAdmin || l.OwnerId == currentUserId;
            <tr data-owner-id="@l.OwnerId">
                <td data-th="@T["links.slug"]"><a href="/s/@l.Slug" class="mono">@l.Slug</a></td>
                <td data-th="@T["file.name"]" class="ellipsis">
                    @if (l.File is not null)
                    {
                        <span class="muted">📄</span> <strong class="ellipsis-inner" title="@l.File.Name">@l.File.Name</strong>
                    }
                    else if (l.Folder is not null)
                    {
                        <span class="muted">📁</span> <strong class="ellipsis-inner" title="@l.Folder.Name">@l.Folder.Name</strong>
                    }
                    else if (l.FolderId is not null)
                    {
                        <span class="muted">📁</span> <em class="muted">@T["links.target_gone"]</em>
                    }
                    else { <span class="muted">—</span> }
                </td>
                <td class="muted" data-th="@T["links.public.by"]">@l.Owner?.DisplayName</td>
                <td data-th="@T["links.downloads"]">@l.DownloadCount @(l.MaxDownloads is int m2 ? $" / {m2}" : "")</td>
                <td class="muted" data-th="@T["links.expires"]">
                    @if (l.IsPermanent) { <span title="@T["links.permanent_label"]">♾️</span> }
                    else { @(l.ExpiresAt?.ToString("u") ?? "—") }
                </td>
                <td data-th="@T["links.state"]"><span class="chip @pstate.Item1">@pstate.Item2</span></td>
                <td>
                    <a class="btn btn-secondary btn-sm" href="/s/@l.Slug" target="_blank">↗ @T["links.action.open"]</a>
                    @* v1.11.35 — Marcus's Wunsch: Auswertung sehen dürfen alle, die den
                       Link sehen können — öffentliche Links sind für alle sichtbar, also
                       auch der Report-Button hier ungated. *@
                    <a class="btn btn-secondary btn-sm" href="/links/@l.Id">📊 @T["links.action.report"]</a>
                    <details class="action-menu">
                        <summary>⋯</summary>
                        <div class="action-menu-list">
                            <button class="btn btn-ghost btn-sm" data-copy="@(Url.RouteUrl(new { controller = "Share", action = "Landing", slug = l.Slug }) ?? $"/s/{l.Slug}")">@T["links.action.copy"]</button>
                            @if (l.PasswordHash is null)
                            {
                                <button class="btn btn-ghost btn-sm" data-emergency="@l.Id" title="@T["links.emergency.hint"]">🆘 @T["links.action.emergency"]</button>
                            }
                            @* v1.12.14: Owner-oder-Admin statt admin-only (s. Privat-Tabelle). *@
                            @if (canManagePublic)
                            {
                                <button class="btn btn-ghost btn-sm" data-edit-link="@l.Id">✏️ @T["links.action.edit"]</button>
                            }
                        </div>
                    </details>
                    @if (canManagePublic)
                    {
                        @if (!l.IsRevoked)
                        {
                            <button class="btn btn-ghost btn-sm" data-revoke="@l.Id">@T["links.action.revoke"]</button>
                        }
                        <button class="btn btn-ghost btn-sm" style="color:var(--status-critical)" data-delete="@l.Id">@T["links.action.delete"]</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<script>
async function api(method, path, body) {
    const r = await fetch(path, {
        method,
        headers: body ? { 'Content-Type': 'application/json' } : {},
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'same-origin'
    });
    return r;
}
document.querySelectorAll('[data-revoke]').forEach(b => {
    b.addEventListener('click', async () => {
        if (!await nimConfirm(@Json.Serialize(T["links.confirm.revoke"].Value), { danger: true })) return;
        const r = await api('PATCH', `/api/v1/links/${b.dataset.revoke}`, { isRevoked: true });
        if (r.ok) location.reload(); else nimAlert('Failed: ' + r.status, { kind: 'error' });
    });
});
document.querySelectorAll('[data-toggle-public]').forEach(b => {
    b.addEventListener('click', async () => {
        const currentlyPublic = b.dataset.current === 'true';
        const r = await api('PATCH', `/api/v1/links/${b.dataset.togglePublic}`, { isPublic: !currentlyPublic });
        if (r.ok) location.reload(); else nimAlert('Failed: ' + r.status, { kind: 'error' });
    });
});
// v1.12.13 — Marcus's Wunsch: vollwertiges „Bearbeiten" pro Link. Löst den
// v1.11.72-Ablauf-Prompt ab (Ablauf/Permanent gehen im Modal auf). Prefill
// per GET /api/v1/links/{id}; gespeichert werden NUR geänderte Felder
// (PATCH-Semantik: null/fehlend = unverändert). Passwort/Seriennummer sind
// tri-state: leer = unverändert, „entfernen"-Haken = löschen, Wert = neu.
let editLinkId = null;
let editLinkInitial = null;
document.querySelectorAll('[data-edit-link]').forEach(b => {
    b.addEventListener('click', () => openEditLink(b.dataset.editLink));
});
function elToLocalInput(iso) {
    const d = new Date(iso);
    const p = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
}
async function openEditLink(id) {
    const r = await api('GET', `/api/v1/links/${id}`);
    if (!r.ok) { nimAlert('Failed: ' + r.status, { kind: 'error' }); return; }
    const d = await r.json();
    editLinkId = id;
    document.getElementById('editLinkHint').textContent = (d.targetName ? d.targetName + ' — ' : '') + '/s/' + d.slug;
    document.getElementById('elPw').value = '';
    document.getElementById('elPw').placeholder = d.hasPassword ? '••••••' : '';
    document.getElementById('elPwRemove').checked = false;
    document.getElementById('elPwRemoveRow').style.display = d.hasPassword ? 'flex' : 'none';
    document.getElementById('elMax').value = d.maxDownloads ?? '';
    const exp = document.getElementById('elExp');
    exp.value = d.expiresAt ? elToLocalInput(d.expiresAt) : '';
    document.getElementById('elPermanent').checked = !!d.isPermanent;
    exp.disabled = !!d.isPermanent;
    document.getElementById('elMsg').value = d.message || '';
    document.getElementById('elNotify').checked = !!d.notifyOnAccess;
    document.getElementById('elAllowed').value = d.allowedEmails || '';
    document.getElementById('elOtp').checked = !!d.requireEmailVerify;
    // v1.12.18: Empfänger-Karte (Schalter statt <details>) — an + aufgeklappt,
    // wenn der Link bereits eine Beschränkung gesetzt hat.
    const restrictActive = !!(d.allowedEmails || d.requireEmailVerify);
    document.getElementById('elRestrictOn').checked = restrictActive;
    document.getElementById('elRestrictBody').style.display = restrictActive ? '' : 'none';
    document.getElementById('elSerial').value = '';
    document.getElementById('elSerial').placeholder = d.hasSerialNumber ? '••••••' : '';
    document.getElementById('elSerialRemove').checked = false;
    document.getElementById('elSerialRemoveRow').style.display = d.hasSerialNumber ? 'flex' : 'none';
    document.getElementById('elKeyStore').checked = !!d.keyStoreMode;
    document.getElementById('elDocEnabled').checked = !!d.documentationEnabled;
    const isFolder = d.targetKind === 'folder';
    document.getElementById('elFolderWrap').style.display = isFolder ? '' : 'none';
    if (isFolder) {
        document.getElementById('elGallery').checked = !!d.displayAsGallery;
        document.getElementById('elGallerySub').style.display = d.displayAsGallery ? '' : 'none';
        document.getElementById('elAllowUploads').checked = !!d.allowUploads;
        document.getElementById('elGpsMap').checked = !!d.showGpsMap;
        document.getElementById('elSubfolders').checked = !!d.includeSubfolders;
        document.getElementById('elDepthWrap').style.display = d.includeSubfolders ? 'flex' : 'none';
        const sel = document.getElementById('elDepth');
        const depth = d.subfolderDepth ?? 0;
        if (![...sel.options].some(o => o.value === String(depth))) {
            const o = document.createElement('option');
            o.value = String(depth); o.textContent = String(depth);
            sel.appendChild(o);
        }
        sel.value = String(depth);
    }
    editLinkInitial = {
        maxDownloads: d.maxDownloads ?? null,
        expiresAt: exp.value,
        isPermanent: !!d.isPermanent,
        message: d.message || '',
        notifyOnAccess: !!d.notifyOnAccess,
        allowedEmails: d.allowedEmails || '',
        requireEmailVerify: !!d.requireEmailVerify,
        keyStoreMode: !!d.keyStoreMode,
        documentationEnabled: !!d.documentationEnabled,
        targetKind: d.targetKind,
        displayAsGallery: !!d.displayAsGallery,
        allowUploads: !!d.allowUploads,
        showGpsMap: !!d.showGpsMap,
        includeSubfolders: !!d.includeSubfolders,
        subfolderDepth: d.subfolderDepth ?? 0,
    };
    document.getElementById('modalEditLink').classList.add('open');
}
function closeEditLink() { document.getElementById('modalEditLink').classList.remove('open'); }
async function saveEditLink() {
    if (!editLinkId || !editLinkInitial) return;
    const init = editLinkInitial;
    const body = {};
    if (document.getElementById('elPwRemove').checked) body.password = '';
    else { const pw = document.getElementById('elPw').value; if (pw) body.password = pw; }
    const perm = document.getElementById('elPermanent').checked;
    const expVal = document.getElementById('elExp').value;
    if (perm !== init.isPermanent) body.isPermanent = perm;
    if (!perm && expVal && expVal !== init.expiresAt) body.expiresAt = new Date(expVal).toISOString();
    const maxRaw = document.getElementById('elMax').value.trim();
    const newMax = maxRaw === '' ? null : parseInt(maxRaw, 10);
    if (newMax !== init.maxDownloads) body.maxDownloads = newMax === null ? 0 : newMax; // 0 = Limit entfernen
    const msg = document.getElementById('elMsg').value;
    if (msg !== init.message) body.message = msg;
    const notify = document.getElementById('elNotify').checked;
    if (notify !== init.notifyOnAccess) body.notifyOnAccess = notify;
    const allowed = document.getElementById('elAllowed').value;
    if (allowed !== init.allowedEmails) body.allowedEmails = allowed;
    const otp = document.getElementById('elOtp').checked;
    if (otp !== init.requireEmailVerify) body.requireEmailVerify = otp;
    if (document.getElementById('elSerialRemove').checked) body.serialNumber = '';
    else { const sn = document.getElementById('elSerial').value.trim(); if (sn) body.serialNumber = sn; }
    const ks = document.getElementById('elKeyStore').checked;
    if (ks !== init.keyStoreMode) body.keyStoreMode = ks;
    const doc = document.getElementById('elDocEnabled').checked;
    if (doc !== init.documentationEnabled) body.documentationEnabled = doc;
    if (init.targetKind === 'folder') {
        const g = document.getElementById('elGallery').checked;
        if (g !== init.displayAsGallery) body.displayAsGallery = g;
        const au = document.getElementById('elAllowUploads').checked;
        if (au !== init.allowUploads) body.allowUploads = au;
        const gps = document.getElementById('elGpsMap').checked;
        if (gps !== init.showGpsMap) body.showGpsMap = gps;
        const sf = document.getElementById('elSubfolders').checked;
        if (sf !== init.includeSubfolders) body.includeSubfolders = sf;
        const depth = parseInt(document.getElementById('elDepth').value, 10);
        if (sf && depth !== init.subfolderDepth) body.subfolderDepth = depth; // 0 = unbegrenzt
    }
    if (Object.keys(body).length === 0) { closeEditLink(); return; }
    const btn = document.getElementById('elSaveBtn');
    btn.disabled = true;
    const r = await api('PATCH', `/api/v1/links/${editLinkId}`, body);
    btn.disabled = false;
    if (r.ok) { location.reload(); return; }
    let m = 'Failed: ' + r.status;
    try { const p = await r.json(); m = p.detail || p.title || m; } catch {}
    nimAlert(m, { kind: 'error' });
}
document.querySelectorAll('[data-delete]').forEach(b => {
    b.addEventListener('click', async () => {
        if (!await nimConfirm(@Json.Serialize(T["links.confirm.delete"].Value), { danger: true })) return;
        const r = await api('DELETE', `/api/v1/links/${b.dataset.delete}`);
        if (r.ok) location.reload(); else nimAlert('Failed: ' + r.status, { kind: 'error' });
    });
});
// v1.11.29: eigener Handler für die neue Uploads-Sektion — anderer API-Pfad
// (/api/v1/upload-requests statt /api/v1/links).
document.querySelectorAll('[data-delete-upload]').forEach(b => {
    b.addEventListener('click', async () => {
        if (!await nimConfirm(@Json.Serialize(T["links.confirm.delete"].Value), { danger: true })) return;
        const r = await api('DELETE', `/api/v1/upload-requests/${b.dataset.deleteUpload}`);
        if (r.ok) location.reload(); else nimAlert('Failed: ' + r.status, { kind: 'error' });
    });
});
document.querySelectorAll('[data-copy-abs]').forEach(b => {
    b.addEventListener('click', async () => {
        const url = b.dataset.copyAbs;
        try { await navigator.clipboard.writeText(url); b.textContent = '✓'; setTimeout(()=>b.textContent=@Json.Serialize(T["links.action.copy"].Value), 1200); }
        catch {
            if (window.nsPrompt) window.nsPrompt('Copy this URL', '', url);
            else prompt('Copy this URL:', url);
        }
    });
});
document.querySelectorAll('[data-copy]').forEach(b => {
    b.addEventListener('click', async () => {
        const url = location.origin + b.dataset.copy;
        try { await navigator.clipboard.writeText(url); b.textContent = '✓'; setTimeout(()=>b.textContent=@Json.Serialize(T["links.action.copy"].Value), 1200); }
        catch {
            // Modern replacement — presents the URL in a proper modal input
            // (selectable, copyable) instead of a native prompt bar.
            if (window.nsPrompt) window.nsPrompt('Copy this URL', '', url);
            else prompt('Copy this URL:', url);
        }
    });
});
document.querySelectorAll('[data-email]').forEach(b => {
    b.addEventListener('click', () => openEmailModal(b.dataset.email));
});
// v1.11.45 — Notfall-Download: Marcus's Idee für Kunden, deren Firmen-Proxy
// nimshare.com blockt (Zscaler etc.). Erzeugt zeitlich befristete Azure-
// Blob-SAS-Direktlinks (48h) pro Datei — bei Ordnern nur oberste Ebene,
// bewusst nur für passwortlose Links (SAS umgeht den Passwortschutz).
document.querySelectorAll('[data-emergency]').forEach(b => {
    b.addEventListener('click', () => openEmergencyModal(b.dataset.emergency));
});
async function openEmergencyModal(linkId) {
    document.getElementById('modalEmergency').classList.add('open');
    document.getElementById('emergencyLoading').style.display = 'block';
    document.getElementById('emergencyError').style.display = 'none';
    const list = document.getElementById('emergencyList');
    list.style.display = 'none';
    list.innerHTML = '';
    const r = await api('POST', `/api/v1/links/${linkId}/emergency-download`);
    document.getElementById('emergencyLoading').style.display = 'none';
    if (!r.ok) {
        let msg = 'Failed: ' + r.status;
        try { const p = await r.json(); if (p.title) msg = p.title; } catch {}
        document.getElementById('emergencyError').textContent = msg;
        document.getElementById('emergencyError').style.display = 'block';
        return;
    }
    const d = await r.json();
    if (!d.files || d.files.length === 0) {
        list.innerHTML = `<p class="muted">${@Json.Serialize(T["links.emergency.empty"].Value)}</p>`;
    } else {
        d.files.forEach(f => {
            const row = document.createElement('div');
            row.className = 'row';
            row.style.cssText = 'justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border-subtle)';
            const nameSpan = document.createElement('span');
            nameSpan.textContent = f.name;
            row.appendChild(nameSpan);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-ghost btn-sm';
            btn.textContent = @Json.Serialize(T["links.action.copy"].Value);
            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(f.url);
                    btn.textContent = '✓';
                    setTimeout(() => btn.textContent = @Json.Serialize(T["links.action.copy"].Value), 1200);
                } catch {
                    if (window.nsPrompt) window.nsPrompt('Copy this URL', '', f.url); else prompt('Copy this URL:', f.url);
                }
            });
            row.appendChild(btn);
            list.appendChild(row);
        });
    }
    list.style.display = 'block';
}
async function openEmailModal(linkId) {
    document.getElementById('emailLinkId').value = linkId;
    document.getElementById('emailTo').value = '';
    document.getElementById('emailMsg').value = '';
    document.getElementById('modalEmail').classList.add('open');
}
async function draftWithAi() {
    const linkId = document.getElementById('emailLinkId').value;
    const btn = document.getElementById('draftBtn');
    btn.disabled = true; btn.textContent = @Json.Serialize(T["links.email.drafting"].Value);
    const r = await fetch('/api/v1/ai/draft-email', {
        method: 'POST', headers: {'Content-Type':'application/json'}, credentials: 'same-origin',
        body: JSON.stringify({ linkId, context: document.getElementById('emailTo').value || null }),
    });
    btn.disabled = false; btn.textContent = @Json.Serialize(T["links.email.draft_ai"].Value);
    if (r.status === 503) { nimAlert(@Json.Serialize(T["links.email.ai_disabled"].Value)); return; }
    if (!r.ok) { nimAlert('Failed: ' + r.status, { kind: 'error' }); return; }
    const d = await r.json();
    document.getElementById('emailMsg').value = d.draft || '';
}
async function sendEmail() {
    const linkId = document.getElementById('emailLinkId').value;
    const to = document.getElementById('emailTo').value;
    const msg = document.getElementById('emailMsg').value;
    if (!to) return;
    const r = await api('POST', `/api/v1/links/${linkId}/send-email`, { toEmail: to, message: msg });
    document.getElementById('modalEmail').classList.remove('open');
    if (r.ok) nimToast(@Json.Serialize(T["links.email.sent"].Value), { kind: 'success' }); else nimAlert('Failed: ' + r.status, { kind: 'error' });
}
</script>

<!-- Send-by-email modal with AI-draft button -->
<div class="modal-backdrop" id="modalEmail" onclick="if(event.target===this)document.getElementById('modalEmail').classList.remove('open')">
    <div class="modal-panel">
        <h2>@T["links.action.email"]</h2>
        <input type="hidden" id="emailLinkId"/>
        <div class="field">
            <label>@T["links.email.to"]</label>
            <input type="email" id="emailTo" required/>
        </div>
        <div class="field">
            <label>@T["links.email.message"]</label>
            <textarea id="emailMsg" rows="6" placeholder="@T["links.email.placeholder"]"></textarea>
        </div>
        <button type="button" id="draftBtn" class="btn btn-ghost" onclick="draftWithAi()">✨ @T["links.email.draft_ai"]</button>
        <div class="actions">
            <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalEmail').classList.remove('open')">@T["modal.cancel"]</button>
            <button type="button" class="btn btn-primary" onclick="sendEmail()">@T["links.email.send"]</button>
        </div>
    </div>
</div>

