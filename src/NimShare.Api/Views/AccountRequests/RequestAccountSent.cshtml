@{
    ViewData["Title"] = T["request_account.sent.title"];
    Layout = "_Layout";
}
<div class="landing-shell">
    <div class="landing-card" style="max-width: 480px;text-align:center">
        <div style="font-size:2.4rem;line-height:1;margin-bottom:var(--sp-4)">✉️</div>
        <h1>@T["request_account.sent.title"]</h1>
        <p class="lede">@T["request_account.sent.body"]</p>
        <a href="/login" class="btn btn-primary" style="margin-top:var(--sp-4)">@T["request_account.back_to_login"]</a>
    </div>
</div>
