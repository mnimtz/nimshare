@model NimShare.Core.Entities.Folder
@{
    var currentUrl = Context.Request.Path.Value ?? "/browse";
}

<!-- New Folder Modal — v1.10.64: async/AJAX statt Form-Submit + Redirect.
     Vorher: Form ging an /browse/folders/create, Server macht Redirect
     zurück. Wenn AntiForgery-Token ausläuft (z.B. Tab lag lange offen)
     oder Server 500 wirft, sah der User keine Rückmeldung — die Seite
     reloadet mit fehlgeschlagenem Create ohne Fehler-Hinweis. Marcus's
     Bug "Anlegen tut nichts". Jetzt: fetch mit Erfolgs-Toast, Fehler-
     Alert bei jedem Non-200. -->
<div class="modal-backdrop" id="modalNewFolder" onclick="if(event.target===this)closeModal('modalNewFolder')">
    <div class="modal-panel">
        <h2>@T["browse.new_folder"]</h2>
        <form id="newFolderForm" onsubmit="return createNewFolder(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="newFolderParentId" name="parentId" value="@Model.Id"/>
            <input type="hidden" name="returnUrl" value="@currentUrl"/>
            <div class="field">
                <label for="newFolderName">@T["browse.folder_name"]</label>
                <input type="text" name="name" id="newFolderName" required maxlength="255" autofocus/>
            </div>
            <div class="actions">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalNewFolder')">@T["modal.cancel"]</button>
                <button type="submit" class="btn btn-primary" id="newFolderSubmitBtn">@T["modal.create"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Rename Folder Modal -->
<div class="modal-backdrop" id="modalRenameFolder" onclick="if(event.target===this)closeModal('modalRenameFolder')">
    <div class="modal-panel">
        <h2>@T["actions.rename"]</h2>
        <form method="post" id="renameForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@currentUrl"/>
            <div class="field">
                <label for="renameName">@T["browse.folder_name"]</label>
                <input type="text" name="name" id="renameName" required maxlength="255"/>
            </div>
            <div class="actions">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalRenameFolder')">@T["modal.cancel"]</button>
                <button type="submit" class="btn btn-primary">@T["modal.save"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Upload Modal (drag-drop stays TODO; simple file picker for now) -->
<div class="modal-backdrop" id="modalUpload" onclick="if(event.target===this)closeModal('modalUpload')">
    <div class="modal-panel">
        <h2>@T["browse.upload"]</h2>
        <div class="field">
            <input type="file" id="uploadPick" multiple/>
        </div>
        <div id="uploadStatus" class="helper"></div>
        <div class="actions">
            <button type="button" class="btn btn-ghost" onclick="closeModal('modalUpload')">@T["modal.close"]</button>
            <button type="button" class="btn btn-primary" onclick="startUpload()">@T["browse.upload"]</button>
        </div>
    </div>
</div>

<!-- Share Link Modal -->
<div class="modal-backdrop" id="modalShare" onclick="if(event.target===this)closeModal('modalShare')">
    <div class="modal-panel">
        <h2>@T["modal.share.title"]</h2>
        <p class="muted" id="shareTargetHint"></p>
        <div class="field">
            <label>@T["upload.slug"]</label>
            <input type="text" id="shareSlug" placeholder="project-x" autocomplete="off" spellcheck="false"
                   oninput="slugLiveCheck('shareSlug', 'shareSlugStatus')"/>
            <div class="helper">@T["upload.slug_helper"]</div>
            <div id="shareSlugStatus" class="slug-status" style="margin-top:6px;font-size:.85rem;min-height:1.2em"></div>
        </div>
        @* v1.11.0: Subdomain-Freigabe — Sektion wird nur eingeblendet, wenn
           /api/v1/links/subdomain-info enabled && canUse liefert (einmal pro
           Seite gecacht). Live-Check analog slugLiveCheck, aber gegen
           subdomain-check und mit voller FQDN-Vorschau. *@
        <div class="field" id="shareSubdomainWrap" style="display:none">
            <label style="display:flex;align-items:center;gap:8px;font-weight:400;cursor:pointer">
                <input type="checkbox" id="shareSubdomainOn" onchange="onSubdomainToggle('share')"/>
                <span>🌐 @T["share.subdomain.enable"]</span>
            </label>
            <div id="shareSubdomainFieldWrap" style="display:none;margin-top:8px">
                <label for="shareSubdomainSlug" style="font-size:.85rem">@T["share.subdomain.field_label"]</label>
                <input type="text" id="shareSubdomainSlug" autocomplete="off" spellcheck="false"
                       oninput="subdomainLiveCheck('shareSubdomainSlug', 'shareSubdomainStatus')"/>
                <div id="shareSubdomainStatus" class="slug-status" style="margin-top:6px;font-size:.85rem;min-height:1.2em"></div>
            </div>
        </div>
        @* v1.11.24: bewusst nur 2 Spalten statt 3 (Passwort/Max/Ablauf) —
           3× flex:1 in einer Reihe wrappte je nach Modal-Breite unterschiedlich,
           sodass "Ablaufdatum" mal allein auf voller Breite "ausriss". Fest
           2-spaltig + Ablaufdatum als eigene Zeile ist deterministisch und
           bricht nie mehr unvorhersehbar um. *@
        <div class="row" style="gap:var(--sp-4);flex-wrap:wrap">
            <div class="field" style="flex:1;min-width:180px">
                <label>@T["upload.password"]</label>
                <input type="text" id="sharePw"/>
            </div>
            <div class="field" style="flex:1;min-width:180px">
                <label>@T["upload.max_downloads"]</label>
                <input type="number" id="shareMax" min="1"/>
            </div>
        </div>
        <div class="field">
            <label>@T["upload.expires_at"]</label>
            <input type="datetime-local" id="shareExp"/>
            <div class="helper">@T["links.expiry_default_hint"]</div>
            <label style="font-weight:400;display:flex;align-items:center;gap:8px;margin-top:6px;cursor:pointer">
                <input type="checkbox" id="sharePermanent" onchange="onPermanentToggle('share')"/>
                <span>♾️ @T["links.permanent_label"]</span>
            </label>
        </div>
        <div class="field">
            <label>@T["upload.message"]</label>
            <textarea id="shareMsg" rows="2" placeholder="@T["upload.message_placeholder"]"></textarea>
        </div>
        <label style="font-weight:400"><input type="checkbox" id="shareNotify"/> @T["upload.notify_me"]</label>

        <details style="margin-top:10px;border:1px solid var(--tw-gray-200);border-radius:6px;padding:8px 10px">
            <summary style="cursor:pointer;font-weight:500">🔒 @T["links.restrict.legend"]</summary>
            <div class="field" style="margin-top:8px">
                <label>@T["links.restrict.allowed_label"]</label>
                <input type="text" id="shareAllowedEmails" placeholder="alice@@acme.com, @@tungstenautomation.com, *.gmail.com"/>
                <div class="helper">@Html.Raw(@T["links.restrict.allowed_hint"].Value)</div>
            </div>
            <label style="font-weight:400"><input type="checkbox" id="shareOtp"/> @T["links.restrict.otp_label"]</label>
        </details>
        @* v1.11.18: Optionale Seriennummer/Lizenzcode — z.B. bei Software-
           Downloads. Wird verschlüsselt gespeichert, auf der Landing nur
           nach Klick + optional per E-Mail zugesendet.
           v1.11.22: Alternative — „Lizenzschlüssel"-Modus zieht den Key
           automatisch aus dem Key-Store anhand der Besucher-Email; beide
           Modi schließen sich gegenseitig aus (Server enforced das auch). *@
        <details style="margin-top:10px;border:1px solid var(--tw-gray-200);border-radius:6px;padding:8px 10px">
            <summary style="cursor:pointer;font-weight:500">🔑 @T["share.serial.legend"]</summary>
            <div class="field" style="margin-top:8px" id="shareSerialFieldWrap">
                <label>@T["share.serial.label"]</label>
                <input type="text" id="shareSerialNumber" autocomplete="off" placeholder="XXXX-XXXX-XXXX-XXXX"/>
                <div class="helper">@T["share.serial.hint"]</div>
            </div>
            <label style="font-weight:400;display:block;margin-top:10px"><input type="checkbox" id="shareKeyStoreMode" onchange="onShareKeyStoreModeChange()"/> @T["share.keystore.mode_label"]</label>
            <div class="helper" style="margin-top:2px">@T["share.keystore.mode_hint"]</div>
            @* v1.11.44: Marcus's Wunsch — kein fester hartkodierter Doku-Link
               mehr. Die Checkbox ist jetzt ein reines Ein/Aus für die
               flexiblen Key-Store-Dokumente (PDFs/Links, verwaltet unter
               Lizenzverwaltung → Dokumentation, passend zum jeweiligen
               Key-Typ). Kein URL-Feld mehr nötig. *@
            <div class="field" id="shareDocUrlWrap" style="display:none;margin-top:8px">
                <label style="font-weight:400;display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" id="shareDocUrlEnabled"/>
                    <span>@T["share.keystore.doc_url_label"]</span>
                </label>
                <div class="helper">@T["share.keystore.doc_url_hint"]</div>
            </div>
        </details>
        @* v1.10.146: Absender-Zertifikat-Picker (lädt eigene Zertifikate). *@
        <div class="field" style="margin-top:10px">
            <label>@T["share.cert.picker_label"]</label>
            <select id="shareCert"><option value="">@T["share.cert.picker_none"]</option></select>
            <div class="helper">@T["share.cert.picker_hint"]</div>
        </div>
        @* v1.10.167: Zwei Optionen für Ordner-Links: (1) „Als Foto/Video-Album
           anzeigen" — Landing rendert Grid+Lightbox statt Datei-Liste.
           (2) Sub-Toggle „Upload erlauben" — nur sichtbar wenn Option 1 aktiv
           ODER der Zielordner selbst Kind=Gallery ist. Server enforced beides. *@
        <div class="field" id="shareGalleryWrap" style="display:none;margin-top:10px;padding:12px 14px;background:rgba(0,40,84,0.05);border-radius:8px">
            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:400;cursor:pointer">
                <input type="checkbox" id="shareDisplayAsGallery" style="margin-top:4px" onchange="onShareDisplayGalleryChange()"/>
                <span>
                    <div style="font-weight:600">🖼 @T["share.gallery.display_label"]</div>
                    <div class="muted" style="font-size:.88rem;margin-top:2px">@T["share.gallery.display_hint"]</div>
                </span>
            </label>
            <label id="shareAllowUploadsRow" style="display:none;gap:8px;align-items:flex-start;font-weight:400;cursor:pointer;margin-top:10px;padding-left:26px;border-left:2px solid rgba(0,40,84,0.15)">
                <input type="checkbox" id="shareAllowUploads" style="margin-top:4px"/>
                <span>
                    <div style="font-weight:600">↑ @T["share.gallery.allow_uploads_label"]</div>
                    <div class="muted" style="font-size:.88rem;margin-top:2px">@T["share.gallery.allow_uploads_hint"]</div>
                </span>
            </label>
            @* v1.10.196: GPS-Karte pro Link an/aus. Default an — die Landing
               zeigt die Aufnahmeort-Karte nur, wenn Fotos GPS-EXIF haben UND
               dieser Toggle aktiv ist. *@
            <label id="shareGpsMapRow" style="display:none;gap:8px;align-items:flex-start;font-weight:400;cursor:pointer;margin-top:10px;padding-left:26px;border-left:2px solid rgba(0,40,84,0.15)">
                <input type="checkbox" id="shareShowGpsMap" checked style="margin-top:4px"/>
                <span>
                    <div style="font-weight:600">📍 @T["share.gallery.gps_map_label"]</div>
                    <div class="muted" style="font-size:.88rem;margin-top:2px">@T["share.gallery.gps_map_hint"]</div>
                </span>
            </label>
        </div>
        @* v1.12: KI-Auto-Branding pro Link — Kunden-Domain eingeben, KI zieht
           Logo/Firmenname/Akzentfarbe und personalisiert die Landing. Optional;
           nichts gesetzt = unverändertes Standard-Branding. *@
        <details style="margin-top:10px;border:1px solid var(--tw-gray-200);border-radius:6px;padding:8px 10px">
            <summary style="cursor:pointer;font-weight:600">✨ @T["share.branding.summary"]</summary>
            <div class="field" style="margin-top:8px">
                <label for="shareBrandDomain">@T["share.branding.domain_label"]</label>
                <div style="display:flex;gap:8px">
                    <input type="text" id="shareBrandDomain" placeholder="acme.com" autocomplete="off" spellcheck="false" style="flex:1"/>
                    <button type="button" id="shareBrandBtn" onclick="previewBranding()">@T["share.branding.preview_btn"]</button>
                </div>
                <div class="helper">@T["share.branding.hint"]</div>
            </div>
            <div id="shareBrandPreview" style="display:none;margin-top:10px;padding:12px;border-radius:8px;background:rgba(0,40,84,0.04);border:1px solid var(--tw-gray-200)">
                <div style="display:flex;align-items:center;gap:12px">
                    <img id="shareBrandLogo" alt="" style="max-height:40px;max-width:120px;display:none"/>
                    <div style="min-width:0">
                        <div id="shareBrandTitle" style="font-weight:700"></div>
                        <div id="shareBrandSubtitle" class="muted" style="font-size:.88rem"></div>
                    </div>
                    <span id="shareBrandSwatch" title="Akzentfarbe" style="margin-left:auto;flex:none;width:22px;height:22px;border-radius:50%;border:1px solid var(--tw-gray-300)"></span>
                </div>
                <label style="font-weight:400;display:flex;align-items:center;gap:8px;margin-top:10px;cursor:pointer">
                    <input type="checkbox" id="shareBrandApply" checked/> @T["share.branding.apply_label"]
                </label>
            </div>
        </details>
        <div id="shareResult" style="display:none">
            <div class="modal-result">
                <input id="shareUrl" readonly/>
                <button class="btn btn-ghost" onclick="copyShareUrl()">📋</button>
            </div>
            @* v1.11.0: Zusätzliche Subdomain-URL, wenn der Link eine hat. *@
            <div id="shareSubdomainResult" style="display:none;margin-top:8px">
                <label style="font-size:.85rem">🌐 @T["share.subdomain.link_label"]</label>
                <div class="modal-result">
                    <input id="shareSubdomainUrl" readonly/>
                    <button class="btn btn-ghost" onclick="copySubdomainResultUrl('shareSubdomainUrl')">📋</button>
                </div>
            </div>
        </div>
        <div class="actions">
            <button type="button" class="btn btn-ghost" onclick="closeModal('modalShare')">@T["modal.close"]</button>
            <button type="button" class="btn btn-primary" onclick="createShareLink()">@T["modal.create_link"]</button>
        </div>
    </div>
</div>

<!-- Upload Request Modal -->
<div class="modal-backdrop" id="modalUploadReq" onclick="if(event.target===this)closeModal('modalUploadReq')">
    <div class="modal-panel">
        <h2>@T["modal.upload_request.title"]</h2>
        <p class="muted">@T["modal.upload_request.lede"]</p>
        <div class="field">
            <label>@T["upload.slug"]</label>
            <input type="text" id="urSlug" autocomplete="off" spellcheck="false"
                   oninput="slugLiveCheck('urSlug', 'urSlugStatus')"/>
            <div id="urSlugStatus" class="slug-status" style="margin-top:6px;font-size:.85rem;min-height:1.2em"></div>
        </div>
        @* v1.11.0: Subdomain-Sektion — identisch zum Share-Modal. *@
        <div class="field" id="urSubdomainWrap" style="display:none">
            <label style="display:flex;align-items:center;gap:8px;font-weight:400;cursor:pointer">
                <input type="checkbox" id="urSubdomainOn" onchange="onSubdomainToggle('ur')"/>
                <span>🌐 @T["share.subdomain.enable"]</span>
            </label>
            <div id="urSubdomainFieldWrap" style="display:none;margin-top:8px">
                <label for="urSubdomainSlug" style="font-size:.85rem">@T["share.subdomain.field_label"]</label>
                <input type="text" id="urSubdomainSlug" autocomplete="off" spellcheck="false"
                       oninput="subdomainLiveCheck('urSubdomainSlug', 'urSubdomainStatus')"/>
                <div id="urSubdomainStatus" class="slug-status" style="margin-top:6px;font-size:.85rem;min-height:1.2em"></div>
            </div>
        </div>
        @* v1.11.24: siehe Share-Modal — deterministisch 2-spaltig statt 3×
           flex:1 (das "Ablaufdatum" riss sonst je nach Breite mal allein aus). *@
        <div class="row" style="gap:var(--sp-4);flex-wrap:wrap">
            <div class="field" style="flex:1;min-width:180px">
                <label>@T["upload.password"]</label>
                <input type="text" id="urPw"/>
            </div>
            <div class="field" style="flex:1;min-width:180px">
                <label>@T["modal.upload_request.max_uploads"]</label>
                <input type="number" id="urMax" min="1"/>
            </div>
        </div>
        <div class="field">
            <label>@T["upload.expires_at"]</label>
            <input type="datetime-local" id="urExp"/>
            <div class="helper">@T["links.expiry_default_hint"]</div>
            <label style="font-weight:400;display:flex;align-items:center;gap:8px;margin-top:6px;cursor:pointer">
                <input type="checkbox" id="urPermanent" onchange="onPermanentToggle('ur')"/>
                <span>♾️ @T["links.permanent_label"]</span>
            </label>
        </div>
        <div class="field">
            <label>@T["upload.message"]</label>
            <textarea id="urMsg" rows="2"></textarea>
        </div>
        @* v1.11.28: Uploads landen zusätzlich in einem yyyy-MM-dd-Unterordner
           unter dem Zielordner — Default an, damit man später leichter findet
           was wann reinkam. *@
        <label style="font-weight:400;display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="urDateSubfolders" checked/>
            <span>@T["upload.date_subfolders_label"]</span>
        </label>
        <div class="helper" style="margin-top:2px">@T["upload.date_subfolders_hint"]</div>
        @* v1.10.146: Absender-Zertifikat auch für Upload-Anfragen. *@
        <div class="field">
            <label>@T["share.cert.picker_label"]</label>
            <select id="urCert"><option value="">@T["share.cert.picker_none"]</option></select>
            <div class="helper">@T["share.cert.picker_hint"]</div>
        </div>
        <div id="urResult" style="display:none">
            <div class="modal-result">
                <input id="urUrl" readonly/>
                <button class="btn btn-ghost" onclick="copyUploadReqUrl()">📋</button>
            </div>
            @* v1.11.0: Zusätzliche Subdomain-URL, wenn die Anfrage eine hat. *@
            <div id="urSubdomainResult" style="display:none;margin-top:8px">
                <label style="font-size:.85rem">🌐 @T["share.subdomain.link_label"]</label>
                <div class="modal-result">
                    <input id="urSubdomainUrl" readonly/>
                    <button class="btn btn-ghost" onclick="copySubdomainResultUrl('urSubdomainUrl')">📋</button>
                </div>
            </div>
        </div>
        <div class="actions">
            <button type="button" class="btn btn-ghost" onclick="closeModal('modalUploadReq')">@T["modal.close"]</button>
            <button type="button" class="btn btn-primary" onclick="createUploadRequest()">@T["modal.create_link"]</button>
        </div>
    </div>
</div>

<script>
let currentShareTarget = { type: null, id: null };
let currentUploadReqFolder = null;

// v1.10.41: Live-Slug-Check. Debounce 400ms pro Feld — jeder Keystroke
// verwirft den vorherigen Timer. Ergebnis:
//   ✓ grün "verfügbar" wenn frei
//   ⚠ gelb "wird bereinigt zu 'foo-bar'" bei "Foo Bar" (auto-normalise)
//   ✕ rot "belegt — Vorschläge: [foo-2] [foo-3] ..." bei Kollision
// Klick auf einen Vorschlag übernimmt ihn ins Input.
const _slugCheckTimers = {};
function slugLiveCheck(inputId, statusId) {
    if (_slugCheckTimers[inputId]) clearTimeout(_slugCheckTimers[inputId]);
    const input = document.getElementById(inputId);
    const status = document.getElementById(statusId);
    if (!input || !status) return;
    const val = input.value.trim();
    if (!val) { status.textContent = ''; status.className = 'slug-status'; return; }
    _slugCheckTimers[inputId] = setTimeout(async () => {
        try {
            const r = await fetch('/api/v1/links/slug-check?slug=' + encodeURIComponent(val),
                { credentials: 'same-origin' });
            if (!r.ok) { status.textContent = ''; return; }
            const d = await r.json();
            status.className = 'slug-status';
            if (d.available) {
                if (d.normalised !== val) {
                    // Server hätte den Wert bereinigt (z.B. "Foo Bar" → "foo-bar"),
                    // wir zeigen was tatsächlich gespeichert würde.
                    status.style.color = '#a68000';
                    status.innerHTML = '⚠ ' +
                        @Json.Serialize(T["slug.normalised_prefix"].Value) +
                        ' <code>' + escapeHtmlSlug(d.normalised) + '</code>';
                } else {
                    status.style.color = 'var(--status-ok, #2a7f2a)';
                    status.textContent = '✓ ' + @Json.Serialize(T["slug.available"].Value);
                }
            } else if (d.reason === 'invalid') {
                status.style.color = 'var(--status-critical, #c33)';
                status.textContent = '✕ ' + @Json.Serialize(T["slug.invalid"].Value);
            } else if (d.reason === 'taken') {
                status.style.color = 'var(--status-critical, #c33)';
                const label = @Json.Serialize(T["slug.taken"].Value);
                let html = '✕ ' + label;
                if (Array.isArray(d.suggestions) && d.suggestions.length > 0) {
                    html += ' — ' + @Json.Serialize(T["slug.suggestions"].Value) + ' ';
                    html += d.suggestions.map(s =>
                        '<a href="#" onclick="return applySlug(\'' + inputId + '\',\'' + statusId +
                        '\',\'' + escapeHtmlSlug(s).replace(/'/g,'&#39;') + '\')" ' +
                        'style="display:inline-block;background:var(--tw-gray-100);padding:1px 8px;border-radius:4px;margin:0 2px;text-decoration:none">' +
                        escapeHtmlSlug(s) + '</a>'
                    ).join('');
                }
                status.innerHTML = html;
            } else {
                status.textContent = '';
            }
        } catch { status.textContent = ''; }
    }, 400);
}
function applySlug(inputId, statusId, s) {
    const input = document.getElementById(inputId);
    if (input) {
        input.value = s;
        input.focus();
        slugLiveCheck(inputId, statusId);
    }
    return false;
}
function escapeHtmlSlug(s) {
    return String(s || '').replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c]));
}

// ── v1.11.0: Subdomain-Sharing ──────────────────────────────────────
// Einmal pro Seiten-Load geladen (Feature-Toggle + Basis-Domain ändern
// sich nicht während der Session) und für beide Modals (Share + Upload-
// Request) geteilt.
let _subdomainInfoPromise = null;
function ensureSubdomainInfoLoaded() {
    if (!_subdomainInfoPromise) {
        _subdomainInfoPromise = fetch('/api/v1/links/subdomain-info', { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : { enabled: false, canUse: false, baseDomain: null })
            .catch(() => ({ enabled: false, canUse: false, baseDomain: null }));
    }
    return _subdomainInfoPromise;
}
// Blendet die Subdomain-Sektion im gegebenen Modal ein/aus (Prefix 'share' oder 'ur').
async function applySubdomainVisibility(prefix) {
    const info = await ensureSubdomainInfoLoaded();
    const wrap = document.getElementById(prefix + 'SubdomainWrap');
    if (!wrap) return;
    wrap.style.display = (info.enabled && info.canUse) ? '' : 'none';
    wrap.dataset.baseDomain = info.baseDomain || '';
}
function onSubdomainToggle(prefix) {
    const on = document.getElementById(prefix + 'SubdomainOn')?.checked;
    const fieldWrap = document.getElementById(prefix + 'SubdomainFieldWrap');
    if (fieldWrap) fieldWrap.style.display = on ? '' : 'none';
    if (!on) {
        const input = document.getElementById(prefix + 'SubdomainSlug');
        const status = document.getElementById(prefix + 'SubdomainStatus');
        if (input) input.value = '';
        if (status) { status.textContent = ''; status.className = 'slug-status'; }
    }
}
const _subdomainCheckTimers = {};
function subdomainLiveCheck(inputId, statusId) {
    if (_subdomainCheckTimers[inputId]) clearTimeout(_subdomainCheckTimers[inputId]);
    const input = document.getElementById(inputId);
    const status = document.getElementById(statusId);
    if (!input || !status) return;
    const val = input.value.trim().toLowerCase();
    if (!val) { status.textContent = ''; status.className = 'slug-status'; return; }
    _subdomainCheckTimers[inputId] = setTimeout(async () => {
        try {
            const r = await fetch('/api/v1/links/subdomain-check?slug=' + encodeURIComponent(val),
                { credentials: 'same-origin' });
            if (!r.ok) { status.textContent = ''; return; }
            const d = await r.json();
            const wrap = input.closest('.field');
            const baseDomain = wrap ? wrap.dataset.baseDomain : '';
            status.className = 'slug-status';
            if (d.available) {
                status.style.color = 'var(--status-ok, #2a7f2a)';
                status.textContent = '✓ ' + d.normalised + (baseDomain ? '.' + baseDomain : '');
            } else {
                status.style.color = 'var(--status-critical, #c33)';
                const reasonKey = d.reason === 'taken' ? @Json.Serialize(T["share.subdomain.taken"].Value)
                    : d.reason === 'reserved' ? @Json.Serialize(T["share.subdomain.reserved"].Value)
                    : @Json.Serialize(T["share.subdomain.invalid"].Value);
                status.textContent = '✕ ' + reasonKey;
            }
        } catch { status.textContent = ''; }
    }, 400);
}
function copySubdomainResultUrl(inputId) {
    const el = document.getElementById(inputId);
    el.select();
    navigator.clipboard.writeText(el.value).catch(() => document.execCommand('copy'));
}
// Liest den aktuellen Subdomain-Slug aus dem gegebenen Modal, oder null
// wenn der Toggle aus / das Feld leer ist (→ Body-Feld bleibt weg).
function readSubdomainSlug(prefix) {
    const on = document.getElementById(prefix + 'SubdomainOn')?.checked;
    if (!on) return null;
    const val = (document.getElementById(prefix + 'SubdomainSlug')?.value || '').trim();
    return val || null;
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

function openNewFolderModal(parentId) {
    document.getElementById('newFolderName').value = '';
    // v1.10.64: parentId optional — Standard ist der aktuelle Ordner
    // (aus dem Hidden-Input das per Model.Id gerendert wird).
    // Rechtsklick auf einen Ordner-Row übergibt diesen als parentId,
    // damit man Unterordner ohne Navigation anlegen kann.
    if (parentId) {
        document.getElementById('newFolderParentId').value = parentId;
    }
    openModal('modalNewFolder');
    setTimeout(() => document.getElementById('newFolderName').focus(), 50);
}

/// v1.10.64: async Create — ersetzt den stillen Form-POST + Redirect.
/// Vorher passierte bei jedem Fehler (AntiForgery-Timeout, doppelter
/// Name, Berechtigungs-Problem) genau NICHTS sichtbares — Marcus's Bug:
/// "auf Anlegen klicken tut nichts". Jetzt: konkreter Fehler-Alert,
/// Erfolgs-Toast, Seiten-Refresh damit der neue Ordner sofort erscheint.
async function createNewFolder(ev) {
    ev.preventDefault();
    const nameInp = document.getElementById('newFolderName');
    const btn = document.getElementById('newFolderSubmitBtn');
    const name = (nameInp.value || '').trim();
    if (!name) { nameInp.focus(); return false; }
    const parentId = document.getElementById('newFolderParentId').value;
    btn.disabled = true;
    const oldLabel = btn.textContent;
    btn.textContent = '…';
    // v1.10.64: Hard 20s Client-Timeout via AbortController.
    // Marcus meldete auf v1.10.62 einen 504 GatewayTimeout nach MINUTEN
    // beim /browse/folders/create — der Browser hing bis das Azure-
    // Frontend nach 240s abbrach. Egal was Backend-seitig hängt (Azure
    // Files SMB Remount, SQL Deadlock, hängender Middleware-Retry) — der
    // User bekommt jetzt spätestens nach 20s einen konkreten Timeout-
    // Toast statt einer Minutenlangen "Anlegen tut nichts"-Wartezeit.
    const ac = new AbortController();
    const timer = setTimeout(() => ac.abort(), 20000);
    try {
        const r = await fetch('/api/v1/folders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ parentId: parentId, name: name }),
            signal: ac.signal
        });
        if (r.ok) {
            closeModal('modalNewFolder');
            const okMsg = @Json.Serialize(T["browse.new_folder.created"].Value);
            nimToast(okMsg.replace("{name}", name), { kind: 'success' });
            // v1.10.64: gecachte Tree-Struktur weg — sonst zeigt der
            // linke Baum-Panel beim nächsten Load noch die alte Version
            // ohne den neuen Ordner (stale-while-revalidate hätte einen
            // Frame lang die Alt-Version gerendert).
            if (window.invalidateFolderTreeCache) window.invalidateFolderTreeCache();
            setTimeout(() => location.reload(), 350);
        } else {
            let msg = 'HTTP ' + r.status;
            try {
                const body = await r.json();
                msg = body.title || body.detail || msg;
            } catch { /* Server hat keinen JSON-Body geliefert */ }
            nimAlert(msg, { kind: 'error' });
        }
    } catch (ex) {
        if (ex && ex.name === 'AbortError') {
            nimAlert('Zeitüberschreitung nach 20s — der Server hat nicht geantwortet. Bitte erneut versuchen.', { kind: 'error' });
        } else {
            nimAlert(String(ex), { kind: 'error' });
        }
    } finally {
        clearTimeout(timer);
        btn.disabled = false;
        btn.textContent = oldLabel;
    }
    return false;
}

function openRenameFolderModal(id, name) {
    document.getElementById('renameForm').action = '/browse/folders/' + id + '/rename';
    document.getElementById('renameName').value = name;
    openModal('modalRenameFolder');
}

function openUploadModal() {
    document.getElementById('uploadPick').value = '';
    document.getElementById('uploadStatus').textContent = '';
    openModal('modalUpload');
}

function openShareFileModal(fileId) {
    currentShareTarget = { type: 'file', id: fileId };
    document.getElementById('shareTargetHint').textContent = @Json.Serialize(T["modal.share.for_file"].Value);
    resetShareModal();
    openModal('modalShare');
    // v1.10.165: Zertifikat-Liste beim Öffnen des Modals holen — vorher lief
    // ensureCertsLoaded() erst beim Klick auf „Link erstellen", d.h. der User
    // sah nur „Kein Zertifikat" auch wenn er längst eines angelegt hatte.
    ensureCertsLoaded();
    applySubdomainVisibility('share');
}
function openShareFolderModal(folderId) {
    currentShareTarget = { type: 'folder', id: folderId };
    document.getElementById('shareTargetHint').textContent = @Json.Serialize(T["modal.share.for_folder"].Value);
    resetShareModal();
    openModal('modalShare');
    ensureCertsLoaded();
    applySubdomainVisibility('share');
    // v1.10.167: Album-Optionen bei jedem Ordner-Link sichtbar. Der Toggle
    // „Als Album anzeigen" ist per-Link und braucht kein Kind=Gallery am
    // Ordner. Bei Gallery-Ordnern wird die Option vorausgewählt, weil der
    // Ordner damit ohnehin als Album gemeint ist.
    const wrap = document.getElementById('shareGalleryWrap');
    const cbDisp = document.getElementById('shareDisplayAsGallery');
    const cbAllow = document.getElementById('shareAllowUploads');
    if (cbAllow) cbAllow.checked = false;
    const cbGps = document.getElementById('shareShowGpsMap');
    if (cbGps) cbGps.checked = true;   // v1.10.196: Default an
    if (cbDisp && wrap) {
        const row = document.querySelector(`tr.ctx[data-id="${folderId}"]`);
        const isGallery = row && row.dataset.folderKind === 'Gallery';
        cbDisp.checked = !!isGallery;
        wrap.style.display = '';
        onShareDisplayGalleryChange();
    }
}
// v1.10.167: Sub-Toggle „Upload erlauben" nur zeigen wenn Album-Modus an ist.
function onShareDisplayGalleryChange() {
    const on = document.getElementById('shareDisplayAsGallery')?.checked;
    const row = document.getElementById('shareAllowUploadsRow');
    if (row) row.style.display = on ? 'flex' : 'none';
    // v1.10.196: GPS-Karten-Toggle hängt am Album-Modus (Karte gibt's nur dort).
    const gpsRow = document.getElementById('shareGpsMapRow');
    if (gpsRow) gpsRow.style.display = on ? 'flex' : 'none';
    if (!on) {
        const cb = document.getElementById('shareAllowUploads');
        if (cb) cb.checked = false;
    }
}
// v1.11.22: Seriennummer-Freitext und Key-Store-Modus schließen sich aus —
// Aktivieren des einen versteckt/leert das andere Feld in der UI (Server
// enforced die Exklusivität ohnehin nochmal beim Speichern).
function onShareKeyStoreModeChange() {
    const on = document.getElementById('shareKeyStoreMode').checked;
    const serialWrap = document.getElementById('shareSerialFieldWrap');
    const docWrap = document.getElementById('shareDocUrlWrap');
    if (serialWrap) serialWrap.style.display = on ? 'none' : '';
    if (docWrap) docWrap.style.display = on ? '' : 'none';
    if (on) document.getElementById('shareSerialNumber').value = '';
    else document.getElementById('shareDocUrlEnabled').checked = false;
}
// v1.11.50: Marcus's Wunsch — Ablauf-Default 8 Wochen, "Dauerhaft" muss
// aktiv angeklickt werden. defaultExpiryLocal() liefert einen
// datetime-local-tauglichen String (lokale Zeitzone, keine Sekunden).
function defaultExpiryLocal() {
    const d = new Date(Date.now() + 56 * 24 * 60 * 60 * 1000);
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    return d.toISOString().slice(0, 16);
}
function onPermanentToggle(prefix) {
    const exp = document.getElementById(prefix + 'Exp');
    const perm = document.getElementById(prefix + 'Permanent');
    if (!exp || !perm) return;
    exp.disabled = perm.checked;
    if (perm.checked) exp.value = '';
    else if (!exp.value) exp.value = defaultExpiryLocal();
}

function resetShareModal() {
    ['shareSlug','sharePw','shareMax','shareExp','shareMsg','shareSerialNumber','shareAllowedEmails'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('sharePermanent').checked = false;
    document.getElementById('shareExp').disabled = false;
    document.getElementById('shareExp').value = defaultExpiryLocal();
    document.getElementById('shareNotify').checked = false;
    document.getElementById('shareOtp').checked = false;
    document.getElementById('shareKeyStoreMode').checked = false;
    document.getElementById('shareDocUrlEnabled').checked = false;
    onShareKeyStoreModeChange();
    document.getElementById('shareResult').style.display = 'none';
    resetBrandingUi(); // v1.12: KI-Branding-State pro Öffnen zurücksetzen
    const st = document.getElementById('shareSlugStatus');
    if (st) { st.textContent = ''; st.className = 'slug-status'; }
    // v1.11.0: Subdomain-Sektion zurücksetzen (Sichtbarkeit selbst regelt
    // applySubdomainVisibility, hier nur die Werte leeren).
    const sdOn = document.getElementById('shareSubdomainOn');
    if (sdOn) sdOn.checked = false;
    onSubdomainToggle('share');
    const sdResult = document.getElementById('shareSubdomainResult');
    if (sdResult) sdResult.style.display = 'none';
}

function openUploadRequestModal(folderId) {
    currentUploadReqFolder = folderId;
    ['urSlug','urPw','urMax','urExp','urMsg'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('urPermanent').checked = false;
    document.getElementById('urExp').disabled = false;
    document.getElementById('urExp').value = defaultExpiryLocal();
    document.getElementById('urDateSubfolders').checked = true;
    const st = document.getElementById('urSlugStatus');
    if (st) { st.textContent = ''; st.className = 'slug-status'; }
    document.getElementById('urResult').style.display = 'none';
    const urSdResult = document.getElementById('urSubdomainResult');
    if (urSdResult) urSdResult.style.display = 'none';
    const urSdOn = document.getElementById('urSubdomainOn');
    if (urSdOn) urSdOn.checked = false;
    onSubdomainToggle('ur');
    openModal('modalUploadReq');
    ensureCertsLoaded();
    applySubdomainVisibility('ur');
}

// v1.10.146: Zertifikat-Dropdowns beim Öffnen der Modals einmalig füllen.
async function ensureCertsLoaded() {
    if (window.__certsLoaded) return;
    window.__certsLoaded = true;
    try {
        const r = await fetch('/api/v1/certificates', { credentials: 'same-origin' });
        if (!r.ok) return;
        const list = await r.json();
        for (const selId of ['shareCert', 'urCert']) {
            const sel = document.getElementById(selId);
            if (!sel) continue;
            list.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.name + (c.isDefault ? ' ★' : '');
                if (c.isDefault) opt.selected = true;
                sel.appendChild(opt);
            });
        }
    } catch {}
}

// v1.12: KI-Auto-Branding. Hält die zuletzt per Domain erzeugte Link-Template-ID.
// Wird beim Öffnen des Share-Modals zurückgesetzt (resetBrandingUi), damit kein
// Branding versehentlich auf eine andere Datei übertragen wird.
let shareBrandTemplateId = null;
function resetBrandingUi() {
    shareBrandTemplateId = null;
    const dom = document.getElementById('shareBrandDomain'); if (dom) dom.value = '';
    const prev = document.getElementById('shareBrandPreview'); if (prev) prev.style.display = 'none';
}
async function previewBranding() {
    const dom = (document.getElementById('shareBrandDomain').value || '').trim();
    if (!dom) return;
    const btn = document.getElementById('shareBrandBtn');
    const old = btn.textContent; btn.disabled = true; btn.textContent = '…';
    try {
        const r = await fetch('/api/v1/ai/brand-from-domain', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ domain: dom }),
        });
        if (!r.ok) { nimAlert('@T["share.branding.error"]' + ' (' + r.status + ')', { kind: 'error' }); return; }
        const d = await r.json();
        shareBrandTemplateId = d.templateId || null;
        const logo = document.getElementById('shareBrandLogo');
        if (d.logoUrl) { logo.src = d.logoUrl; logo.style.display = ''; } else { logo.removeAttribute('src'); logo.style.display = 'none'; }
        document.getElementById('shareBrandTitle').textContent = d.title || d.companyName || '';
        document.getElementById('shareBrandSubtitle').textContent = d.subtitle || '';
        document.getElementById('shareBrandSwatch').style.background = d.primaryColor || 'transparent';
        const apply = document.getElementById('shareBrandApply'); if (apply) apply.checked = true;
        document.getElementById('shareBrandPreview').style.display = 'block';
        // v1.12.1: sinnvollen Slug vorschlagen (Kundenname) — NUR wenn der User
        // weder einen Slug getippt noch eine Subdomain gesetzt hat (Subdomain
        // hat Vorrang). Danach den bestehenden Verfügbarkeits-Check anstoßen.
        const slugEl = document.getElementById('shareSlug');
        const subOn = document.getElementById('shareSubdomainOn');
        const subVal = (document.getElementById('shareSubdomainSlug')?.value || '').trim();
        if (d.suggestedSlug && slugEl && !slugEl.value.trim() && !(subOn && subOn.checked) && !subVal) {
            slugEl.value = d.suggestedSlug;
            if (typeof slugLiveCheck === 'function') slugLiveCheck('shareSlug', 'shareSlugStatus');
        }
    } catch (e) {
        nimAlert('@T["share.branding.error"]', { kind: 'error' });
    } finally {
        btn.disabled = false; btn.textContent = old;
    }
}

async function createShareLink() {
    await ensureCertsLoaded();
    const body = {
        slug: document.getElementById('shareSlug').value || null,
        password: document.getElementById('sharePw').value || null,
        maxDownloads: parseInt(document.getElementById('shareMax').value, 10) || null,
        expiresAt: document.getElementById('shareExp').value ? new Date(document.getElementById('shareExp').value).toISOString() : null,
        message: document.getElementById('shareMsg').value || null,
        notifyOnAccess: document.getElementById('shareNotify').checked,
        signingCertificateId: document.getElementById('shareCert').value || null,
        // v1.10.167: Album-Anzeige + Upload — Server enforced für File-Links = false.
        displayAsGallery: !!document.getElementById('shareDisplayAsGallery')?.checked,
        allowUploads: !!document.getElementById('shareAllowUploads')?.checked,
        // v1.10.196: GPS-Karten-Toggle (Default an; nur im Album-Modus relevant).
        showGpsMap: document.getElementById('shareShowGpsMap') ? document.getElementById('shareShowGpsMap').checked : true,
        // v1.11.0: optionaler Subdomain-Slug (null wenn Toggle aus/leer).
        subdomainSlug: readSubdomainSlug('share'),
        // v1.11.18: optionale Seriennummer/Lizenzcode.
        serialNumber: document.getElementById('shareSerialNumber').value.trim() || null,
        // v1.11.22: Key-Store-Modus. v1.11.44: DocumentationEnabled ist ein
        // reines Ein/Aus für die flexiblen Key-Store-Dokumente.
        keyStoreMode: !!document.getElementById('shareKeyStoreMode')?.checked,
        documentationEnabled: !!document.getElementById('shareDocUrlEnabled')?.checked,
        // v1.11.50: explizites "läuft nie ab".
        isPermanent: !!document.getElementById('sharePermanent')?.checked,
        // v1.12: KI-Auto-Branding — nur wenn eine Vorschau erzeugt UND der
        // "Anwenden"-Haken gesetzt ist. Sonst null → Standard-Branding.
        landingTemplateId: (shareBrandTemplateId && document.getElementById('shareBrandApply')?.checked)
            ? shareBrandTemplateId : null,
    };
    if (currentShareTarget.type === 'file') {
        body.fileId = currentShareTarget.id;
    } else {
        body.folderId = currentShareTarget.id;
    }
    const r = await fetch('/api/v1/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
    });
    if (!r.ok) { nimAlert('Failed: ' + r.status + ' ' + await r.text(), { kind: 'error' }); return; }
    const link = await r.json();

    // If the user filled in the allow-list details, PATCH them onto the fresh
    // link. Doing it as a follow-up keeps the Create payload / DTO stable.
    const allowed = document.getElementById('shareAllowedEmails').value.trim();
    const otp = document.getElementById('shareOtp').checked;
    if (allowed || otp) {
        await fetch('/api/v1/links/' + link.id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ allowedEmails: allowed || null, requireEmailVerify: otp }),
        });
    }
    document.getElementById('shareUrl').value = link.url;
    document.getElementById('shareResult').style.display = 'block';
    applyResultUrls('share', link);
}
function copyShareUrl() {
    const el = document.getElementById('shareUrl');
    el.select();
    navigator.clipboard.writeText(el.value).catch(() => document.execCommand('copy'));
}

async function createUploadRequest() {
    await ensureCertsLoaded();
    const body = {
        slug: document.getElementById('urSlug').value || null,
        password: document.getElementById('urPw').value || null,
        maxUploads: parseInt(document.getElementById('urMax').value, 10) || null,
        expiresAt: document.getElementById('urExp').value ? new Date(document.getElementById('urExp').value).toISOString() : null,
        message: document.getElementById('urMsg').value || null,
        targetFolder: 'Received',
        // v1.11.32: BUGFIX — der Ordner, aus dem das Modal geöffnet wurde,
        // wurde bislang nie an den Server geschickt; Uploads landeten immer
        // unter Personal statt im tatsächlich gewählten Ordner.
        targetFolderId: currentUploadReqFolder || null,
        useDateSubfolders: document.getElementById('urDateSubfolders').checked,
        notifyOnUpload: true,
        signingCertificateId: document.getElementById('urCert').value || null,
        // v1.11.0: optionaler Subdomain-Slug (null wenn Toggle aus/leer).
        subdomainSlug: readSubdomainSlug('ur'),
        // v1.11.50: explizites "läuft nie ab".
        isPermanent: !!document.getElementById('urPermanent')?.checked,
    };
    const r = await fetch('/api/v1/upload-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
    });
    if (!r.ok) { nimAlert('Failed: ' + r.status, { kind: 'error' }); return; }
    const link = await r.json();
    document.getElementById('urUrl').value = link.url;
    document.getElementById('urResult').style.display = 'block';
    applyResultUrls('ur', link);
}

// v1.11.0: Hat der Link/die Anfrage eine Subdomain-URL, ist die klassische
// /s/-URL redundant (beide führen zum selben Ziel) — Nutzer-Feedback: "das
// wär doppelt". Also: klassische URL-Zeile ausblenden, Subdomain-URL wird
// die einzig sichtbare/primäre. Ohne Subdomain bleibt alles wie vorher.
function applyResultUrls(prefix, link) {
    const classicRow = document.getElementById(prefix + 'Url').closest('.modal-result');
    const sdResult = document.getElementById(prefix + 'SubdomainResult');
    if (!sdResult) return;
    if (link.subdomainUrl) {
        document.getElementById(prefix + 'SubdomainUrl').value = link.subdomainUrl;
        sdResult.style.display = 'block';
        if (classicRow) classicRow.style.display = 'none';
    } else {
        sdResult.style.display = 'none';
        if (classicRow) classicRow.style.display = '';
    }
}
function copyUploadReqUrl() {
    const el = document.getElementById('urUrl');
    el.select();
    navigator.clipboard.writeText(el.value).catch(() => document.execCommand('copy'));
}

async function startUpload() {
    const files = document.getElementById('uploadPick').files;
    if (!files.length) { document.getElementById('uploadStatus').textContent = 'Pick at least one file.'; return; }
    const status = document.getElementById('uploadStatus');
    for (let i = 0; i < files.length; i++) {
        const f = files[i];
        status.textContent = `Uploading ${i+1} / ${files.length}: ${f.name}…`;
        const init = await fetch('/api/v1/files', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ name: f.name, sizeBytes: f.size, contentType: f.type, folderId: FOLDER_ID }),
        });
        if (!init.ok) { status.textContent = 'Rejected: ' + init.status; return; }
        const { fileId, uploadUrl } = await init.json();
        const put = await fetch(uploadUrl, { method: 'PUT', headers: {'x-ms-blob-type':'BlockBlob'}, body: f });
        if (!put.ok) { status.textContent = 'Upload failed for ' + f.name; return; }
        await fetch('/api/v1/files/' + fileId + '/complete', { method: 'POST', credentials: 'same-origin' });
    }
    status.textContent = 'Done ✓ — reloading…';
    setTimeout(() => location.reload(), 400);
}
</script>
