@model NimShare.Api.Controllers.ResetPasswordViewModel
@{ ViewData["Title"] = T["reset.title"]; Layout = "_Layout"; }
<div class="landing-shell">
    <div class="landing-card" style="max-width: 480px">
        <div style="text-align:center;margin-bottom:var(--sp-4)">
            <img src="~/img/logo-400.png" srcset="/img/logo-400.png 1x, /img/logo-800.png 2x"
                 alt="NimShare" style="max-width:280px;width:100%;height:auto;margin:0 auto"/>
        </div>
        <h1 style="text-align:center">@T["reset.title"]</h1>

        <form method="post" class="stack" style="margin-top: var(--sp-6)">
            <div asp-validation-summary="All" class="helper" style="color:var(--status-critical)"></div>
            <input type="hidden" name="Token" value="@Model.Token"/>
            <div class="field">
                <label for="NewPassword">@T["password.new"]</label>
                <input type="password" name="NewPassword" id="NewPassword" required minlength="8" autocomplete="new-password"/>
                <div class="helper">@T["auth.password_helper"]</div>
            </div>
            <div class="field">
                <label for="NewPasswordConfirm">@T["auth.password_confirm"]</label>
                <input type="password" name="NewPasswordConfirm" id="NewPasswordConfirm" required minlength="8" autocomplete="new-password"/>
            </div>
            <button type="submit" class="btn btn-primary">@T["reset.button"]</button>
        </form>
    </div>
</div>
