@{ ViewData["Title"] = T["reset.invalid.title"]; Layout = "_Layout"; }
<div class="landing-shell">
    <div class="landing-card" style="max-width:520px">
        <div style="text-align:center;margin-bottom:var(--sp-4)">
            <img src="/img/icon-64.png" width="40" height="40" alt="NimShare" style="border-radius:8px;margin:0 auto"/>
        </div>
        <h1 style="text-align:center">@T["reset.invalid.title"]</h1>
        <p class="landing-meta" style="text-align:center">@T["reset.invalid.body"]</p>
        <div style="margin-top:var(--sp-4);text-align:center">
            <a href="/forgot-password" class="btn btn-primary">@T["forgot.title"]</a>
        </div>
    </div>
</div>
