        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least 8 characters. The user can sign in immediately — no invitation email is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos 8 caracteres. El usuario podrá iniciar sesión de inmediato — no se envía ningún correo de invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
