    "Erforderlich für Chat mit Dateien, semantische Suche und intelligente Zusammenfassungen. Widerrufen deaktiviert diese Funktionen sofort. Details in der Datenschutzerklärung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required for chat with files, semantic search and smart summaries. Revoking disables these features immediately. Details in the privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para chatear con tus archivos, la búsqueda semántica y los resúmenes inteligentes. Al revocar se desactivan estas funciones al instante. Detalles en la política de privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requis pour discuter avec tes fichiers, la recherche sémantique et les résumés intelligents. La révocation désactive ces fonctions immédiatement. Détails dans la politique de confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessario per la chat con i file, la ricerca semantica e i riassunti intelligenti. La revoca disattiva subito queste funzioni. Dettagli nell’informativa sulla privacy."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist voor chat met bestanden, semantisch zoeken en slimme samenvattingen. Intrekken schakelt deze functies direct uit. Details in het privacybeleid."
          }
        }
      }
    },
