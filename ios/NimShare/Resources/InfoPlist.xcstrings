{
  "sourceLanguage" : "de",
  "strings" : {
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare nutzt Face ID, um deine Sitzung beim Öffnen der App zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare uses Face ID to unlock your session when you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare usa Face ID para desbloquear tu sesión al abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare utilise Face ID pour déverrouiller votre session à l’ouverture de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare usa Face ID per sbloccare la tua sessione all’apertura dell’app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare gebruikt Face ID om je sessie te ontgrendelen wanneer je de app opent."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare nutzt deinen ungefähren Standort nur für eine freundliche Wetter-Begrüssung auf der Startseite. Optional — die App funktioniert ohne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare uses your approximate location only for a friendly weather greeting on the home screen. Optional — the app works without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare usa tu ubicación aproximada solo para un saludo del tiempo en la pantalla de inicio. Opcional: la app funciona sin ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare utilise votre position approximative uniquement pour un accueil météo sur l’écran d’accueil. Facultatif — l’app fonctionne sans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare usa la tua posizione approssimativa solo per un saluto meteo nella schermata iniziale. Facoltativo — l’app funziona anche senza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NimShare gebruikt je globale locatie alleen voor een vriendelijke weergroet op het startscherm. Optioneel — de app werkt ook zonder."
          }
        }
      }
    }
  },
  "version" : "1.0"
